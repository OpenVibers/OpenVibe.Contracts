{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/exchange/generation.v1.json",
  "title": "ExchangeGeneration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "model",
    "provider",
    "cost",
    "total_cost",
    "latency",
    "tokens_prompt",
    "tokens_completion",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "provider": {
      "type": [
        "string",
        "null"
      ]
    },
    "cost": {
      "type": "number",
      "minimum": 0
    },
    "total_cost": {
      "type": "number",
      "minimum": 0
    },
    "latency": {
      "type": "number",
      "minimum": 0
    },
    "tokens_prompt": {
      "type": "integer",
      "minimum": 0
    },
    "tokens_completion": {
      "type": "integer",
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "description": "Owner-scoped request accounting. Cost is USD and latency is milliseconds; prompts and outputs are excluded."
}
