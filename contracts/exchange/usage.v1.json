          },
          "key_id": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "requests": {
            "type": [
              "number",
              "string"
            ]
          },
          "tokens_in": {
            "type": [
              "number",
              "string"
            ]
          },
          "tokens_out": {
            "type": [
              "number",
              "string"
            ]
          },
          "cost_usd": {
