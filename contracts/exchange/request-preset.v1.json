{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/exchange/request-preset.v1.json",
  "title": "ExchangeRequestPreset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name"
  ],
  "anyOf": [
    {
      "required": [
        "model"
      ]
    },
    {
      "required": [
        "models"
      ]
    }
  ],
  "properties": {
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "order": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9._-]{1,100}$"
          }
        },
        "only": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9._-]{1,100}$"
          }
        },
        "ignore": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9._-]{1,100}$"
          }
        },
        "allow_fallbacks": {
          "type": "boolean"
        },
        "sort": {
          "enum": [
            "price",
            "throughput",
            "latency",
            "quality",
            "value"
          ]
        },
        "max_price": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prompt": {
              "type": "number",
              "minimum": 0
            },
            "completion": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "data_collection": {
          "enum": [
            "allow",
            "deny"
          ]
        },
        "zdr": {
          "type": "boolean"
        }
      }
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "system": {
      "type": "string",
      "maxLength": 32000
    },
    "temperature": {
      "type": "number",
      "minimum": 0,
      "maximum": 2
    },
    "top_p": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "max_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64000
    },
    "seed": {
      "type": "integer"
    },
    "response_format": {
      "type": "object"
    }
  },
  "description": "A person-owned request preset with model fallbacks, system prompt, routing and sampling defaults."
}
