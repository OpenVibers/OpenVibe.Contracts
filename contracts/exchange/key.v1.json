{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/exchange/key.v1.json",
  "title": "ExchangeKey",
  "type": "object",
  "required": [
    "id",
    "name",
    "prefix",
    "monthly_cap_usd",
    "allowed_models",
    "created_at",
    "revoked_at"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "prefix": {
      "type": "string"
    },
    "monthly_cap_usd": {
      "type": "number",
      "minimum": 0
    },
    "allowed_models": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked_at": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "description": "Exchange API platform ExchangeKey response. Private account data is available only to its owner."
}
