{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/exchange/image-result.v1.json",
  "title": "ExchangeImageResult",
  "type": "object",
  "required": [
    "results",
    "receipt"
  ],
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "url",
          "snippet",
          "engine",
          "published",
          "license",
          "author",
          "source_page",
          "attribution"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "snippet": {
            "type": "string"
          },
          "engine": {
            "type": "string"
          },
          "published": {
            "type": [
              "string",
              "null"
            ]
          },
          "license": {
            "type": [
              "string",
              "null"
            ]
          },
          "author": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_page": {
            "type": [
              "string",
              "null"
            ]
          },
          "attribution": {
            "type": [
              "string",
              "null"
            ]
          },
          "thumbnail": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "receipt": {
      "type": "object",
      "required": [
        "engine",
        "cost_usd",
        "time_ms"
      ],
      "properties": {
        "engine": {
          "type": "string"
        },
        "cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "time_ms": {
          "type": "number",
          "minimum": 0
        },
        "class": {
          "type": "string",
          "enum": [
            "first_party_index",
            "independent_index",
            "serp_proxy",
            "semantic",
            "answer_engine",
            "metasearch",
            "page_reader",
            "open_asset_catalog",
            "provider_asset_catalog",
            "web_image_discovery",
            "icon_catalog",
            "reverse_image",
            "visual_web_detection",
            "product_visual_search"
          ],
          "description": "The class of the engine that answered."
        },
        "classes_allowed": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "enum": [
              "first_party_index",
              "independent_index",
              "serp_proxy",
              "semantic",
              "answer_engine",
              "metasearch",
              "page_reader",
              "open_asset_catalog",
              "provider_asset_catalog",
              "web_image_discovery",
              "icon_catalog",
              "reverse_image",
              "visual_web_detection",
              "product_visual_search"
            ]
          },
          "description": "The engine classes this request was allowed to use."
        },
        "not_considered": {
          "type": "array",
          "maxItems": 32,
          "description": "The engines that were not considered, and why.",
          "items": {
            "type": "object",
            "required": [
              "engine",
              "class",
              "reason"
            ],
            "additionalProperties": false,
            "properties": {
              "engine": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "class": {
                "type": "string",
                "enum": [
                  "first_party_index",
                  "independent_index",
                  "serp_proxy",
                  "semantic",
                  "answer_engine",
                  "metasearch",
                  "page_reader",
                  "open_asset_catalog",
                  "provider_asset_catalog",
                  "web_image_discovery",
                  "icon_catalog",
                  "reverse_image",
                  "visual_web_detection",
                  "product_visual_search"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              }
            }
          }
        },
        "attempts": {
          "description": "Ordered routing attempts with safe reason codes; no provider error bodies or credentials.",
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": [
              "provider",
              "engine",
              "status",
              "time_ms",
              "cost_usd"
            ],
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "engine": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "class": {
                "type": "string",
                "enum": [
                  "first_party_index",
                  "independent_index",
                  "serp_proxy",
                  "semantic",
                  "answer_engine",
                  "metasearch",
                  "page_reader",
                  "open_asset_catalog",
                  "provider_asset_catalog",
                  "web_image_discovery",
                  "icon_catalog",
                  "reverse_image",
                  "visual_web_detection",
                  "product_visual_search"
                ],
                "description": "The class of that engine."
              },
              "model": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 200
              },
              "status": {
                "enum": [
                  "ok",
                  "error",
                  "skipped"
                ]
              },
              "reason": {
                "enum": [
                  "disabled",
                  "unsupported",
                  "no_credentials",
                  "circuit_open",
                  "daily_cap",
                  "budget",
                  "timeout",
                  "upstream_error",
                  "invalid_response",
                  "class_not_considered",
                  "terms_unreviewed",
                  "terms_disallow_purpose",
                  "privacy_incompatible",
                  "retention_incompatible"
                ]
              },
              "time_ms": {
                "type": "number",
                "minimum": 0
              },
              "cost_usd": {
                "type": "number",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "description": "Exchange API platform ExchangeImageResult response. Private account data is available only to its owner."
}
