{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/exchange/search-result.v1.json",
  "title": "ExchangeSearchResult",
  "type": "object",
  "required": [
    "results",
    "receipt"
  ],
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "url",
          "snippet",
          "engine",
          "published"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "snippet": {
            "type": "string"
          },
          "engine": {
            "type": "string"
          },
          "published": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "receipt": {
      "type": "object",
      "required": [
        "engine",
        "cost_usd",
        "time_ms"
      ],
      "properties": {
        "engine": {
          "type": "string"
        },
        "cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "time_ms": {
          "type": "number",
          "minimum": 0
        },
        "attempts": {
          "description": "Ordered routing attempts with safe reason codes; no provider error bodies or credentials.",
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": [
              "provider",
              "engine",
              "status",
              "time_ms",
              "cost_usd"
            ],
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "engine": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "model": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 200
              },
              "status": {
                "enum": [
                  "ok",
                  "error",
                  "skipped"
                ]
              },
              "reason": {
                "enum": [
                  "disabled",
                  "unsupported",
                  "no_credentials",
                  "circuit_open",
                  "daily_cap",
                  "budget",
                  "timeout",
                  "upstream_error",
                  "invalid_response"
                ]
              },
              "time_ms": {
                "type": "number",
                "minimum": 0
              },
              "cost_usd": {
                "type": "number",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "description": "Exchange API platform ExchangeSearchResult response. Private account data is available only to its owner."
}
