{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/exchange/search-result.v1.json",
  "title": "ExchangeSearchResult",
  "type": "object",
  "required": [
    "results",
    "receipt"
  ],
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "url",
          "snippet",
          "engine",
          "published"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "snippet": {
            "type": "string"
          },
          "engine": {
            "type": "string"
          },
          "published": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "receipt": {
      "type": "object",
      "required": [
        "engine",
        "cost_usd",
        "time_ms"
      ],
      "properties": {
        "engine": {
          "type": "string"
        },
        "cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "time_ms": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "description": "Exchange API platform ExchangeSearchResult response. Private account data is available only to its owner."
}
