{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/agents/run-start.v1.json",
  "title": "AgentsRunStart",
  "description": "agents.run-start@1 (agent-engine.md, 2026-11-12): what starts a run, the same on every product's POST /api/v1/runs and on the Frame's POST /api/frame/runs. Only TEXT is required: the goal, the question or the first message, in the person's own words. KIND chooses the sort of run (agents.run@1's kinds); absent, the Frame's orchestrator decides whether to answer, plan, or hand the work to another product as a child run. AGENT names who does it (an agent's id; auto lets the product choose). MODEL and WHERE are the picker's choices; TARGET is a code run's (new, openvibe or a repository); CONTEXT is where it was asked; ATTACHMENTS are files by Media id or address; SOURCES and DEPTH are an answer's (frame.ask@1's); PARENT_RUN makes it a sub-agent's run inside its parent's budget; BUDGET is its own hard limit. An Idempotency-Key header makes a repeated start return the first run. Since 1.1.0 a start may name a PLAY, continue another run (LINEAGE), and carry intake's MANDATE.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "text"
  ],
  "properties": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,30}$"
    },
    "agent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "description": "An agent's id on the product that will run it, or auto."
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9._:/@+| -]+$"
        },
        "source": {
          "enum": [
            "openvibe",
            "keys",
            "machines",
            "plans"
          ],
          "description": "openvibe: Exchange's directory, paid in credits. keys: the person's own key. machines: a model on the person's own computer (Link). plans: a signed-in plan through a harness."
        },
        "machine": {
          "type": "string",
          "maxLength": 40
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "effort": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      },
      "description": "The picker's choice (frame.choices@1). Absent: the person's default for this kind of work."
    },
    "where": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "description": "Where the run's work happens. openvibe: OpenVibe's own computers. machine: the person's own computer or robot through Link (ID is the device). runner: a Codes runner. this-computer: the machine that serves the run itself (Link's agent serve).",
      "properties": {
        "kind": {
          "enum": [
            "openvibe",
            "machine",
            "runner",
            "this-computer"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "target": {
      "description": "What a code run works on. new: a new project in the person's own space. openvibe: OpenVibe itself; the orchestrator finds the repositories and opens pull requests, never merges. An object names one repository.",
      "anyOf": [
        {
          "enum": [
            "new",
            "openvibe"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repo"
          ],
          "properties": {
            "repo": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "description": "owner/name, or the repository's address."
            },
            "branch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        }
      ]
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "description": "Where the run was asked: the site, the page and what the page is about. A run may use it; it never grants access.",
      "properties": {
        "site": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2000,
          "description": "The page's address."
        },
        "title": {
          "type": "string",
          "maxLength": 300
        },
        "kind": {
          "type": "string",
          "maxLength": 60
        },
        "id": {
          "type": "string",
          "maxLength": 160
        }
      }
    },
    "attachments": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind"
        ],
        "description": "A file that goes with a message or a start: by its OpenVibe.Media id, or by an https address.",
        "properties": {
          "kind": {
            "enum": [
              "image",
              "file",
              "audio",
              "video"
            ]
          },
          "media_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "url": {
            "type": "string",
            "format": "uri",
            "maxLength": 2000,
            "description": "An https address the reader may fetch."
          },
          "name": {
            "type": "string",
            "maxLength": 300
          },
          "mime": {
            "type": "string",
            "maxLength": 120
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "alt": {
            "type": "string",
            "maxLength": 500,
            "description": "What a picture shows, in words."
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "web",
          "openvibe",
          "mine",
          "page"
        ]
      }
    },
    "depth": {
      "enum": [
        "quick",
        "balanced",
        "deep"
      ]
    },
    "parent_run": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "description": "The hard limit the run may not exceed. A field that is absent is not limited. USD is money; TOKENS counts model tokens in and out; SECONDS is wall time; STEPS counts the appended steps.",
      "properties": {
        "usd": {
          "type": "number",
          "minimum": 0
        },
        "tokens": {
          "type": "integer",
          "minimum": 0
        },
        "seconds": {
          "type": "number",
          "minimum": 0
        },
        "steps": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "play": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,60}$",
      "description": "The play to run (agents.play@1's ID); absent, the orchestrator chooses (most asks are solo)."
    },
    "mandate": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "source",
        "asked_by",
        "strength"
      ],
      "description": "Set by intake, never by a browser: the Source, thread and asker the run is answering (agents.run@1's MANDATE). A product ignores it from a caller that is not the intake service.",
      "properties": {
        "source": {
          "enum": [
            "feed",
            "chat",
            "comments",
            "git",
            "composer",
            "notifications",
            "mail",
            "schedule",
            "goal",
            "webhook",
            "machine"
          ]
        },
        "thread": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "service",
            "kind",
            "id"
          ],
          "properties": {
            "service": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,40}$"
            },
            "kind": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,40}$"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://",
              "maxLength": 2048
            }
          }
        },
        "asked_by": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id"
          ],
          "properties": {
            "type": {
              "enum": [
                "user",
                "agent",
                "service"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          }
        },
        "strength": {
          "enum": [
            "explicit",
            "inferred"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "lineage": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "from",
        "how"
      ],
      "description": "Start as a continuation of another run of the same person: a fork at a turn, a hand-off, or a regenerated turn (agents.run@1's LINEAGE).",
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,40}:[A-Za-z0-9._~-]{1,160}$",
          "description": "A run's ref: the product, a colon, the product's own run id (agents.run@1's REF)."
        },
        "at_turn": {
          "type": "integer",
          "minimum": 0
        },
        "how": {
          "enum": [
            "fork",
            "handoff",
            "regenerate"
          ]
        }
      }
    }
  }
}
