{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/quest/daily-progress.v1.json",
  "title": "QuestDailyProgress",
  "description": "quest.daily-progress@1: the caller's own progress, counted from Events in their IANA time zone.",
  "type": "object",
  "additionalProperties": false,
  "required": ["date", "title", "story", "steps", "source", "finished_today", "progress", "completed", "streak", "time_zone"],
  "properties": {
    "date": { "type": "string", "format": "date" },
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "story": { "type": "string", "minLength": 1, "maxLength": 180 },
    "steps": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "event_type", "site", "sentence", "href", "weight", "count", "verification", "status", "source", "progress", "done"],
        "properties": {
          "id": { "type": "string" }, "event_type": { "type": "string" }, "site": { "type": "string" },
          "sentence": { "type": "string" }, "href": { "type": "string", "format": "uri" },
          "weight": { "type": "integer" }, "count": { "type": "integer", "const": 1 },
          "verification": { "type": "string" }, "status": { "const": "approved" },
          "source": { "type": "string" }, "progress": { "type": "integer", "minimum": 0 },
          "done": { "type": "boolean" }
        }
      }
    },
    "source": { "enum": ["ai", "rotation"] },
    "finished_today": { "type": "integer", "minimum": 0 },
    "progress": { "type": "integer", "minimum": 0, "maximum": 3 },
    "completed": { "type": "boolean" },
    "completed_at": { "type": ["string", "null"], "format": "date-time" },
    "streak": { "type": "integer", "minimum": 0 },
    "time_zone": { "type": "string" }
  }
}
