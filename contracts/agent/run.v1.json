{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://openvibe.network/contracts/agent/run.v1.json",
  "title": "AgentRun",
  "description": "agent.run@1 snapshot of a run and its current plan, steps, sources, result, timestamps and cost.",
  "required": [
    "id",
    "product",
    "title",
    "status",
    "plan",
    "steps",
    "sources",
    "result",
    "started_at",
    "ended_at",
    "cost_usd"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "product": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "waiting",
        "needs_you",
        "succeeded",
        "failed",
        "stopped",
        "cancelled"
      ]
    },
    "plan": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "status"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "status": {
            "enum": [
              "todo",
              "running",
              "waiting",
              "needs_you",
              "done",
              "failed",
              "stopped"
            ]
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "result": {
      "type": [
        "object",
        "null"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "cost_usd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "title",
        "status"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "status": {
          "enum": [
            "todo",
            "running",
            "waiting",
            "needs_you",
            "done",
            "failed",
            "stopped"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "title",
        "site"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "site": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    }
  }
}
