{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/agent/task.v1.json",
  "title": "AgentTask",
  "description": "A2A task with agent, person, thread and text parts limited to 8000 characters.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "to",
    "from",
    "on_behalf_of",
    "thread",
    "message"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]{3}_[A-Za-z0-9_-]{8,80}$"
    },
    "to": {
      "type": "string",
      "pattern": "^agt_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "from": {
      "type": "string",
      "pattern": "^agt_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "on_behalf_of": {
      "type": "string",
      "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "thread": {
      "type": "string",
      "pattern": "^[a-z]{3}_[A-Za-z0-9_-]{8,80}$"
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parts"
      ],
      "properties": {
        "role": {
          "enum": [
            "user",
            "agent"
          ]
        },
        "parts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "text"
            ],
            "properties": {
              "type": {
                "const": "text"
              },
              "text": {
                "type": "string",
                "maxLength": 8000
              }
            }
          }
        }
      }
    },
    "skillId": {
      "type": "string",
      "maxLength": 64
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
