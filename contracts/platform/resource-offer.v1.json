{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/platform/resource-offer.v1.json",
  "title": "ResourceOffer",
  "description": "What one node or external provider can run right now (roadmap WS-Z9, decision 43): capabilities, multidimensional capacity, measured latencies, health and pricing. First-party only: it carries capacity the public node registry (network.node@1) deliberately leaves out.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "offer_id",
    "kind",
    "region",
    "trust",
    "capabilities",
    "health",
    "pricing",
    "updated_at"
  ],
  "properties": {
    "offer_id": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "node",
        "provider"
      ]
    },
    "node_id": {
      "type": "string",
      "description": "network.node@1 id, for kind node"
    },
    "provider": {
      "type": "string",
      "description": "provider or hosting company"
    },
    "adapter": {
      "type": "string",
      "description": "carrier or provider adapter id, for kind provider (e.g. nats-v1, cf-queue-v1)"
    },
    "region": {
      "type": "string"
    },
    "cell": {
      "type": "string"
    },
    "trust": {
      "type": "string",
      "enum": [
        "first-party",
        "partner",
        "community",
        "external"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*:[a-z0-9.-]+$"
      },
      "description": "e.g. node:http, worker:browser, worker:ffmpeg, worker:ai-gpu, events:gateway, events:durable, object:r2"
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "utilization": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "available_cores": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "utilization": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "available_mb": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ingress_mbps": {
              "type": "number",
              "minimum": 0
            },
            "egress_mbps": {
              "type": "number",
              "minimum": 0
            },
            "available_mbps": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "disk": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "iops_available": {
              "type": "number",
              "minimum": 0
            },
            "scratch_gb": {
              "type": "number",
              "minimum": 0
            },
            "utilization": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "gpu": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string"
            },
            "vram_free_mb": {
              "type": "number",
              "minimum": 0
            },
            "utilization": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "workers": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          },
          "properties": {},
          "description": "free worker slots by kind (browser, ffmpeg, ai, …)"
        },
        "queues": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "depth": {
                "type": "integer",
                "minimum": 0
              },
              "oldest_ms": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "properties": {},
          "description": "queue depth and age by name"
        },
        "event_loop_lag_ms": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "latency_ms": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      },
      "properties": {},
      "description": "measured p50/p95 by operation, e.g. publish_p95, ack_p95"
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "up",
            "degraded",
            "down",
            "draining"
          ]
        },
        "error_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "status"
      ]
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string",
          "enum": [
            "prepaid",
            "per-request",
            "per-byte",
            "per-operation",
            "per-second",
            "free-allowance",
            "mixed"
          ]
        },
        "marginal_usd_per_unit": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string"
        },
        "rate_card": {
          "type": "string",
          "description": "platform.rate-card id when the price comes from one"
        }
      },
      "required": [
        "model"
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
