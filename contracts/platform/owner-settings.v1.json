{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/platform/owner-settings.v1.json",
  "title": "PlatformOwnerSettings",
  "description": "platform.owner-settings@1 (AI Exchange D11): one service's owner settings document, answered by GET/PATCH /internal/owner-settings and by PUT/DELETE /internal/owner-settings/secrets/:key on the service that owns the settings. A setting is typed and says where its effective value comes from; `env` pins it read-only. A secret setting never carries its value (and never a default): only the write-only metadata `secret`. nano_usd values are integer strings, never numbers. Only Network's admin proxy, acting for the owner, reads or writes this document.",
  "type": "object",
  "additionalProperties": false,
  "required": ["service", "groups", "settings"],
  "properties": {
    "service": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,39}$",
      "description": "The service whose settings these are, e.g. ai."
    },
    "groups": {
      "type": "array",
      "description": "The groups the settings are shown under.",
      "items": {
        "$ref": "#/$defs/group"
      }
    },
    "settings": {
      "type": "array",
      "description": "Every setting the service exposes to the owner.",
      "items": {
        "$ref": "#/$defs/setting"
      }
    }
  },
  "$defs": {
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "description": "Stable group id; a setting names it in `group`."
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "nano-usd": {
      "type": "string",
      "pattern": "^[0-9]{1,19}$",
      "description": "Integer nano-USD (1e-9 USD) as a decimal string (D1). Never a number or a float."
    },
    "https-origin": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[A-Za-z0-9](?:[A-Za-z0-9.-]{0,251}[A-Za-z0-9])?(?::[0-9]{1,5})?$",
      "description": "An https origin: scheme, host and optional port, with no path, query or fragment."
    },
    "secret": {
      "type": "object",
      "additionalProperties": false,
      "required": ["set"],
      "properties": {
        "set": {
          "type": "boolean",
          "description": "Whether a value is sealed in the owning service."
        },
        "hint": {
          "type": ["string", "null"],
          "maxLength": 16,
          "description": "A short hint (the last four characters), never the value."
        },
        "fingerprint": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{16}$",
          "description": "A keyed HMAC-SHA-256 fingerprint, 16 hex characters: tells whether two keys are the same without revealing either."
        },
        "set_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "set_by": {
          "type": ["string", "null"],
          "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$",
          "description": "The owner who set it."
        },
        "bound_to": {
          "$ref": "#/$defs/https-origin",
          "description": "The destination origin the value is sealed to; absent or null when unbound."
        }
      }
    },
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "group", "label", "description", "type", "source", "danger", "restart"],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "description": "Stable setting key, e.g. ai.model_catalog."
        },
        "group": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "description": "The id of the setting's group."
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "type": {
          "enum": ["boolean", "integer", "nano_usd", "string", "enum", "list", "secret"]
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "description": "The allowed values; present only when type is enum."
        },
        "min": {
          "type": "integer",
          "minimum": 0,
          "description": "The smallest allowed value; present only when type is integer or nano_usd."
        },
        "max": {
          "type": "integer",
          "minimum": 0,
          "description": "The largest allowed value; present only when type is integer or nano_usd."
        },
        "value": {
          "description": "The effective typed value; absent for type secret."
        },
        "default": {
          "description": "The typed default; absent for type secret."
        },
        "source": {
          "enum": ["env", "owner", "default"],
          "description": "env pins the setting read-only and wins; owner is a value the owner set; default is the built-in default."
        },
        "env": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,127}$",
          "description": "The environment variable that pins the setting; present when source is env."
        },
        "danger": {
          "type": "boolean",
          "description": "A write needs a fresh sign-in (and an operator alert)."
        },
        "restart": {
          "type": "boolean",
          "description": "A change takes effect only after the service restarts."
        },
        "secret": {
          "$ref": "#/$defs/secret",
          "description": "Write-only metadata; present only when type is secret."
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_by": {
          "type": "string",
          "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "secret" } },
            "required": ["type"]
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["value"] },
                { "required": ["default"] }
              ]
            },
            "properties": {
              "secret": { "$ref": "#/$defs/secret" }
            }
          },
          "else": {
            "not": { "required": ["secret"] }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "enum" } },
            "required": ["type"]
          },
          "then": {
            "required": ["enum"],
            "properties": {
              "value": { "type": "string" },
              "default": { "type": "string" }
            }
          },
          "else": {
            "not": { "required": ["enum"] }
          }
        },
        {
          "if": {
            "properties": { "type": { "enum": ["integer", "nano_usd"] } },
            "required": ["type"]
          },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["min"] },
                { "required": ["max"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "boolean" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "value": { "type": "boolean" },
              "default": { "type": "boolean" }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "integer" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "value": { "type": "integer" },
              "default": { "type": "integer" }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "nano_usd" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "value": { "$ref": "#/$defs/nano-usd" },
              "default": { "$ref": "#/$defs/nano-usd" }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "string" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "value": { "type": "string" },
              "default": { "type": "string" }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "list" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "value": {
                "type": "array",
                "maxItems": 256,
                "items": { "type": "string" }
              },
              "default": {
                "type": "array",
                "maxItems": 256,
                "items": { "type": "string" }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "source": { "const": "env" } },
            "required": ["source"]
          },
          "then": { "required": ["env"] }
        },
        {
          "if": {
            "properties": { "source": { "const": "default" } },
            "required": ["source"]
          },
          "then": { "required": ["default"] }
        },
        {
          "if": {
            "properties": {
              "source": { "const": "owner" },
              "type": { "not": { "const": "secret" } }
            },
            "required": ["source", "type"]
          },
          "then": { "required": ["value"] }
        }
      ]
    }
  }
}
