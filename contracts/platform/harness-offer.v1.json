{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/platform/harness-offer.v1.json",
  "title": "HarnessOffer",
  "description": "Registered coding or agent harness, its access method, limits, and price (T1 Universal Fabric; ADR-034 proposed).",
  "$comment": "Additive optional fields may extend this v1 contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "provider",
    "capabilities",
    "address",
    "price",
    "limits"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host_access": {
          "type": "boolean"
        },
        "mcp": {
          "type": "boolean"
        },
        "long_autonomy": {
          "type": "boolean"
        },
        "resume": {
          "type": "boolean"
        },
        "edit": {
          "type": "boolean",
          "description": "edits files in its working tree"
        },
        "review": {
          "type": "boolean",
          "description": "reviews a change and reports findings"
        },
        "tools": {
          "type": "boolean",
          "description": "calls tools such as a shell, search, or file reads on its own"
        },
        "vision": {
          "type": "boolean",
          "description": "reads images such as screenshots"
        },
        "browser": {
          "type": "boolean",
          "description": "drives a web browser"
        },
        "computer_use": {
          "type": "boolean",
          "description": "operates a desktop through its screen, keyboard, and mouse"
        },
        "runtimes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "function",
              "code",
              "browser",
              "linux",
              "desktop",
              "gpu"
            ]
          },
          "description": "platform.runtime-class@1 classes the harness runs in"
        }
      },
      "required": [
        "host_access",
        "mcp",
        "long_autonomy",
        "resume"
      ]
    },
    "address": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "api",
            "cli",
            "mcp"
          ]
        },
        "target": {
          "type": "string",
          "description": "Endpoint URI, executable, or MCP server name"
        }
      },
      "required": [
        "kind",
        "target"
      ]
    },
    "price": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "amount_usd": {
          "type": "number",
          "minimum": 0,
          "description": "Estimated USD"
        },
        "unit": {
          "type": "string",
          "description": "Billing unit"
        }
      },
      "required": [
        "amount_usd",
        "unit"
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_duration_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "max_concurrent_runs": {
          "type": "integer",
          "minimum": 0
        },
        "max_context_tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "max_duration_seconds",
        "max_concurrent_runs"
      ]
    },
    "task_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "edit",
          "review",
          "browse",
          "run",
          "test",
          "plan"
        ]
      },
      "description": "task kinds the harness takes; its resource offer lists the same kinds as task:<kind> capabilities"
    },
    "runtime_needs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9.-]*$",
        "maxLength": 40
      },
      "description": "runtimes the harness needs on its host, e.g. git, node, python, docker"
    },
    "byo_key": {
      "type": "boolean",
      "description": "the caller supplies their own provider key"
    },
    "success_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "measured share of routed tasks that finished green"
    }
  },
  "examples": [
    {
      "id": "harness-1",
      "name": "Example Agent",
      "provider": "example-ai",
      "capabilities": {
        "host_access": true,
        "mcp": true,
        "long_autonomy": true,
        "resume": true
      },
      "address": {
        "kind": "cli",
        "target": "example-agent"
      },
      "price": {
        "amount_usd": 0.1,
        "unit": "hour"
      },
      "limits": {
        "max_duration_seconds": 7200,
        "max_concurrent_runs": 4,
        "max_context_tokens": 128000
      },
      "task_capabilities": [
        "edit",
        "review",
        "run",
        "test"
      ],
      "runtime_needs": [
        "git",
        "node"
      ],
      "byo_key": false,
      "success_rate": 0.92
    }
  ]
}
