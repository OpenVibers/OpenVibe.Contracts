{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/report/ai-performance.v1.json",
  "title": "ReportAiPerformance",
  "description": "report.ai-performance@1 (ai-metrics.md): how AI calls performed over a range, for one group (a model, a provider, an operation, a system, a task). Percentiles come from log-scale histograms (within one bucket’s width). Public answers group by model, provider or operation only and show a group with at least 20 calls; system and task groups are for staff. Money is USD; tokens per second is the decode speed after the first token; cost per task sums the calls that share a task id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "group",
    "key",
    "calls"
  ],
  "properties": {
    "group": {
      "enum": [
        "model",
        "provider",
        "operation",
        "system",
        "task",
        "place",
        "harness"
      ]
    },
    "key": {
      "type": "string",
      "maxLength": 200
    },
    "provider": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 120
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string",
          "format": "date"
        },
        "to": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "calls": {
      "type": "integer",
      "minimum": 0
    },
    "succeeded": {
      "type": "integer",
      "minimum": 0
    },
    "errors": {
      "type": "integer",
      "minimum": 0
    },
    "success_rate": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "fallback_rate": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "streamed_share": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "cache_hit_rate": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "cache_read_share": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1,
      "description": "Cache-read tokens as a share of all input tokens."
    },
    "ttft_ms": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "p50": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "p90": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "p95": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "n": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "latency_ms": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "p50": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "p90": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "p95": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "n": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "tps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "p50": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "p90": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "p95": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "n": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input": {
          "type": "integer",
          "minimum": 0
        },
        "output": {
          "type": "integer",
          "minimum": 0
        },
        "reasoning": {
          "type": "integer",
          "minimum": 0
        },
        "cache_read": {
          "type": "integer",
          "minimum": 0
        },
        "cache_write": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "charged_usd": {
          "type": "number",
          "minimum": 0
        },
        "list_usd": {
          "type": "number",
          "minimum": 0
        },
        "cache_saved_usd": {
          "type": "number",
          "minimum": 0
        },
        "per_call_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "per_million_output_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "tasks": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "cost_per_task_usd": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "p50": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "p90": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "p95": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "n": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "time_per_task_ms": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "p50": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "p90": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "p95": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "n": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "top_errors": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error_class",
          "count"
        ],
        "properties": {
          "error_class": {
            "type": "string",
            "maxLength": 60
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
