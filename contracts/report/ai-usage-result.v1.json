{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/report/ai-usage-result.v1.json",
  "title": "ReportAiUsageResult",
  "description": "report.ai-usage-result@1: the AI meter in groups (plan L40/L41). GET /api/v1/ai/usage needs a service token with report.ai_usage.read; the rows are grouped by day, site, model, system or paid_by. A group that fewer than ten people share reads fewer than 10 instead of counting them.",
  "type": "object",
  "required": ["group", "usage", "totals"],
  "additionalProperties": false,
  "properties": {
    "group": { "type": "string", "enum": ["day", "site", "model", "system", "paid_by"] },
    "usage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["group", "key", "calls", "people", "input", "output", "reasoning", "cache_read", "cache_write", "list_cost_usd", "charged_usd", "fee_usd", "cache_saved_usd"],
        "additionalProperties": false,
        "properties": {
          "group": { "type": "string", "enum": ["day", "site", "model", "system", "paid_by"] },
          "key": { "type": "string", "maxLength": 200, "description": "The name of the group: the day, the site, the model, the system or the payer." },
          "calls": { "type": "integer", "minimum": 0 },
          "people": {
            "oneOf": [
              { "type": "integer", "minimum": 10, "description": "How many people the group holds, when there are ten or more." },
              { "const": "fewer than 10", "description": "Fewer than ten people: the count is not given." }
            ]
          },
          "input": { "type": "integer", "minimum": 0 },
          "output": { "type": "integer", "minimum": 0 },
          "reasoning": { "type": "integer", "minimum": 0 },
          "cache_read": { "type": "integer", "minimum": 0 },
          "cache_write": { "type": "integer", "minimum": 0 },
          "images": { "type": "integer", "minimum": 0 },
          "audio_seconds": { "type": "number", "minimum": 0 },
          "video_seconds": { "type": "number", "minimum": 0 },
          "list_cost_usd": { "type": "number", "minimum": 0 },
          "charged_usd": { "type": "number", "minimum": 0 },
          "fee_usd": { "type": "number", "minimum": 0 },
          "cache_saved_usd": { "type": "number", "minimum": 0 }
        }
      }
    },
    "totals": {
      "type": "object",
      "required": ["calls", "input", "output", "reasoning", "cache_read", "cache_write", "list_cost_usd", "charged_usd", "fee_usd", "cache_saved_usd"],
      "additionalProperties": false,
      "properties": {
        "calls": { "type": "integer", "minimum": 0 },
        "input": { "type": "integer", "minimum": 0 },
        "output": { "type": "integer", "minimum": 0 },
        "reasoning": { "type": "integer", "minimum": 0 },
        "cache_read": { "type": "integer", "minimum": 0 },
        "cache_write": { "type": "integer", "minimum": 0 },
        "images": { "type": "integer", "minimum": 0 },
        "audio_seconds": { "type": "number", "minimum": 0 },
        "video_seconds": { "type": "number", "minimum": 0 },
        "list_cost_usd": { "type": "number", "minimum": 0 },
        "charged_usd": { "type": "number", "minimum": 0 },
        "fee_usd": { "type": "number", "minimum": 0 },
        "cache_saved_usd": { "type": "number", "minimum": 0 }
      }
    }
  }
}
