{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/report/session-write-request.v1.json",
  "title": "ReportSessionWriteRequest",
  "description": "report.session-write-request@1 (the Agent Streams plan, S3): the body of POST /internal/session-reports on OpenVibe.Report (capability report.session.write). The caller is a first-party service - Codes, Actor or Live - holding that capability for the audience openvibe.report; the body names the person the session was theirs. The route is idempotent per (SOURCE, TASK.REF): a repeat of the same session's task answers the report already stored, with created false. The report's id is Report's own (rps_<ULID>); the body never carries one. Every text field passes the house redactor before anything is stored, so no secret and no raw transcript is ever stored.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "owner",
    "source",
    "task",
    "started_at",
    "ended_at",
    "worked_seconds",
    "outcome",
    "summary"
  ],
  "properties": {
    "owner": {
      "type": "string",
      "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "The person the session was theirs."
    },
    "source": {
      "enum": [
        "codes",
        "actor",
        "desk",
        "node"
      ]
    },
    "task": {
      "$ref": "#/$defs/task"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "worked_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "outcome": {
      "enum": [
        "done",
        "stopped",
        "failed"
      ]
    },
    "stopped_because": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "timeline": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/output"
      }
    },
    "proof": {
      "$ref": "#/$defs/proof"
    },
    "cost_usd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "models": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "highlights": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "stream": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "ags_id"
      ],
      "properties": {
        "ags_id": {
          "type": "string",
          "pattern": "^ags_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "vod_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        }
      }
    },
    "visibility": {
      "enum": [
        "private",
        "unlisted",
        "public"
      ],
      "description": "Who may see it. Absent means private."
    },
    "stream_only": {
      "type": "boolean",
      "description": "Live's stream-only report: the session is the stream itself and no tool will finish it. Absent or false means a normal session report."
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "ref"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at",
        "title",
        "status"
      ],
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "status": {
          "enum": [
            "started",
            "passed",
            "failed",
            "skipped"
          ]
        },
        "detail": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "tests": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "passed",
            "failed"
          ],
          "properties": {
            "passed": {
              "type": "integer",
              "minimum": 0
            },
            "failed": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "title"
      ],
      "properties": {
        "kind": {
          "enum": [
            "pr",
            "file",
            "page",
            "deploy",
            "clip",
            "vod"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "state": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 60
        }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tests",
        "screenshots",
        "review"
      ],
      "properties": {
        "tests": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "passed",
            "failed"
          ],
          "properties": {
            "passed": {
              "type": "integer",
              "minimum": 0
            },
            "failed": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "screenshots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "review": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "verdict"
          ],
          "properties": {
            "verdict": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "notes": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 2000
            }
          }
        }
      }
    }
  }
}
