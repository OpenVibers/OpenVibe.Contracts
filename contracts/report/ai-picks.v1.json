{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/report/ai-picks.v1.json",
  "title": "ReportAiPicks",
  "type": "object",
  "required": [
    "$schema",
    "generated_at",
    "picks"
  ],
  "properties": {
    "$schema": {
      "const": "report.ai-picks@1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "picks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "model",
          "why"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "model": {
            "type": [
              "object",
              "null"
            ]
          },
          "why": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": true,
  "description": "report.ai-picks@1: public OpenVibe.Report AI comparison response, with source dates and sample sizes for reported measurements."
}
