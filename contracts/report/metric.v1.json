{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/report/metric.v1.json",
  "title": "ReportMetric",
  "description": "report.metric@1: one count computed or ingested by Report, with a UTC day or a window. Money values come from Billing's API; Report does not derive them. Mirrors OpenVibe.Report docs/report.metric.v1.json on origin/main.",
  "type": "object",
  "required": ["metric", "scope", "scope_id", "value", "unit", "source"],
  "additionalProperties": false,
  "properties": {
    "metric": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,60}$" },
    "scope": { "enum": ["network", "site", "channel", "stream"] },
    "scope_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "day": { "type": "string", "format": "date" },
    "window_days": { "type": "integer", "enum": [7, 30, 90] },
    "value": { "type": "number" },
    "unit": { "enum": ["count", "seconds", "minutes", "bits", "cents", "milliseconds", "percent"] },
    "source": { "type": "string", "minLength": 1, "maxLength": 40 }
  },
  "oneOf": [
    { "required": ["day"], "not": { "required": ["window_days"] } },
    { "required": ["window_days"], "not": { "required": ["day"] } }
  ]
}
