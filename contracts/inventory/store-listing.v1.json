{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/inventory/store-listing.v1.json",
  "title": "InventoryStoreListing",
  "description": "Universal wallet: inventory.store-listing-request. Personal bearer reads and purchases; server-side reviewed prices.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "definition_id": {
      "type": "string",
      "pattern": "^itd_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "issuer": {
      "type": "string"
    },
    "prices": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vibes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "coins": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [],
      "minProperties": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "in_review",
        "published",
        "rejected"
      ]
    }
  },
  "required": [
    "definition_id",
    "issuer",
    "prices",
    "status"
  ]
}
