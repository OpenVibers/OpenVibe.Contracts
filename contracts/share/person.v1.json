{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/share/person.v1.json",
  "title": "SharePerson",
  "description": "share.person@1: a person in a sharing answer, from Network's identity projection. username, display_name and avatar_url are null when Network does not know the subject (or reports it banned or deleted).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "subject": {
      "$ref": "../identity/subject-ref.v1.json"
    },
    "username": {
      "type": [
        "string",
        "null"
      ]
    },
    "display_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "avatar_url": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "subject",
    "username",
    "display_name",
    "avatar_url"
  ]
}
