{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/share/share.v1.json",
  "title": "Share",
  "description": "share@1: the uniform GET/PUT body. People, not bare subjects; ids only, never a resource title or content except the service's own describe() (title and link). Members apply to people audience; pending recipients may preview for seven days.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ref": {
      "$ref": "resource-ref.v1.json"
    },
    "owner_subject": {
      "$ref": "../identity/subject-ref.v1.json"
    },
    "owner": {
      "$ref": "person.v1.json"
    },
    "audience": {
      "enum": [
        "public",
        "link",
        "people",
        "private"
      ]
    },
    "members": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "member.v1.json"
      }
    },
    "transfer": {
      "$ref": "transfer-view.v1.json"
    },
    "lock": {
      "enum": [
        "none",
        "people",
        "password",
        "link"
      ],
      "description": "How the resource is sealed (Locker). none means it is stored as it is; people, password and link are the three Locker locks. The server stores the envelope and never opens it."
    },
    "you": {
      "$ref": "you.v1.json"
    },
    "requests": {
      "type": "array",
      "items": {
        "$ref": "access-request-view.v1.json"
      }
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "link": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "viewer",
          "editor"
        ]
      }
    },
    "audiences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "public",
          "link",
          "people",
          "private"
        ]
      }
    },
    "transferable": {
      "type": "boolean"
    }
  },
  "required": [
    "ref",
    "owner_subject",
    "owner",
    "audience",
    "members",
    "you",
    "requests",
    "title",
    "link",
    "roles",
    "audiences",
    "transferable"
  ]
}
