{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/watch/watch.v1.json",
  "title": "Watch",
  "description": "watch.watch@1: a user-defined persistent observation (plan T18). It names a source (a push event, a webhook, a conditional HTTP URL, a feed or API, a local Node probe, or an expensive Run check), how a value is extracted, how it is compared with the last observation, the condition that fires, the actions it wakes, its budget and its retention. Carrier preference is binding: an event or webhook source is used when one exists, then ETag/Last-Modified, then a feed, then an API, and browser polling through Run only when none works. A price or stock is 'as of' the observation, null when it stated none.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "owner", "status", "source", "extraction", "condition", "action", "created_at", "updated_at"],
  "properties": {
    "id": { "type": "string", "pattern": "^wch_[0-9A-HJKMNP-TV-Z]{26}$" },
    "project_id": { "type": ["string", "null"], "pattern": "^prj_[0-9A-HJKMNP-TV-Z]{26}$" },
    "owner": { "type": "string", "description": "The acting person or agent the watch belongs to: usr_…, agt_… or svc:…." },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "labels": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 60 } },
    "status": { "enum": ["active", "paused", "disabled", "failed"] },
    "source": { "$ref": "#/$defs/source" },
    "cadence": { "$ref": "#/$defs/cadence" },
    "extraction": { "$ref": "#/$defs/extraction" },
    "comparison": { "$ref": "#/$defs/comparison" },
    "condition": { "$ref": "#/$defs/condition" },
    "action": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/action" } },
    "budget": { "$ref": "#/$defs/budget" },
    "retention": { "$ref": "#/$defs/retention" },
    "health": { "type": ["object", "null"], "additionalProperties": true },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "auth": {
      "type": "object",
      "required": ["mode"],
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["none", "header", "bearer", "query"] },
        "env": { "type": ["string", "null"], "pattern": "^WATCH_CRED_[A-Z0-9_]{2,60}$", "description": "The name of the environment variable holding the credential; Watch reads it by name at fetch time and never stores the value." },
        "header": { "type": ["string", "null"] },
        "param": { "type": ["string", "null"] }
      }
    },
    "source": {
      "oneOf": [
        { "type": "object", "required": ["kind"], "additionalProperties": false,
          "properties": { "kind": { "const": "webhook" }, "endpoint": { "type": "string", "pattern": "^/internal/hooks/" } } },
        { "type": "object", "required": ["kind", "pattern"], "additionalProperties": false,
          "properties": { "kind": { "const": "event" }, "pattern": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_*]+){1,}$" },
            "filter": { "type": ["object", "null"], "additionalProperties": { "type": ["string", "number", "boolean", "null"] } } } },
        { "type": "object", "required": ["kind", "url"], "additionalProperties": false,
          "properties": { "kind": { "enum": ["http", "feed", "api"] }, "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
            "method": { "enum": ["GET", "HEAD"] }, "format": { "enum": ["rss", "atom", "json", null] },
            "items_path": { "type": ["string", "null"] }, "fields": { "type": ["object", "null"], "additionalProperties": { "type": "string" } },
            "auth": { "$ref": "#/$defs/auth" }, "headers": { "type": "object", "additionalProperties": { "type": "string" } },
            "conditional": { "type": "boolean", "description": "Send If-None-Match / If-Modified-Since from the stored ETag/Last-Modified when the server gave one." } } },
        { "type": "object", "required": ["kind", "node_id", "probe"], "additionalProperties": false,
          "properties": { "kind": { "const": "node" }, "node_id": { "type": "string" }, "probe": { "type": "object", "additionalProperties": true } } },
        { "type": "object", "required": ["kind", "runtime", "steps"], "additionalProperties": false,
          "properties": { "kind": { "const": "run" }, "runtime": { "enum": ["browser", "code", "desktop"] },
            "url": { "type": ["string", "null"], "format": "uri" }, "steps": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": true } },
            "workload": { "$ref": "../platform/workload-requirements.v1.json" } } }
      ]
    },
    "cadence": {
      "type": ["object", "null"], "additionalProperties": false,
      "description": "Required for http/feed/api/node sources; null for event/webhook sources (they never poll).",
      "properties": { "every_sec": { "type": "integer", "minimum": 30, "maximum": 2592000 }, "jitter_sec": { "type": "integer", "minimum": 0, "maximum": 3600 }, "timezone": { "type": ["string", "null"] } }
    },
    "extraction": {
      "type": "object", "additionalProperties": false,
      "properties": { "kind": { "enum": ["text", "html", "json", "regex", "css", "jsonpath", "ai"] },
        "selector": { "type": ["string", "null"] }, "fields": { "type": ["object", "null"], "additionalProperties": { "type": "string" } },
        "value_path": { "type": ["string", "null"] }, "ai": { "type": ["object", "null"], "additionalProperties": true } }
    },
    "comparison": {
      "type": ["object", "null"], "additionalProperties": false,
      "properties": { "mode": { "enum": ["changed", "threshold", "none"] }, "tolerance": { "type": ["number", "null"] }, "percent": { "type": ["number", "null"] } }
    },
    "condition": {
      "type": "object", "additionalProperties": false,
      "properties": { "op": { "enum": ["changed", "gt", "gte", "lt", "lte", "eq", "ne", "contains", "matches", "exists", "absent"] },
        "value": { "type": ["string", "number", "null"] }, "for_sec": { "type": ["integer", "null"], "minimum": 0 } }
    },
    "action": { "oneOf": [
      { "type": "object", "required": ["kind"], "additionalProperties": false,
        "properties": { "kind": { "const": "notification" }, "category": { "enum": ["service", "social", "system"] }, "priority": { "enum": ["low", "normal", "high", "critical"] } } },
      { "type": "object", "required": ["kind", "event_type"], "additionalProperties": false,
        "properties": { "kind": { "const": "event" }, "event_type": { "type": "string" }, "payload": { "type": ["object", "null"], "additionalProperties": true } } },
      { "type": "object", "required": ["kind", "url", "secret_env"], "additionalProperties": false,
        "properties": { "kind": { "const": "webhook" }, "url": { "type": "string", "format": "uri", "pattern": "^https://" }, "secret_env": { "type": "string", "pattern": "^WATCH_HOOK_[A-Z0-9_]{2,60}$" } } },
      { "type": "object", "required": ["kind", "brief"], "additionalProperties": false,
        "properties": { "kind": { "const": "actor-task" }, "brief": { "type": "string", "maxLength": 8000 }, "budget_usd": { "type": ["number", "null"] } } },
      { "type": "object", "required": ["kind", "repo", "brief"], "additionalProperties": false,
        "properties": { "kind": { "const": "codes-run" }, "repo": { "type": "string" }, "brief": { "type": "string", "maxLength": 8000 } } },
      { "type": "object", "required": ["kind", "runtime", "command"], "additionalProperties": false,
        "properties": { "kind": { "const": "run-job" }, "runtime": { "enum": ["function", "code", "browser", "linux"] }, "command": { "type": "string" }, "workload": { "type": ["object", "null"], "additionalProperties": true } } } ] },
    "budget": {
      "type": "object", "additionalProperties": false,
      "properties": { "checks_per_day": { "type": ["integer", "null"], "minimum": 1 }, "usd_per_month": { "type": ["number", "null"], "minimum": 0 },
        "max_runtime_ms": { "type": ["integer", "null"], "minimum": 100 }, "max_bytes": { "type": ["integer", "null"], "minimum": 1024 } }
    },
    "retention": { "type": "object", "additionalProperties": false,
      "properties": { "observations_days": { "type": ["integer", "null"], "minimum": 1 }, "keep_snapshots": { "type": "boolean" } } }
  }
}
