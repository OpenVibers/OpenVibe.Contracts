{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/community/pulse-write-request.v1.json",
  "title": "CommunityPulseWriteRequest",
  "description": "community.pulse-write-request@1: the body of POST /api/v1/pulse/items on OpenVibe.Community (community.pulse.write; service tokens only): an item about one of the calling service's own entities, with a title and an absolute http(s) URL. Optional media carries an HTTPS thumbnail, preview video, aspect ratio and duration for Feed cards. Visibility is public by default; followers requires origin user and X-OV-Subject and is shown only to that person's followers. Private, unlisted and members items are refused. The same ref updates the item. DELETE /api/v1/pulse/items/:service/:type/:id retracts it.",
  "anyOf": [
    {
      "type": "object",
      "required": [
        "ref",
        "title",
        "url"
      ],
      "properties": {
        "ref": {
          "$ref": "../common/entity-ref.v1.json"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "At most 300 characters once whitespace is collapsed."
        },
        "url": {
          "type": "string",
          "maxLength": 2000,
          "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://"
        },
        "origin": {
          "enum": [
            "user",
            "ai",
            "system",
            null
          ]
        },
        "occurred_at": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "visibility": {
          "enum": [
            "public",
            "followers",
            null
          ]
        },
        "media": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "thumb": {
              "type": "string",
              "pattern": "^https://",
              "maxLength": 2000
            },
            "preview": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^https://",
              "maxLength": 2000
            },
            "ratio": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 20
            },
            "length": {
              "type": "number",
              "minimum": 0,
              "maximum": 86400
            }
          }
        }
      }
    },
    {
      "$ref": "../common/no-body.v1.json"
    }
  ]
}
