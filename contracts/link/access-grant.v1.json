{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/link/access-grant.v1.json",
  "title": "LinkAccessGrant",
  "description": "Approved machine access; null expiration is for same-owner agent or send only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "from_principal",
    "to_principal",
    "scopes",
    "approved_by",
    "created_at",
    "expires_at",
    "revoked_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]{3}_[A-Za-z0-9_-]{8,80}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[a-z]{3}_[A-Za-z0-9_-]{8,80}$"
    },
    "from_principal": {
      "type": "string",
      "pattern": "^lnk_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "to_principal": {
      "type": "string",
      "pattern": "^lnk_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "agent",
          "send",
          "screen",
          "desk",
          "computer",
          "worker"
        ]
      }
    },
    "approved_by": {
      "type": "string",
      "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "revoked_at": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
