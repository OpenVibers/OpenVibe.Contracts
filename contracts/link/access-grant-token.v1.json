{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/link/access-grant-token.v1.json",
  "title": "LinkAccessGrantToken",
  "description": "Claims of the signed grant JWT; target is audience, requester is subject.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "iss",
    "aud",
    "sub",
    "jti",
    "grant_id",
    "scopes",
    "iat",
    "exp"
  ],
  "properties": {
    "iss": {
      "type": "string"
    },
    "aud": {
      "type": "string",
      "pattern": "^lnk_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "sub": {
      "type": "string",
      "pattern": "^lnk_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "jti": {
      "type": "string",
      "pattern": "^[a-z]{3}_[A-Za-z0-9_-]{8,80}$"
    },
    "grant_id": {
      "type": "string",
      "pattern": "^[a-z]{3}_[A-Za-z0-9_-]{8,80}$"
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "agent",
          "send",
          "screen",
          "desk",
          "computer",
          "worker"
        ]
      }
    },
    "iat": {
      "type": "integer"
    },
    "exp": {
      "type": "integer"
    }
  }
}
