{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/ai/credential.v1.json",
  "title": "AiCredential",
  "description": "ai.credential@1 (OpenVibe.AI; roadmap WS-O task 2): a stored credential as its owner service reads it (GET or PUT /api/v1/credentials/{subject}): never the key, only its last four characters.",
  "type": "object",
  "required": [
    "subject",
    "owner",
    "provider",
    "key_hint",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "subject": {
      "type": "string",
      "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "owner": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}$",
      "description": "The service that stored it; only it may use or change it."
    },
    "provider": {
      "enum": [
        "openai",
        "anthropic"
      ]
    },
    "base_url": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    },
    "key_hint": {
      "type": "string",
      "pattern": "^…[\\s\\S]{1,4}$"
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 5,
      "properties": {
        "chat": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "vision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "director": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "legacy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      },
      "description": "Model per Live role; `chat` is the default for the others."
    },
    "budget_usd_per_day": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "spent_usd_today": {
      "type": "number",
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_used_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
