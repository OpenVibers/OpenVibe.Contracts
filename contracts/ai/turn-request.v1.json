{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/ai/turn-request.v1.json",
  "title": "AiTurnRequest",
  "description": "ai.turn-request@1: one conversational turn. Files are Media references, never inline bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["messages"],
  "properties": {
    "messages": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["role", "content"], "properties": {"role": {"enum": ["user", "assistant"]}, "content": {"type": "string", "maxLength": 200000}, "files": {"type": "array", "items": {"$ref": "file.v1.json"}}}}},
    "files": {"type": "array", "description": "Files attached by the person for this turn.", "items": {"$ref": "file.v1.json"}}
  }
}
