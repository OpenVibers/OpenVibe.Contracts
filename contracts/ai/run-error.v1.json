{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/ai/run-error.v1.json",
  "title": "AiRunError",
  "description": "ai.run-error@1: safe, actionable words for an AI or Actor run. Raw provider responses are never display text. The code map is shared across products.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "words",
    "next",
    "action"
  ],
  "properties": {
    "code": {
      "type": "string",
      "maxLength": 80
    },
    "words": {
      "type": "string",
      "maxLength": 240
    },
    "next": {
      "type": "string",
      "maxLength": 240
    },
    "action": {
      "enum": [
        "pick_model",
        "add_key",
        "retry",
        "retry_later",
        "open"
      ]
    },
    "retry_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
