{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/ai/credential.v2.json",
  "title": "AiCredentialV2",
  "description": "ai.credential@2 (OpenVibe.AI; Codes C3): one stored credential as its owner service reads it (GET or PUT /api/v1/credentials/{subject} or /{subject}/{provider}): never the key, only its last four characters. It widens ai.credential@1's provider to the providers of ai.credential-put@2, so a person may keep one key per provider; `key_hint` is present for every provider except `node`, whose machine is named instead.",
  "type": "object",
  "required": [
    "subject",
    "owner",
    "provider",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "subject": {
      "type": "string",
      "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "owner": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}$",
      "description": "The service that stored it; only it may use or change it."
    },
    "provider": {
      "enum": [
        "anthropic",
        "openai",
        "deepseek",
        "minimax",
        "openrouter",
        "custom",
        "node"
      ]
    },
    "machine": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(dev_[0-9A-HJKMNP-TV-Z]{26}|any)$",
      "description": "provider node: the machine it runs on, or `any` of the person's own"
    },
    "base_url": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    },
    "key_hint": {
      "type": "string",
      "pattern": "^…[\\s\\S]{1,4}$"
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 5,
      "properties": {
        "chat": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "vision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "director": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "legacy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      },
      "description": "Model per role on this provider; `chat` is the default for the others."
    },
    "budget_usd_per_day": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "spent_usd_today": {
      "type": "number",
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_used_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "provider": {
            "not": {
              "const": "node"
            }
          }
        },
        "required": [
          "provider"
        ]
      },
      "then": {
        "required": [
          "key_hint"
        ]
      }
    }
  ]
}
