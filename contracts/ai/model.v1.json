{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/ai/model.v1.json",
  "title": "AiModel",
  "description": "ai.model@1: one model of a provider in OpenVibe.AI's registry (server/registry.js decodeModel): type, status, limits, per-million-token costs and what it supports.",
  "type": "object",
  "required": [
    "provider_key",
    "model_key",
    "type",
    "status",
    "cost",
    "supports"
  ],
  "properties": {
    "provider_key": {
      "type": "string"
    },
    "model_key": {
      "type": "string",
      "maxLength": 200
    },
    "display_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "type": {
      "enum": [
        "chat",
        "vision",
        "embedding",
        "stt"
      ]
    },
    "status": {
      "enum": [
        "active",
        "disabled"
      ]
    },
    "context_window": {
      "type": [
        "integer",
        "null"
      ]
    },
    "max_output": {
      "type": [
        "integer",
        "null"
      ]
    },
    "cost": {
      "type": "object",
      "properties": {
        "in_per_mtok": {
          "type": [
            "number",
            "null"
          ]
        },
        "out_per_mtok": {
          "type": [
            "number",
            "null"
          ]
        },
        "cached_per_mtok": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "supports": {
      "type": "object",
      "properties": {
        "json": {
          "type": "boolean"
        },
        "tools": {
          "type": "boolean"
        },
        "streaming": {
          "type": "boolean"
        },
        "vision": {
          "type": "boolean"
        }
      }
    },
    "metadata": {
      "type": "object"
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
