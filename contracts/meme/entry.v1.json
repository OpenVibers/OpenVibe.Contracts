{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/meme/entry.v1.json",
  "title": "MemeEntry",
  "description": "meme.entry@1: a cited, public entry in the OpenVibe.Meme internet-meme encyclopedia, including its origin, timeline, variations, examples and related entries.",
  "type": "object",
  "required": ["id", "slug", "title", "scope", "kind", "status", "summary", "meaning", "usage", "first_seen_at", "last_seen_at", "visibility", "revision", "origin", "web_origin", "citations", "timeline", "spread", "variations", "examples", "related"],
  "properties": {
    "id": { "type": "string", "pattern": "^mem_[0-9A-HJKMNP-TV-Z]{26}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80 },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "scope": { "const": "internet" },
    "kind": { "type": "string", "enum": ["classic", "format", "meme"] },
    "status": { "type": "string", "enum": ["rising", "peaked", "classic", "dead"] },
    "summary": { "type": ["string", "null"], "maxLength": 600 },
    "meaning": { "type": ["string", "null"], "maxLength": 4000 },
    "usage": { "type": ["string", "null"], "maxLength": 4000 },
    "labels": { "type": "array", "items": { "type": "string", "maxLength": 40 }, "maxItems": 20 },
    "first_seen_at": { "type": ["string", "null"], "format": "date-time" },
    "last_seen_at": { "type": ["string", "null"], "format": "date-time" },
    "visibility": { "const": "public" },
    "revision": { "type": "integer", "minimum": 1 },
    "origin": { "type": ["object", "null"] },
    "web_origin": { "type": ["object", "null"] },
    "citations": { "type": "array", "items": { "type": "object" }, "maxItems": 1000 },
    "timeline": { "type": "array", "items": { "type": "object" }, "maxItems": 1000 },
    "spread": { "type": "array", "items": { "type": "object" }, "maxItems": 100 },
    "variations": { "type": "array", "items": { "type": "object" }, "maxItems": 100 },
    "examples": { "type": "array", "items": { "type": "object" }, "maxItems": 100 },
    "related": { "type": "array", "items": { "type": "object" }, "maxItems": 30 },
    "revisions": { "type": "array", "items": { "type": "object" }, "maxItems": 200 },
    "url": { "type": "string", "format": "uri" }
  },
  "additionalProperties": true
}
