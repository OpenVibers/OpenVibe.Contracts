{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/meme/template.v1.json",
  "title": "MemeTemplate",
  "description": "meme.template@1: a reusable meme image with its source, reuse licence and caption layout. Public templates have passed any required review.",
  "type": "object",
  "required": ["id", "name", "image_url", "box_count", "source", "license", "created_at"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 80 },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "image_url": { "type": "string", "format": "uri-reference", "maxLength": 2048 },
    "box_count": { "type": "integer", "minimum": 1, "maximum": 8 },
    "source": { "type": "string", "maxLength": 160 },
    "license": { "type": "string", "maxLength": 200 },
    "credit": { "type": "string", "maxLength": 300 },
    "source_url": { "type": "string", "format": "uri", "maxLength": 2048 },
    "attribution": { "type": "string", "maxLength": 500 },
    "created_at": { "type": "string", "format": "date-time" },
    "layout": { "type": "object", "required": ["width", "height", "boxes"], "properties": { "width": { "type": "integer", "minimum": 64, "maximum": 4096 }, "height": { "type": "integer", "minimum": 64, "maximum": 4096 }, "boxes": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "object" } } }, "additionalProperties": true },
    "captions": { "type": "integer", "minimum": 0 },
    "uses_today": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": true
}
