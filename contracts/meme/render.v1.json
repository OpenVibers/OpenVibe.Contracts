{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/meme/render.v1.json",
  "title": "MemeRenderRequest",
  "description": "meme.render@1: a request to render 1–4 caption lines over an approved template. PNG is the default; GIF and MP4 return short, looped exports. Editor positions and crop coordinates are percentages of the canvas.",
  "type": "object",
  "required": ["template_id", "lines"],
  "properties": {
    "template_id": { "type": "string", "minLength": 1, "maxLength": 80 },
    "lines": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "string", "maxLength": 120 } },
    "format": { "type": "string", "enum": ["png", "gif", "mp4"], "default": "png" },
    "editor": {
      "type": "object",
      "properties": {
        "font_style": { "type": "string", "enum": ["impact", "modern", "soft"] },
        "font_size": { "type": "integer", "minimum": 10, "maximum": 64 },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "outline": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "outline_width": { "type": "integer", "minimum": 0, "maximum": 8 },
        "crop_x": { "type": "number", "minimum": 0, "maximum": 100 },
        "crop_y": { "type": "number", "minimum": 0, "maximum": 100 },
        "boxes": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "object", "required": ["x", "y", "w", "h"], "properties": { "x": { "type": "number", "minimum": 0, "maximum": 100 }, "y": { "type": "number", "minimum": 0, "maximum": 100 }, "w": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 }, "h": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 } }, "additionalProperties": false } },
        "stickers": { "type": "array", "maxItems": 8, "items": { "type": "object", "required": ["emoji", "x", "y"], "properties": { "emoji": { "type": "string", "enum": ["✨", "😂", "🔥", "💀", "👀", "❤️", "🙌"] }, "x": { "type": "number", "minimum": 0, "maximum": 100 }, "y": { "type": "number", "minimum": 0, "maximum": 100 } }, "additionalProperties": false } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
