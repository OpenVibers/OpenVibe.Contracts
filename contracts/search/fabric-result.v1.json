{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/search/fabric-result.v1.json",
  "title": "SearchFabricResult",
  "description": "search.fabric-result@1: the answer of search.fabric.query. results come grouped by scope order (the room's own first when the caller asked for it); every web result keeps its provider, URL and date; route.explain says, step by step, what was asked, what answered, from cache or not, and what it cost. The query is never echoed: a page renders results without writing the query into its HTML (the ?q= rule).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "results",
    "groups",
    "route",
    "next_cursor"
  ],
  "properties": {
    "results": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope",
          "kind",
          "title",
          "url"
        ],
        "properties": {
          "scope": {
            "enum": [
              "network",
              "mine",
              "web",
              "news",
              "images",
              "video",
              "products",
              "people",
              "places",
              "code"
            ]
          },
          "kind": {
            "enum": [
              "document",
              "page"
            ],
            "description": "document: in Search's index (owner, type, id set); page: a web page (provider set)."
          },
          "title": {
            "type": "string",
            "maxLength": 300
          },
          "url": {
            "type": "string",
            "maxLength": 2048,
            "format": "uri"
          },
          "snippet": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 600,
            "description": "Plain text; never HTML."
          },
          "site": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 253
          },
          "image": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2048
          },
          "published_at": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 40
          },
          "retrieved_at": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 40,
            "description": "When a web page was read (by the provider or the open index)."
          },
          "provider": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 40,
            "description": "page: who found it (open_index, deepseek, wikipedia, brave, \u2026)."
          },
          "owner": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 32
          },
          "type": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 32
          },
          "id": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          },
          "score": {
            "type": [
              "number",
              "null"
            ],
            "description": "Rank within its scope (higher first); not comparable across scopes."
          }
        }
      }
    },
    "groups": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      },
      "description": "How many results each scope gave on this page."
    },
    "answer": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "text",
        "citations",
        "label"
      ],
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 2000
        },
        "citations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "label": {
          "const": "Written by AI from these sources"
        }
      }
    },
    "citations": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "n",
          "url",
          "title"
        ],
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "url": {
            "type": "string",
            "maxLength": 2048
          },
          "title": {
            "type": "string",
            "maxLength": 300
          },
          "provider": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 40
          },
          "retrieved_at": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 40
          }
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "explain",
        "cost_usd"
      ],
      "properties": {
        "explain": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scope",
              "step",
              "ok"
            ],
            "properties": {
              "scope": {
                "enum": [
                  "network",
                  "mine",
                  "web",
                  "news",
                  "images",
                  "video",
                  "products",
                  "people",
                  "places",
                  "code"
                ]
              },
              "step": {
                "type": "string",
                "maxLength": 40,
                "description": "index, open_index, cache, deepseek, wikipedia, \u2026"
              },
              "ok": {
                "type": "boolean"
              },
              "count": {
                "type": "integer",
                "minimum": 0
              },
              "ms": {
                "type": "integer",
                "minimum": 0
              },
              "cached": {
                "type": "boolean"
              },
              "cost_usd": {
                "type": "number",
                "minimum": 0
              },
              "skipped": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 160,
                "description": "Why the step did not run (not allowed for this caller, quick depth, an earlier step answered, provider standing down)."
              }
            }
          }
        },
        "cost_usd": {
          "type": "number",
          "minimum": 0,
          "description": "What this query cost OpenVibe (paid provider calls; cached answers cost 0)."
        }
      }
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512
    }
  }
}
