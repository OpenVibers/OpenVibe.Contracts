{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/billing/credit-hold-settle-result.v1.json",
  "title": "BillingInferenceHoldSettleResult",
  "description": "billing.credit-hold-settle-result@1: response from POST /internal/credits/holds/:id/settle.",
  "type": "object",
  "required": [
    "charge_nano_usd",
    "released_nano_usd",
    "journal_id"
  ],
  "additionalProperties": false,
  "$defs": {
    "money-nano-usd": {
      "type": "string",
      "pattern": "^[0-9]{1,19}$",
      "description": "Integer nano-USD (1e-9 USD), stored as a string."
    }
  },
  "properties": {
    "charge_nano_usd": {
      "$ref": "#/$defs/money-nano-usd"
    },
    "released_nano_usd": {
      "$ref": "#/$defs/money-nano-usd"
    },
    "journal_id": {
      "type": "string",
      "pattern": "^txn_"
    },
    "shortfall_nano_usd": {
      "type": "string",
      "pattern": "^[0-9]{1,19}$",
      "description": "Usage beyond the hold and the free balance: owed, not collected (nano-USD, D1)."
    }
  }
}
