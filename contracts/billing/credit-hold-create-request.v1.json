{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/billing/credit-hold-create-request.v1.json",
  "title": "BillingCreditHoldCreateRequest",
  "description": "billing.credit-hold-create-request@1: body of POST /internal/credits/holds. Reserves inference credit up to max_nano_usd against a (subject, project_id) account, priced at the given immutable rate version.",
  "type": "object",
  "required": [
    "idempotency_key",
    "subject",
    "project_id",
    "max_nano_usd",
    "rate_version",
    "request_fingerprint"
  ],
  "additionalProperties": false,
  "$defs": {
    "money-nano-usd": {
      "type": "string",
      "pattern": "^[0-9]{1,19}$",
      "description": "Integer nano-USD (1e-9 USD), stored as a string."
    }
  },
  "properties": {
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{8,128}$"
    },
    "subject": {
      "$ref": "../identity/subject-ref.v1.json"
    },
    "project_id": {
      "type": "string",
      "pattern": "^prj_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "credential_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^cred_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "max_nano_usd": {
      "$ref": "#/$defs/money-nano-usd"
    },
    "rate_version": {
      "type": "string"
    },
    "request_fingerprint": {
      "type": "string",
      "maxLength": 1024
    },
    "service": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,39}$",
      "description": "Which metered service spends the credit (D9): ai, run, ... Defaults to ai."
    }
  }
}
