{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/billing/credit-hold-settle-request.v1.json",
  "title": "BillingCreditHoldSettleRequest",
  "description": "billing.credit-hold-settle-request@1: body of POST /internal/credits/holds/:id/settle. Idempotent: the same key and fingerprint return the same settlement.",
  "type": "object",
  "required": [
    "idempotency_key",
    "usage",
    "retail",
    "supply_cost_nano_usd",
    "byok",
    "attempts"
  ],
  "additionalProperties": false,
  "$defs": {
    "money-nano-usd": {
      "type": "string",
      "pattern": "^[0-9]{1,19}$",
      "description": "Integer nano-USD (1e-9 USD), stored as a string."
    }
  },
  "properties": {
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{8,128}$"
    },
    "usage": {
      "type": "object",
      "required": [
        "input_tokens",
        "cached_read_tokens",
        "cache_write_tokens",
        "output_tokens"
      ],
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cached_read_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cache_write_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "retail": {
      "type": "object",
      "required": [
        "version",
        "nano_usd_per_m",
        "per_request_nano_usd"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string"
        },
        "nano_usd_per_m": {
          "type": "object",
          "required": [
            "input",
            "cached_read",
            "cache_write",
            "output"
          ],
          "additionalProperties": false,
          "properties": {
            "input": {
              "$ref": "#/$defs/money-nano-usd"
            },
            "cached_read": {
              "$ref": "#/$defs/money-nano-usd"
            },
            "cache_write": {
              "$ref": "#/$defs/money-nano-usd"
            },
            "output": {
              "$ref": "#/$defs/money-nano-usd"
            }
          }
        },
        "per_request_nano_usd": {
          "$ref": "#/$defs/money-nano-usd"
        }
      }
    },
    "supply_cost_nano_usd": {
      "$ref": "#/$defs/money-nano-usd"
    },
    "byok": {
      "type": "boolean"
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "deployment_id",
          "started_at",
          "ended_at"
        ],
        "additionalProperties": false,
        "properties": {
          "deployment_id": {
            "type": "string"
          },
          "provider_access": {
            "type": "string",
            "enum": [
              "OWN_DEPLOYMENT",
              "AUTHORIZED_WHOLESALE",
              "CUSTOMER_BYOK",
              "RESTRICTED",
              "UNVERIFIED"
            ]
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "ended_at": {
            "type": "string",
            "format": "date-time"
          },
          "error_code": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
