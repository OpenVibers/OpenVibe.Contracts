{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/food/recipe-result.v1.json",
  "title": "FoodRecipeResult",
  "description": "food.recipe-result@1: what food.recipes.suggest answers: the new suggestion (POST /api/v1/recipes/suggest, 201) or the caller's recent ones (GET /api/v1/recipes).",
  "anyOf": [
    {
      "$ref": "recipe-suggestion.v1.json"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipes"
      ],
      "properties": {
        "recipes": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "recipe-suggestion.v1.json"
          }
        }
      }
    }
  ]
}
