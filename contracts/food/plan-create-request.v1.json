{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/food/plan-create-request.v1.json",
  "title": "FoodPlanCreateRequest",
  "description": "food.plan-create-request@1: POST /api/v1/plans on OpenVibe.Food. people 1-12, days 1-14, budget (US dollars for the whole plan) optional, title optional.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "people",
    "days"
  ],
  "properties": {
    "people": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 14
    },
    "budget": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 1,
      "maximum": 5000
    },
    "title": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 120
    }
  }
}
