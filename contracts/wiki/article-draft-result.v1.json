{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/wiki/article-draft-result.v1.json",
  "title": "WikiArticleDraftResult",
  "description": "wiki.article-draft-result@1: what the wiki writer answers. The draft revision is pending review — status is always 'pending' — with the workflow and run that wrote it, the model that answered, and the sources its sentences cited. Nothing here is published.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposal",
    "revision"
  ],
  "properties": {
    "proposal": {
      "type": "object",
      "required": [
        "id",
        "page_id",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "page_id": {
          "type": "string"
        },
        "space_id": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "base_revision": {
          "type": "integer",
          "minimum": 0
        },
        "workflow_id": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "status": {
          "const": "pending"
        },
        "proposed_by": {
          "type": "string"
        }
      }
    },
    "revision": {
      "$ref": "revision.v1.json"
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "model": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "provider": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "sources": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2048
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          },
          "author": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          },
          "retrieved_at": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 40
          },
          "license": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          }
        }
      }
    }
  }
}
