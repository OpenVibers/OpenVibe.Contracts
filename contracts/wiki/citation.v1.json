{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/wiki/citation.v1.json",
  "title": "WikiCitation",
  "description": "wiki.citation@1: one source cited by a page revision (server/http/api.js serializeCitation), a URL read at a time or a OpenVibe.Sources item, with an optional quote and licence note. Citations of a published revision are fixed.",
  "type": "object",
  "required": [
    "id",
    "revision"
  ],
  "properties": {
    "id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "revision": {
      "type": "integer"
    },
    "url": {
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_item_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "retrieved_at": {
      "type": [
        "string",
        "integer",
        "null"
      ]
    },
    "quote": {},
    "license_note": {
      "type": [
        "string",
        "null"
      ]
    },
    "carried_from": {},
    "attached_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "attached_at": {
      "type": [
        "string",
        "integer",
        "null"
      ]
    }
  }
}
