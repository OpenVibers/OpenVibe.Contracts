{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/wiki/citation-attach-request.v1.json",
  "title": "WikiCitationAttachRequest",
  "description": "wiki.citation-attach-request@1: the body of POST /api/v1/pages/:id/revisions/:n/citations on OpenVibe.Wiki (wiki.citation.attach, editors): sources for the newest revision while it is unpublished (a published revision's sources are fixed: 409 citation.revision_published; an older one is 409 citation.not_head). A URL citation needs retrieved_at; a Sources item id brings its own URL, title and retrieval time.",
  "type": "object",
  "required": [
    "citations"
  ],
  "properties": {
    "citations": {
      "type": "array",
      "maxItems": 50,
      "description": "At most 50. Each needs a URL (with retrieved_at) or a Sources item id (url, title and retrieval come from the item).",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_item_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "retrieved_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "quote": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "null"
              }
            ],
            "description": "Cut to 5000 characters."
          },
          "license_note": {
            "type": [
              "string",
              "null"
            ]
          },
          "anchor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
