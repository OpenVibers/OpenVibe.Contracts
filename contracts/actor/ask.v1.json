{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/actor/ask.v1.json",
  "title": "ActorAsk",
  "description": "One question or action waiting for the owner of a personal Actor. An answer never grants permission for a different action.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "actor",
    "goal",
    "kind",
    "text",
    "options",
    "created",
    "answered"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ask_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "actor": {
      "type": "string",
      "pattern": "^act_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "goal": {
      "type": "string",
      "pattern": "^agl_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "kind": {
      "enum": [
        "approve_action",
        "answer_question",
        "do_yourself",
        "sign_in"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "options": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "created": {
      "type": "string",
      "format": "date-time"
    },
    "answered": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "at",
            "decision"
          ],
          "properties": {
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "decision": {
              "enum": [
                "answer",
                "decline"
              ]
            },
            "text": {
              "type": "string",
              "maxLength": 4000
            }
          }
        }
      ]
    },
    "screen_url": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2048,
      "description": "The Actor page where its person can take over the screen; not a credential."
    },
    "evidence": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 2000
        }
      }
    }
  }
}
