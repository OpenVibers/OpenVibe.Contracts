{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/actor/agent-manage-result.v1.json",
  "title": "ActorAgentManageResult",
  "description": "actor.agent-manage-result@1: GET /api/v1/me/agents → { agents }; an agent (create 201, read, update); GET …/memory → { memory } (newest first); a note (create 201, update). DELETE answers 204 with no body.",
  "anyOf": [
    {
      "type": "object",
      "required": [
        "agents"
      ],
      "properties": {
        "agents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "instructions",
              "mode",
              "schedule",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^agt_[0-9A-HJKMNP-TV-Z]{26}$"
              },
              "owner": {
                "type": "string"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "instructions": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "mode": {
                "enum": [
                  "balanced",
                  "cheapest",
                  "best",
                  "fastest",
                  "private"
                ]
              },
              "budget_per_run_usd": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "At most the person's per-task allowance."
              },
              "daily_runs_max": {
                "type": "integer",
                "minimum": 1,
                "maximum": 24
              },
              "schedule": {
                "enum": [
                  "off",
                  "hourly",
                  "daily",
                  "weekly"
                ]
              },
              "schedule_at": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
                "description": "HH:MM UTC, for daily and weekly."
              },
              "schedule_dow": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 6,
                "description": "0 is Sunday; for weekly."
              },
              "quiet_from": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
                "description": "HH:MM UTC: quiet hours start. No scheduled run starts from quiet_from to quiet_to (the window may cross midnight; an hourly run waits until it ends); a run its owner starts still runs. Both or neither."
              },
              "quiet_to": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
                "description": "HH:MM UTC: quiet hours end."
              },
              "send_to_vibe": {
                "type": "boolean",
                "description": "Post each finished run into the person's own Vibe chat named after the agent (chat.vibe.deliver), so each run is a chat they can open and continue. Default true."
              },
              "status": {
                "enum": [
                  "active",
                  "paused"
                ]
              },
              "next_run_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "last_run_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "last_skip_reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "created_at": {
                "type": "string"
              },
              "updated_at": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "memory"
      ],
      "properties": {
        "memory": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "text",
              "origin"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^mem_[0-9A-HJKMNP-TV-Z]{26}$"
              },
              "agent_id": {
                "type": "string",
                "pattern": "^agt_[0-9A-HJKMNP-TV-Z]{26}$"
              },
              "text": {
                "type": "string"
              },
              "origin": {
                "enum": [
                  "person",
                  "agent"
                ]
              },
              "created_at": {
                "type": "string"
              },
              "updated_at": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "id",
        "name",
        "instructions",
        "mode",
        "schedule",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^agt_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "owner": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "instructions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "mode": {
          "enum": [
            "balanced",
            "cheapest",
            "best",
            "fastest",
            "private"
          ]
        },
        "budget_per_run_usd": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "At most the person's per-task allowance."
        },
        "daily_runs_max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        },
        "schedule": {
          "enum": [
            "off",
            "hourly",
            "daily",
            "weekly"
          ]
        },
        "schedule_at": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "description": "HH:MM UTC, for daily and weekly."
        },
        "schedule_dow": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 6,
          "description": "0 is Sunday; for weekly."
        },
        "quiet_from": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "description": "HH:MM UTC: quiet hours start. No scheduled run starts from quiet_from to quiet_to (the window may cross midnight; an hourly run waits until it ends); a run its owner starts still runs. Both or neither."
        },
        "quiet_to": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "description": "HH:MM UTC: quiet hours end."
        },
        "send_to_vibe": {
          "type": "boolean",
          "description": "Post each finished run into the person's own Vibe chat named after the agent (chat.vibe.deliver), so each run is a chat they can open and continue. Default true."
        },
        "status": {
          "enum": [
            "active",
            "paused"
          ]
        },
        "next_run_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_run_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_skip_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "id",
        "text",
        "origin"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^mem_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "agent_id": {
          "type": "string",
          "pattern": "^agt_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "text": {
          "type": "string"
        },
        "origin": {
          "enum": [
            "person",
            "agent"
          ]
        },
        "created_at": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        }
      }
    }
  ]
}
