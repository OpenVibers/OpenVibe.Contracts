{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/actor/a2a-task-request.v1.json",
  "title": "ActorA2ATaskRequest",
  "description": "actor.a2a-task-request@1: POST /a2a/v1/tasks gives OpenVibe.Actor one A2A task (the Agent2Agent shape: a message with text parts, an optional skill and an optional id to continue). The caller is a Network service token with the capability actor.a2a.task acting for a person (X-OV-Subject); the task runs under that person's allowance and allow-list, exactly like a task they started. Answered 201 with the A2A task (actor.a2a-task-result@1).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "message"
  ],
  "properties": {
    "message": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "parts"
      ],
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "user"
          ]
        },
        "parts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "text"
                ]
              },
              "text": {
                "type": "string",
                "maxLength": 8000
              }
            }
          }
        }
      }
    },
    "skillId": {
      "type": "string",
      "maxLength": 64
    },
    "taskId": {
      "type": "string",
      "maxLength": 64
    }
  }
}
