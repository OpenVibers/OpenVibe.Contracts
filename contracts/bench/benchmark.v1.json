{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/bench/benchmark.v1.json",
  "title": "BenchBenchmark",
  "description": "bench.benchmark@1: a versioned, forkable benchmark on OpenVibe.Bench (spec 2026-10-30, stage B1). It holds the tasks, the judges, how they combine into one score, the limits a run may not pass, the default model and harness matrix, and the visibility of the set. A version is immutable once a run names it; a fork records its parent. Holdout tasks are hidden from everyone but the executor.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "owner",
    "title",
    "description",
    "kind",
    "tags",
    "visibility",
    "version",
    "parent",
    "tasks",
    "judges",
    "scoring",
    "limits",
    "matrix",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^bmk_[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "The benchmark id; the same id carries every version."
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "Who owns the set: a person (usr_…), a project (prj_…) or a service."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "maxLength": 4000
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "One of Bench's kinds; the kind sets the renderer."
    },
    "tags": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      }
    },
    "visibility": {
      "enum": [
        "public",
        "unlisted"
      ],
      "description": "public appears in the registry; unlisted is reachable by id only."
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "The version number this document is."
    },
    "parent": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 120,
      "description": "The benchmark id@version this one was forked from, or null."
    },
    "tasks": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "judges": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/judge"
      }
    },
    "scoring": {
      "$ref": "#/$defs/scoring"
    },
    "limits": {
      "$ref": "#/$defs/limits"
    },
    "matrix": {
      "$ref": "#/$defs/matrix"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "prompt",
        "holdout"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "files": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "expected": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true,
          "description": "What a correct answer looks like; the judge reads it."
        },
        "holdout": {
          "type": "boolean",
          "description": "A hidden task: it is withheld from everyone but the executor, against tuning to the set."
        }
      }
    },
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "version",
        "config"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "human_pairwise | rubric | automatic_grader | test_suite | game_outcome"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "The pinned judge version; a run names the judge it used."
        },
        "config": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "scale"
      ],
      "properties": {
        "method": {
          "enum": [
            "mean",
            "weighted",
            "pass_rate",
            "sum"
          ]
        },
        "scale": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          },
          "description": "The score scale; 0-100 for Bench."
        },
        "weights": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "aggregate": {
          "type": "string",
          "maxLength": 120
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ms": {
          "type": "number",
          "minimum": 0,
          "description": "The time one task may take."
        },
        "tokens": {
          "type": "integer",
          "minimum": 0
        },
        "usd": {
          "type": "number",
          "minimum": 0,
          "description": "The money one run may spend."
        }
      }
    },
    "matrix": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "models": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 160
          }
        },
        "harnesses": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 160
          }
        }
      }
    }
  }
}
