{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/bench/rating.v1.json",
  "title": "BenchRating",
  "description": "bench.rating@1: a rating on a benchmark board on OpenVibe.Bench. CATEGORY and SUBJECT identify what is rated (a model, a route or a room's own subject); ELO, GAMES, WINS, LOSSES, TIES and WIN_RATE are the score; CI_LOWER and CI_UPPER bound the estimate. 1.1.0 (2026-11-13, compare-arena-ecosystem.md): ENTRANT_KIND says what SUBJECT is (a bench.entrant@1 kind); STYLE_CONTROL says whether length and markdown were held out of the score; FACTORS split an agent's strength into its model, its harness and the two together, each with its interval; beside the score: cost and tokens per solved task, first-token and speed percentiles and reliability, from the matches' receipts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind_id", "category", "subject", "elo", "games", "wins", "losses", "ties", "win_rate", "ci_lower", "ci_upper"],
  "properties": {
    "kind_id": { "type": "string" },
    "category": { "type": "string" },
    "subject": { "type": "string" },
    "elo": { "type": "number" },
    "games": { "type": "number" },
    "wins": { "type": "number" },
    "losses": { "type": "number" },
    "ties": { "type": "number" },
    "win_rate": { "type": "number" },
    "ci_lower": { "type": "number" },
    "ci_upper": { "type": "number" },
    "entrant_kind": { "enum": ["model", "harness", "agent", "product"] },
    "style_control": { "type": "boolean" },
    "factors": { "type": ["object", "null"], "additionalProperties": false, "properties": { "model": { "type": "object", "additionalProperties": false, "required": ["score"], "properties": { "score": { "type": "number" }, "ci_lower": { "type": ["number", "null"] }, "ci_upper": { "type": ["number", "null"] } } }, "harness": { "type": "object", "additionalProperties": false, "required": ["score"], "properties": { "score": { "type": "number" }, "ci_lower": { "type": ["number", "null"] }, "ci_upper": { "type": ["number", "null"] } } }, "interaction": { "type": "object", "additionalProperties": false, "required": ["score"], "properties": { "score": { "type": "number" }, "ci_lower": { "type": ["number", "null"] }, "ci_upper": { "type": ["number", "null"] } } } }, "description": "An agent's strength split: model + harness + model×harness (partial pooling), on the score's scale." },
    "matches": { "type": "integer", "minimum": 0 },
    "cost_per_solved_usd": { "type": ["number", "null"], "minimum": 0 },
    "tokens_per_task": { "type": ["number", "null"], "minimum": 0 },
    "ttft_ms": { "type": ["object", "null"], "additionalProperties": false, "properties": { "p50": { "type": ["number", "null"], "minimum": 0 }, "p95": { "type": ["number", "null"], "minimum": 0 }, "n": { "type": "integer", "minimum": 0 } } },
    "tps": { "type": ["object", "null"], "additionalProperties": false, "properties": { "p50": { "type": ["number", "null"], "minimum": 0 }, "p95": { "type": ["number", "null"], "minimum": 0 }, "n": { "type": "integer", "minimum": 0 } } },
    "reliability": { "type": ["object", "null"], "additionalProperties": false, "required": ["k", "pass_k"], "properties": { "k": { "type": "integer", "minimum": 1 }, "pass_k": { "type": "number", "minimum": 0, "maximum": 1 } }, "description": "pass^k: the share of tasks solved on all k tries." },
    "as_of": { "type": "string", "format": "date-time" },
    "median_cost_usd": { "type": ["number", "null"] },
    "median_ms": { "type": ["number", "null"] },
    "provisional": { "type": "boolean" }
  }
}
