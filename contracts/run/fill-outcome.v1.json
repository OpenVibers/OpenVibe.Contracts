{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/run/fill-outcome.v1.json",
  "title": "RunFillOutcome",
  "description": "Credential-free result of a blind sign-in fill.",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "outcome"],
  "properties": {
    "request_id": {"type": "string", "pattern": "^fr_[A-Za-z0-9_-]{16,64}$"},
    "outcome": {"enum": ["ok", "failed"]},
    "reason": {"enum": ["origin_changed", "expired", "reused", "not_owned", "no_fields", "iframe", "decrypt_failed", "navigation", "refused", "timeout", null]}
  }
}
