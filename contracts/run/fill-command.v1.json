{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/run/fill-command.v1.json",
  "title": "RunFillCommand",
  "description": "Machine-side blind fill command. Contains only the request id and sealed bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "envelope"],
  "properties": {
    "request_id": {"type": "string", "pattern": "^fr_[A-Za-z0-9_-]{16,64}$"},
    "envelope": {"type": "string", "contentEncoding": "base64", "minLength": 12, "maxLength": 16384, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"}
  }
}
