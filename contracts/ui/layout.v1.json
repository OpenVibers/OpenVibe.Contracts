{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/ui/layout.v1.json",
  "title": "UiLayout",
  "description": "ui.layout@1: one person's arrangement of one surface on one device class. A layout names the surface and its catalog version, the device, its own name, its author and its sharing (private, link or gallery), and one entry per part it places. A part is visible or not, sits on the surface's grid (x, y, w, h in cells) or docks to an edge for an overlay, and carries a style (a theme token tint, a shape, opacity 0.4-1 and the label) and bindings. It is data only: no URL, no markup and no code may appear anywhere in it, and every part id, tint, shape, opacity, size and binding must be one the catalog allows. openvibe-sdk/ui-layout validates it before any server, editor or AI answer stores or shows it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "surface",
    "surface_version",
    "device",
    "name",
    "author",
    "sharing",
    "parts"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^lay_[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "Assigned by OpenVibe.Network when the layout is stored; absent in a draft, a share answer or an AI suggestion."
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "description": "Assigned by the store; every change to a stored layout moves it by one."
    },
    "active": {
      "type": "boolean",
      "description": "Set by OpenVibe.Network: the one layout a product draws for this surface on this device class. A draft, a share answer and an AI suggestion carry no active field."
    },
    "surface": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$",
      "maxLength": 80
    },
    "surface_version": {
      "type": "integer",
      "minimum": 1
    },
    "device": {
      "enum": [
        "phone",
        "tablet",
        "computer"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "The person's name for this layout; \"My phone controls\" is fine."
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "subject": {
          "$ref": "../identity/subject-ref.v1.json"
        }
      },
      "description": "The author's display name and, for a private or link layout, the subject. A share or gallery answer carries the display name only, never the account."
    },
    "sharing": {
      "enum": [
        "private",
        "link",
        "gallery"
      ]
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/part"
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "place": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "w",
            "h"
          ],
          "properties": {
            "x": {
              "type": "integer",
              "minimum": 0,
              "maximum": 23
            },
            "y": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "w": {
              "type": "integer",
              "minimum": 1,
              "maximum": 24
            },
            "h": {
              "type": "integer",
              "minimum": 1,
              "maximum": 24
            }
          },
          "description": "The part's cell on the surface grid."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dock",
            "order",
            "w",
            "h"
          ],
          "properties": {
            "dock": {
              "enum": [
                "left",
                "right",
                "top",
                "bottom"
              ]
            },
            "order": {
              "type": "integer",
              "minimum": 0,
              "maximum": 63
            },
            "w": {
              "type": "integer",
              "minimum": 1,
              "maximum": 24
            },
            "h": {
              "type": "integer",
              "minimum": 1,
              "maximum": 24
            }
          },
          "description": "For an overlay: the edge the part docks to, its order along that edge, and its size in cells."
        }
      ]
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tint",
        "shape",
        "opacity",
        "label"
      ],
      "properties": {
        "tint": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,39}$",
          "description": "A theme token, never a colour: the theme decides what it is, so contrast follows the theme."
        },
        "shape": {
          "enum": [
            "round",
            "pill",
            "square"
          ]
        },
        "opacity": {
          "type": "number",
          "minimum": 0.4,
          "maximum": 1
        },
        "label": {
          "type": "boolean"
        }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keys",
        "gamepad"
      ],
      "properties": {
        "keys": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9+_.-]{1,40}$"
          }
        },
        "gamepad": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,39}$"
          }
        }
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "visible",
        "place",
        "style",
        "bindings"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,39}$"
        },
        "visible": {
          "type": "boolean"
        },
        "place": {
          "$ref": "#/$defs/place"
        },
        "style": {
          "$ref": "#/$defs/style"
        },
        "bindings": {
          "$ref": "#/$defs/bindings"
        }
      }
    }
  }
}
