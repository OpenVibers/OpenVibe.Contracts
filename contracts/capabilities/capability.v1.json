{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/capabilities/capability.v1.json",
  "title": "Capability",
  "description": "An action a principal may invoke. Authorization is checked at the owner's boundary against the grant, never inferred from the caller's route.",
  "type": "object",
  "required": ["id", "version", "owner", "status", "visibility", "permissions", "resourceConstraints", "quotaClass", "events"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+){2,}$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "owner": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,39}$" },
    "status": { "enum": ["planned", "active", "deprecated", "retired"] },
    "visibility": { "enum": ["public", "first-party", "internal"] },
    "description": { "type": "string" },
    "inputSchema": { "type": "string" },
    "outputSchema": { "type": "string" },
    "permissions": { "type": "array", "items": { "type": "string" } },
    "resourceConstraints": { "type": "array", "items": { "enum": ["namespace", "owner", "room_member", "space_member", "project", "none"] } },
    "quotaClass": { "type": "string" },
    "events": { "type": "array", "items": { "type": "string" } },
    "implementedBy": { "type": "array", "items": { "type": "string" }, "description": "Current route(s) that perform this action today, e.g. 'POST /api/v1/:app/files'." }
  }
}
