{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/git/tree.v1.json",
  "title": "GitTree",
  "description": "One directory of a repository at a ref: its entries with mode, size and the last commit that touched each. api/view/tree.",
  "type": "object",
  "required": ["repo", "ref", "path", "entries"],
  "additionalProperties": false,
  "properties": {
    "repo": { "type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9][a-z0-9._-]{0,99}$" },
    "ref": { "type": "string", "minLength": 1, "maxLength": 255, "description": "The branch, tag or commit the tree was read at." },
    "path": { "type": "string", "maxLength": 4096, "description": "The directory, empty at the repository root." },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path", "type", "mode", "sha"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "path": { "type": "string" },
          "type": { "enum": ["blob", "tree", "commit"] },
          "mode": { "type": "string", "pattern": "^[0-7]{6}$" },
          "sha": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" },
          "size": { "type": ["integer", "null"], "minimum": 0 },
          "last_commit": {
            "type": ["object", "null"],
            "required": ["sha", "message", "date", "author_name"],
            "additionalProperties": false,
            "properties": {
              "sha": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" },
              "message": { "type": "string", "maxLength": 500 },
              "date": { "type": "string", "format": "date-time" },
              "author_name": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
