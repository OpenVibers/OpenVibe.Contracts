{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/git/access-result.v1.json",
  "title": "GitAccessResult",
  "description": "git.access-result@1: the common result of git.read and git.write on OpenVibe.Git. A repository names its full name, its page and clone addresses, its visibility and default branch; a contents write or a token also carries the branch or commit it made.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "full_name"
  ],
  "properties": {
    "full_name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,38}/[a-z0-9][a-z0-9._-]{0,99}$"
    },
    "html_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "clone_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "private"
      ]
    },
    "default_branch": {
      "type": "string",
      "maxLength": 255
    },
    "branch": {
      "type": "string",
      "maxLength": 255
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    }
  }
}
