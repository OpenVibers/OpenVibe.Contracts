{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/git/issue.v1.json",
  "title": "GitIssue",
  "description": "Git G2 issue metadata. Community thread is hidden; Git authorizes repository access. PostgreSQL bigint numbers may be decimal strings.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "number",
    "repo_id",
    "title",
    "body",
    "author",
    "state",
    "thread_id",
    "created_at",
    "closed_at",
    "labels"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^iss_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "number": {
      "type": [
        "integer",
        "string"
      ],
      "pattern": "^[1-9][0-9]*$",
      "minimum": 1
    },
    "repo_id": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "body": {
      "type": "string",
      "maxLength": 10000
    },
    "author": {
      "type": "string"
    },
    "state": {
      "enum": [
        "open",
        "closed"
      ]
    },
    "thread_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "closed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "labels": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_ -]{1,40}$"
      }
    }
  }
}
