{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/events/payloads/network.link.access.revoked.v1.json",
  "title": "NetworkLinkAccessRevokedPayload",
  "description": "Machine access grant was revoked.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grant_id",
    "from_principal",
    "to_principal",
    "at"
  ],
  "properties": {
    "grant_id": {
      "type": "string",
      "pattern": "^[a-z]{3}_[A-Za-z0-9_-]{8,80}$"
    },
    "from_principal": {
      "type": "string",
      "pattern": "^lnk_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "to_principal": {
      "type": "string",
      "pattern": "^lnk_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
