{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/events/payloads/run.session.ended.v1.json",
  "title": "RunSessionEndedPayload",
  "description": "run.session.ended v1 (OpenVibe.Run; the Desks plan's D6). A session ended (end.reason ended, ttl, idle, host_lost, unplaceable or failed), its desk stopped and its lease given back; usage.desk_seconds is final. The session as run.session@1 has it. Envelope: subject { type: session, id: <session id> }, visibility internal, priority low, actor service:run.",
  "type": "object",
  "required": [
    "id",
    "owner",
    "via",
    "kind",
    "state",
    "size",
    "ttl_s",
    "idle_s",
    "placement",
    "timings",
    "end",
    "usage",
    "idempotency_key"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "../../run/session.v1.json#/$defs/session_id"
    },
    "owner": {
      "$ref": "../../identity/subject-ref.v1.json"
    },
    "via": {
      "$ref": "../../run/session.v1.json#/properties/via"
    },
    "kind": {
      "$ref": "../../run/session.v1.json#/properties/kind"
    },
    "state": {
      "const": "ended"
    },
    "size": {
      "$ref": "../../run/session.v1.json#/$defs/size"
    },
    "ttl_s": {
      "$ref": "../../run/session.v1.json#/properties/ttl_s"
    },
    "idle_s": {
      "$ref": "../../run/session.v1.json#/properties/idle_s"
    },
    "placement": {
      "anyOf": [
        {
          "$ref": "../../run/session.v1.json#/$defs/placement"
        },
        {
          "type": "null"
        }
      ]
    },
    "timings": {
      "$ref": "../../run/session.v1.json#/$defs/timings"
    },
    "end": {
      "$ref": "../../run/session.v1.json#/$defs/end"
    },
    "usage": {
      "$ref": "../../run/session.v1.json#/$defs/usage"
    },
    "idempotency_key": {
      "$ref": "../../run/session.v1.json#/properties/idempotency_key"
    }
  }
}
