{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/events/payloads/run.job.started.v1.json",
  "title": "RunJobStartedPayload",
  "description": "run.job.started v1 (OpenVibe.Run; PLANNED: the Run service does not exist yet, plan T14 R1). The node sent job_started: the process runs. Usage seconds count from started_at. A projection of run.job-read-result@1 without args, inputs, result or output. Envelope: subject { type: job, id: <job_id> }, visibility internal, priority low, actor service:run.",
  "type": "object",
  "required": [
    "job_id",
    "project_id",
    "requester",
    "state",
    "class",
    "artifact",
    "egress",
    "placement",
    "timings",
    "exit",
    "usage",
    "error"
  ],
  "additionalProperties": false,
  "properties": {
    "job_id": {
      "type": "string",
      "pattern": "^job_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^prj_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "requester": {
      "$ref": "../../identity/subject-ref.v1.json"
    },
    "state": {
      "const": "running",
      "description": "The job state (run.job-read-result@1 state)."
    },
    "class": {
      "$ref": "../../platform/runtime-class.v1.json"
    },
    "artifact": {
      "anyOf": [
        {
          "$ref": "../../run/job-create-request.v1.json#/$defs/artifact"
        },
        {
          "type": "null"
        }
      ]
    },
    "egress": {
      "$ref": "../../run/job-create-request.v1.json#/$defs/egress"
    },
    "placement": {
      "$ref": "../../run/job-read-result.v1.json#/$defs/placement"
    },
    "timings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_at",
        "placed_at",
        "started_at",
        "finished_at"
      ],
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "placed_at": {
          "type": "string",
          "format": "date-time"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "null"
        }
      }
    },
    "exit": {
      "type": "null"
    },
    "usage": {
      "$ref": "../../run/job-read-result.v1.json#/$defs/usage"
    },
    "error": {
      "type": "null"
    }
  }
}
