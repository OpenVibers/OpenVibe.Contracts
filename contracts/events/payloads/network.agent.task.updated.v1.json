{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/events/payloads/network.agent.task.updated.v1.json",
  "title": "NetworkAgentTaskUpdatedPayload",
  "description": "Agent task status changed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "thread",
    "status",
    "at"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[a-z]{3}_[A-Za-z0-9_-]{8,80}$"
    },
    "thread": {
      "type": "string",
      "pattern": "^[a-z]{3}_[A-Za-z0-9_-]{8,80}$"
    },
    "status": {
      "enum": [
        "pending",
        "running",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
