{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/events/payloads/network.agent.task.created.v1.json",
  "title": "NetworkAgentTaskCreatedPayload",
  "description": "Agent task was created.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "thread",
    "from",
    "to",
    "at"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[a-z]{3}_[A-Za-z0-9_-]{8,80}$"
    },
    "thread": {
      "type": "string",
      "pattern": "^[a-z]{3}_[A-Za-z0-9_-]{8,80}$"
    },
    "from": {
      "type": "string",
      "pattern": "^agt_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "to": {
      "type": "string",
      "pattern": "^agt_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
