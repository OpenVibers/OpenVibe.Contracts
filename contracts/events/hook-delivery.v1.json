{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/events/hook-delivery.v1.json",
  "title": "EventsHookDelivery",
  "description": "events.hook-delivery@1: one attempt by OpenVibe.Events to deliver an event to a hook. It carries the outcome, timing, size and hash of the payload, never the payload itself, its headers, the signature or the hook's secret. A delivery is retried inside its hook's window and dead-lettered after it; replay creates a new attempt that names the one it replays.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "hook_id",
    "event_id",
    "event_type",
    "attempt",
    "status",
    "payload_bytes",
    "payload_sha256",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^whd_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "hook_id": {
      "type": "string",
      "pattern": "^hok_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^evt_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+){2,}$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "status": {
      "enum": [
        "queued",
        "delivering",
        "delivered",
        "failed",
        "dead"
      ],
      "description": "failed is a retryable attempt; dead is the last, after the hook's window. A 2xx answer marks delivered."
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64,
      "description": "The delivery request id, for tracing; not a secret."
    },
    "response_code": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 100,
      "maximum": 599
    },
    "latency_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "payload_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1048576
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "The SHA-256 of the signed body, so a consumer can check it without the body being stored here."
    },
    "signature_version": {
      "const": "v2"
    },
    "next_attempt_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "attempted_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "dead_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "error": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 400,
      "description": "A short transport or status reason; never a response body."
    },
    "replay_of": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^whd_[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "The failed or dead attempt this one replays."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
