{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/network/level-award.v1.json",
  "title": "NetworkLevelAward",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subject",
    "reason",
    "amount",
    "idempotency_key"
  ],
  "properties": {
    "subject": {
      "type": "string",
      "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "reason": {
      "enum": [
        "quest.completed",
        "coins.earned",
        "video.published",
        "stream.watched"
      ]
    },
    "amount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    }
  },
  "description": "NetworkLevelAward: one earned platform level owned by Network; experience is never bought or spent."
}
