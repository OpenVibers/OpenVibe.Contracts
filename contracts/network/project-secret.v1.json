{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/network/project-secret.v1.json",
  "title": "ProjectSecret",
  "description": "network.project-secret@1 (ADR-056): one project secret as OpenVibe.Network shows it to the project's members and staff — its name, environment, version, a keyed fingerprint and its grants. Never the value: a secret is written once and used by name (sign or reveal through network.secret.use).",
  "type": "object",
  "required": ["project_id", "environment", "name", "version", "fingerprint", "grants", "created_at", "created_by", "updated_at", "updated_by"],
  "additionalProperties": false,
  "$defs": {
    "subject": { "type": "string", "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$" },
    "grant": {
      "type": "object",
      "required": ["service", "purposes", "origins", "created_at", "created_by", "last_used_at"],
      "additionalProperties": false,
      "properties": {
        "service": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,39}$", "description": "The service id the secret is granted to (its token's svc:<id>)." },
        "purposes": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "enum": ["sign", "reveal"] } },
        "origins": { "type": "array", "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "pattern": "^https://[a-z0-9.-]+(:[0-9]{1,5})?$" }, "description": "The https origins the value may be revealed for (reveal only; empty for sign)." },
        "created_at": { "type": "string", "format": "date-time" },
        "created_by": { "$ref": "#/$defs/subject" },
        "last_used_at": { "type": ["string", "null"], "format": "date-time" }
      }
    }
  },
  "properties": {
    "project_id": { "type": "string", "pattern": "^prj_[0-9A-HJKMNP-TV-Z]{26}$" },
    "environment": { "enum": ["sandbox", "production"] },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
    "version": { "type": "integer", "minimum": 1, "description": "One more each time the value is set again." },
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{12}$", "description": "A keyed hash of the value: equal values have equal fingerprints, and it reveals nothing else." },
    "grants": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/grant" } },
    "created_at": { "type": "string", "format": "date-time" },
    "created_by": { "$ref": "#/$defs/subject" },
    "updated_at": { "type": "string", "format": "date-time" },
    "updated_by": { "$ref": "#/$defs/subject" }
  }
}
