{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/network/friend-circle.v1.json",
  "title": "NetworkFriendCircle",
  "description": "network.friend-circle@1 (plan §AB.51; the owner, 11-14: \"implement the friend system so it can be used across sites … synced with your network account … SDK and API … send and request … make your own UIs\"). GET /api/v1/me/friends on OpenVibe.Network: the person's friends in one read. Adding is one direction; two people are friends when both have added each other. mutual: friends; requests: they added you, you have not added them; asked: you added them, they have not added you. friends: whom you added (both mutual and asked), kept for older readers. Online people first in each list. A block on either side removes the person from every list.",
  "type": "object",
  "required": [
    "subject",
    "friends",
    "mutual",
    "requests",
    "asked"
  ],
  "additionalProperties": false,
  "properties": {
    "subject": {
      "type": "string",
      "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "The person reading."
    },
    "friends": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "required": [
          "subject"
        ],
        "properties": {
          "subject": {
            "type": "string",
            "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$"
          }
        }
      }
    },
    "mutual": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "required": [
          "subject",
          "username",
          "display_name",
          "online"
        ],
        "additionalProperties": false,
        "properties": {
          "subject": {
            "type": "string",
            "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "username": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64
          },
          "display_name": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128
          },
          "avatar_url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 2048
          },
          "online": {
            "type": "boolean",
            "description": "Seen on an OpenVibe site in the last few minutes (Network's presence)."
          },
          "site": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 80,
            "description": "Where they are, when online and they share it."
          },
          "since": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 40,
            "description": "When this side of the friendship last changed."
          }
        }
      }
    },
    "requests": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "required": [
          "subject",
          "username",
          "display_name",
          "online"
        ],
        "additionalProperties": false,
        "properties": {
          "subject": {
            "type": "string",
            "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "username": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64
          },
          "display_name": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128
          },
          "avatar_url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 2048
          },
          "online": {
            "type": "boolean",
            "description": "Seen on an OpenVibe site in the last few minutes (Network's presence)."
          },
          "site": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 80,
            "description": "Where they are, when online and they share it."
          },
          "since": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 40,
            "description": "When this side of the friendship last changed."
          }
        }
      }
    },
    "asked": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "required": [
          "subject",
          "username",
          "display_name",
          "online"
        ],
        "additionalProperties": false,
        "properties": {
          "subject": {
            "type": "string",
            "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "username": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64
          },
          "display_name": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128
          },
          "avatar_url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 2048
          },
          "online": {
            "type": "boolean",
            "description": "Seen on an OpenVibe site in the last few minutes (Network's presence)."
          },
          "site": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 80,
            "description": "Where they are, when online and they share it."
          },
          "since": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 40,
            "description": "When this side of the friendship last changed."
          }
        }
      }
    }
  }
}
