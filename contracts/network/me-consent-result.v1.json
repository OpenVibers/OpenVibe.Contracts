{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/network/me-consent-result.v1.json",
  "title": "NetworkMeConsentResult",
  "description": "network.me-consent-result@1 (L24): \"Your data choices\" for the signed-in person. GET /api/v1/me/consent (and the answer to PUT /api/v1/me/consent/:purpose and DELETE /api/v1/me/consent/:purpose/:client) on OpenVibe.Network. Every purpose is listed with the words the account page shows, whether the person has turned it on, and the history of their changes. Off is the default for every purpose.",
  "type": "object",
  "additionalProperties": false,
  "required": ["purposes", "consents", "history"],
  "properties": {
    "purposes": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "allows", "off", "cannot_undo", "adults_only", "kinds", "text_version"],
        "properties": {
          "id": { "enum": ["ai.train", "data.public", "face.recognize", "app.data"] },
          "title": { "type": "string", "minLength": 1, "maxLength": 80 },
          "allows": { "type": "string", "minLength": 1, "maxLength": 300, "description": "What turning it on allows, in one plain line." },
          "off": { "type": "string", "minLength": 1, "maxLength": 300, "description": "What turning it off does." },
          "cannot_undo": { "type": "string", "maxLength": 300, "description": "What turning it off cannot undo (empty when nothing)." },
          "adults_only": { "type": "boolean", "description": "Turning it on asks the person to confirm they are 18 or older." },
          "kinds": {
            "type": "array",
            "maxItems": 8,
            "uniqueItems": true,
            "items": { "enum": ["streams", "vods", "clips", "voice", "chat", "posts", "pictures", "code"] },
            "description": "The kinds of content the person may narrow it to (empty: the purpose takes none)."
          },
          "text_version": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[0-9]{1,3}$" }
        }
      }
    },
    "consents": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "consent.v1.json" },
      "description": "The person's active choices (network.consent@1), one per purpose and app."
    },
    "history": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["consent_id", "purpose", "action", "at", "by", "text_version"],
        "properties": {
          "consent_id": { "type": "string", "pattern": "^cns_[0-9A-HJKMNP-TV-Z]{26}$" },
          "purpose": { "enum": ["ai.train", "data.public", "face.recognize", "app.data"] },
          "client": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$" },
          "action": { "enum": ["granted", "revoked", "expired"] },
          "at": { "type": "string", "format": "date-time" },
          "by": { "enum": ["person", "app_revoked", "merge", "deletion", "import"], "description": "Who made the change: the person, the app being revoked, an account merge, an account deletion, or the move of an older record." },
          "text_version": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[0-9]{1,3}$" }
        }
      },
      "description": "The newest changes first."
    }
  }
}
