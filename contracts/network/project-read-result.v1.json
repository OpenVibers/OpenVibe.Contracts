{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/network/project-read-result.v1.json",
  "title": "NetworkProjectReadResult",
  "description": "network.project-read-result@1: the service-facing answer from OpenVibe.Network GET /internal/projects/:project_id (network.project.read). It carries project tenancy, allowances, quotas, apps and each app's grants (requested, approved, denied or revoked) without credentials or member identities beyond the owner.",
  "type": "object",
  "required": ["project", "allowance", "quotas", "apps", "grants"],
  "additionalProperties": false,
  "properties": {
    "project": {
      "type": "object",
      "required": ["id", "name", "owner", "environment_policy", "home_cell", "residency", "preferred_regions", "archived_at", "created_at"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^prj_[0-9A-HJKMNP-TV-Z]{26}$" },
        "name": { "type": "string" },
        "owner": {
          "type": "object",
          "required": ["type", "id"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "user" },
            "id": { "type": "string", "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$" }
          }
        },
        "environment_policy": { "type": "string" },
        "home_cell": { "type": ["string", "null"] },
        "residency": { "type": ["string", "null"] },
        "preferred_regions": { "type": "array", "items": { "type": "string" } },
        "archived_at": { "type": ["string", "null"] },
        "created_at": { "type": "string" }
      }
    },
    "allowance": { "type": "array", "items": { "type": "string" } },
    "quotas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["capability", "limit", "window", "unit", "enforced_by"],
        "additionalProperties": false,
        "properties": {
          "capability": { "type": "string" },
          "limit": { "type": "number", "minimum": 0 },
          "window": { "type": "string" },
          "unit": { "type": "string" },
          "enforced_by": { "type": ["string", "null"] }
        }
      }
    },
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "environment", "status", "created_at", "revoked_at"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^app_[0-9A-HJKMNP-TV-Z]{26}$" },
          "name": { "type": "string" },
          "environment": { "type": "string" },
          "status": { "enum": ["active", "revoked"] },
          "created_at": { "type": "string" },
          "revoked_at": { "type": ["string", "null"] }
        }
      }
    },
    "grants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["app_id", "capability", "audience", "status", "decided_at"],
        "additionalProperties": false,
        "properties": {
          "app_id": { "type": "string", "pattern": "^app_[0-9A-HJKMNP-TV-Z]{26}$" },
          "capability": { "type": "string" },
          "audience": { "type": "string" },
          "status": { "enum": ["requested", "approved", "denied", "revoked"] },
          "decided_at": { "type": ["string", "null"] }
        }
      }
    }
  }
}
