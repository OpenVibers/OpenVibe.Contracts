{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/chat/vibe-conversations-result.v1.json",
  "title": "ChatVibeConversationsResult",
  "description": "chat.vibe-conversations-result@1: GET /api/vibe/conversations for a person, newest first. The last line and origin site are omitted when none is known.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "conversations",
    "count"
  ],
  "properties": {
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "conversations": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slug",
          "name",
          "last_message_at",
          "created_at",
          "last_line",
          "last_answer_at",
          "site"
        ],
        "properties": {
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "last_message_at": {
            "type": "string",
            "format": "date-time"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "last_line": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 160
          },
          "last_answer_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "site": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 120
          }
        }
      }
    }
  }
}
