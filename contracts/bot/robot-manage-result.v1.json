{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/bot/robot-manage-result.v1.json",
  "title": "BotRobotManageResult",
  "description": "bot.robot-manage-result@1: answers of bot.robot.manage on OpenVibe.Bot. POST /api/v1/robots → 201 { robot, pairing }; PATCH …/robots/:id → { robot }; DELETE …/robots/:id → 204 (no body); POST …/robots/:id/pairing-code → 201 { code, expires_at, installer }; POST …/robots/:id/operators → 201 { operators }; DELETE …/robots/:id/operators/:subject → { operators }.",
  "anyOf": [
    {
      "type": "object",
      "required": [
        "robot",
        "pairing"
      ],
      "properties": {
        "robot": {
          "$ref": "robot.v1.json"
        },
        "pairing": {
          "type": "object",
          "required": [
            "code",
            "expires_at",
            "installer"
          ],
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "expires_at": {
              "type": "string",
              "format": "date-time"
            },
            "installer": {
              "type": "string"
            }
          },
          "description": "A one-time pairing code (shown once), when it expires and the one-line installer command that uses it."
        }
      }
    },
    {
      "type": "object",
      "required": [
        "robot"
      ],
      "properties": {
        "robot": {
          "$ref": "robot.v1.json"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "code",
        "expires_at",
        "installer"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "installer": {
          "type": "string"
        }
      },
      "description": "A one-time pairing code (shown once), when it expires and the one-line installer command that uses it."
    },
    {
      "type": "object",
      "required": [
        "operators"
      ],
      "properties": {
        "operators": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "subject",
              "role"
            ],
            "properties": {
              "subject": {
                "type": "string",
                "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$"
              },
              "role": {
                "enum": [
                  "operator",
                  "viewer"
                ]
              },
              "added_by": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    }
  ]
}
