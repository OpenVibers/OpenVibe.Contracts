{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/bot/device-message.v1.json",
  "title": "BotDeviceMessage",
  "description": "bot.device-message@1 (ADR-043 decision 5): one frame on OpenVibe.Bot's device WebSocket (wss://openvibe.bot/device), JSON with v, seq and ts on every frame. Server to device: hello, config, command, estop, heartbeat_ack, error, paired (after a pair frame), rotate (a Network-paired machine is asked to rotate its credential with Network), voice_answer (Vibe's answer to a voice_ask). Device to server: pair (the only frame an unauthenticated socket may send), status, telemetry, ack, nack, heartbeat, reauth (Network-paired machines), estop_state, voice_ask (what the person asked after the machine's call word). The job frames on the same socket are platform.job-frame@1, not this contract. This duplicates two implementations that must not drift: OpenVibe.Bot server/realtime.js (the sender and reader in Bot) and OpenVibe.Node internal/protocol/protocol.go (the Go structs of the device agent).",
  "oneOf": [
    {
      "description": "Server to device, once authenticated.",
      "type": "object",
      "required": [
        "v",
        "seq",
        "ts",
        "type",
        "session_id",
        "device_id",
        "robot_ids",
        "server_time"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "ts": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "const": "hello"
        },
        "session_id": {
          "type": "string"
        },
        "device_id": {
          "type": "string",
          "pattern": "^dev_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "robot_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^rob_[0-9A-HJKMNP-TV-Z]{26}$"
          }
        },
        "server_time": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    {
      "description": "Server to device: the effective limits (the owner's clamped by the profile's), the kinds the profile takes and the latch; sent again when any of them changes.",
      "type": "object",
      "required": [
        "v",
        "seq",
        "ts",
        "type",
        "heartbeat_ms",
        "limits",
        "allowed_commands",
        "estop_latched"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "ts": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "const": "config"
        },
        "heartbeat_ms": {
          "type": "integer",
          "minimum": 1
        },
        "limits": {
          "type": "object",
          "required": [],
          "additionalProperties": false,
          "properties": {
            "max_speed": {
              "type": "number"
            },
            "max_turn": {
              "type": "number"
            },
            "max_command_ms": {
              "type": "integer",
              "minimum": 1
            },
            "heartbeat_ms": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "allowed_commands": {
          "type": "array",
          "items": {
            "enum": [
              "drive",
              "actuator",
              "ptz",
              "say",
              "display",
              "halt"
            ]
          }
        },
        "estop_latched": {
          "type": "boolean"
        },
        "voice": {
          "type": "boolean",
          "description": "Vibe by voice: the owner turned it on for this machine, so it may listen for its call word and send voice_ask (absent or false: it does not)."
        },
        "call_word": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40,
          "description": "The call word the owner chose (\"hey vibe\" unless they chose another); sent with voice on."
        }
      }
    },
    {
      "description": "Server to device: id is minted by Bot (the device's idempotency key), ref is the operator's own id. Never queued for an offline device, never replayed.",
      "type": "object",
      "required": [
        "v",
        "seq",
        "ts",
        "type",
        "id",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "ts": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "const": "command"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "drive",
            "actuator",
            "ptz",
            "say",
            "display",
            "halt",
            "button",
            "point",
            "exec",
            "fs",
            "screen",
            "probe",
            "input",
            "browser",
            "screen_stream"
          ]
        },
        "value": {
          "type": "object",
          "description": "The command's value. screen_stream (OpenVibe.Node v0.12.0): {action: 'start', whip_url, publish_key, seconds? (30-1800, default 600), fps? (1-5, default 2)} or {action: 'stop'}: the machine's screen shown live on its own private OpenRestream stream. Bot alone fills in whip_url and publish_key (the machine's stream, playback private, never recorded); no operator, agent or service sends this kind."
        },
        "deadline_ms": {
          "type": "integer",
          "description": "Absolute deadline, epoch milliseconds; the device stops the motion at it. For exec, fs, screen and screen_stream it is the reply window."
        },
        "operator": {
          "type": "object",
          "required": [
            "role"
          ],
          "additionalProperties": false,
          "properties": {
            "subject": {
              "type": [
                "string",
                "null"
              ]
            },
            "role": {
              "type": "string"
            }
          }
        },
        "turn_epoch": {
          "type": "integer",
          "minimum": 0,
          "description": "The robot's control epoch when Bot decided this command (Bot#155): it rises each time a queue turn ends, is left or is paused by an owner takeover, and Bot's own halt for that change carries the new value. A device or plugin may refuse a command whose turn_epoch is lower than the newest halt's, defence in depth on top of Bot's own guarantee that nothing decided under a turn is sent after that turn's halt. Milliseconds on Bot's clock, so it keeps rising across Bot restarts. Absent from Bots before 0.213.0 and on robots without a turn queue."
        },
        "robot_id": {
          "type": "string",
          "pattern": "^rob_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "target": {
          "type": "string",
          "description": "OpenVibe.Node only: the driver to send it to."
        }
      }
    },
    {
      "description": "Server to device: the latch moved (true sets it, false is the owner clearing it).",
      "type": "object",
      "required": [
        "v",
        "seq",
        "ts",
        "type",
        "latched"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "ts": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "const": "estop"
        },
        "latched": {
          "type": "boolean"
        },
        "by": {
          "type": [
            "string",
            "null"
          ]
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    {
      "description": "Server to device: echo and t carry the device's t back.",
      "type": "object",
      "required": [
        "v",
        "seq",
        "ts",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "ts": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "const": "heartbeat_ack"
        },
        "t": {
          "type": "integer"
        },
        "echo": {
          "type": [
            "number",
            "null"
          ]
        },
        "server_time": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    {
      "description": "Server to device: a refused frame (bot.not_paired, bot.bad_frame, …).",
      "type": "object",
      "required": [
        "v",
        "seq",
        "ts",
        "type",
        "code"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "ts": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "const": "error"
        },
        "code": {
          "type": "string"
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    {
      "description": "Server to device: the answer to pair; the same fields as POST /api/v1/pair (bot.pair-result@1).",
      "type": "object",
      "required": [
        "v",
        "seq",
        "ts",
        "type",
        "device_id",
        "credential",
        "robot_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "ts": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "const": "paired"
        },
        "device_id": {
          "type": "string",
          "pattern": "^dev_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "credential": {
          "type": "string",
          "minLength": 1,
          "description": "Shown once."
        },
        "publish_key": {
          "type": "string",
          "minLength": 1,
          "description": "Shown once."
        },
        "whip_url": {
          "type": "string",
          "format": "uri",
          "description": "Carries the publish key: shown once."
        },
        "video": {
          "const": "not_configured"
        },
        "robot_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^rob_[0-9A-HJKMNP-TV-Z]{26}$"
          }
        },
        "profile_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "profile": {
          "anyOf": [
            {
              "$ref": "robot-profile.v1.json"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    {
      "description": "Server to device: a Network-paired machine rotates its credential with Network.",
      "type": "object",
      "required": [
        "v",
        "seq",
        "ts",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "ts": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "const": "rotate"
        }
      }
    },
    {
      "description": "Device to server: redeem a one-time code (bot.pair-request@1).",
      "type": "object",
      "required": [
        "v",
        "seq",
        "ts",
        "type",
        "code"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "ts": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "const": "pair"
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "robot": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^rob_[0-9A-HJKMNP-TV-Z]{26}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "agent_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "device_kind": {
          "enum": [
            "onboard",
            "bridge",
            "server"
          ]
        },
        "drivers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "capabilities": {
          "type": "object"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    {
      "description": "Device to server: what the agent runs; OpenVibe.Node sends drivers as objects, older agents as names.",
      "type": "object",
      "required": [
        "v",
        "seq",
        "ts",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "ts": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "const": "status"
        },
        "firmware": {
          "type": "string"
        },
        "capabilities": {
          "type": "object"
        },
        "agent_version": {
          "type": "string",
          "maxLength": 40
        },
        "device_kind": {
          "enum": [
            "onboard",
            "bridge",
            "server"
          ]
        },
        "os": {
          "type": "string"
        },
        "arch": {
          "type": "string"
        },
        "drivers": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "name",
                  "state"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "driver": {
                    "type": "string"
                  },
                  "version": {
                    "type": "string"
                  },
                  "state": {
                    "type": "string"
                  },
                  "capabilities": {
                    "type": "object"
                  }
                }
              }
            ]
          }
        },
        "faults": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "driver": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        },
        "estop_latched": {
          "type": "boolean"
        },
        "local_stop": {
          "type": "boolean"
        },
        "video": {
          "type": "string"
        }
      }
    },
    {
      "description": "Device to server: samples at most 2 Hz; a frame with events is never dropped.",
      "type": "object",
      "required": [
        "v",
        "seq",
        "ts",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "ts": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "const": "telemetry"
        },
        "battery": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "object",
              "required": [],
              "additionalProperties": false,
              "properties": {
                "volts": {
                  "type": "number"
                },
                "percent": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              }
            }
          ]
        },
        "voltage": {
          "type": "number"
        },
        "rssi": {
          "type": "integer"
        },
        "sensors": {
          "type": "object"
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "ts"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "driver": {
                "type": "string"
              },
              "ts": {
                "type": "integer"
              },
              "fields": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    {
      "description": "Device to server: the command ran.",
      "type": "object",
      "required": [
        "v",
        "seq",
        "ts",
        "type",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "ts": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "const": "ack"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0
        },
        "data": {
          "type": "object",
          "description": "OpenVibe.Node: a computer command's answer (exec, fs, screen), at most 512 KB of JSON."
        }
      }
    },
    {
      "description": "Device to server: the command was refused, with OpenVibe.Node's fault code (bad_value, estopped, local_stop, expired, …).",
      "type": "object",
      "required": [
        "v",
        "seq",
        "ts",
        "type",
        "id",
        "fault_code"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "ts": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "const": "nack"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "fault_code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        }
      }
    },
    {
      "description": "Device to server, every heartbeat_ms.",
      "type": "object",
      "required": [
        "v",
        "seq",
        "ts",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "ts": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "const": "heartbeat"
        },
        "t": {
          "type": "integer"
        },
        "rtt_ms": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    {
      "description": "Device to server: a Network-paired machine's fresh node token, before the last one expires.",
      "type": "object",
      "required": [
        "v",
        "seq",
        "ts",
        "type",
        "token"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "ts": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "const": "reauth"
        },
        "token": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    {
      "description": "Device to server: the device's own latch; a device may set the e-stop, never clear the owner's.",
      "type": "object",
      "required": [
        "v",
        "seq",
        "ts",
        "type",
        "latched"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "ts": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "const": "estop_state"
        },
        "latched": {
          "type": "boolean"
        },
        "by": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "robot_id": {
          "type": "string",
          "pattern": "^rob_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "local_stop": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    {
      "description": "Server to device (Vibe by voice): Vibe's answer to a voice_ask, for the machine to speak and show. `working` says Vibe is on it (a longer task), `answered` carries the answer, `refused` says why nothing was done (voice off for the machine, the daily allowance spent, the request refused).",
      "type": "object",
      "required": [
        "v",
        "seq",
        "ts",
        "type",
        "id",
        "state"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "ts": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "const": "voice_answer"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
          "description": "The voice_ask this answers."
        },
        "state": {
          "enum": [
            "working",
            "answered",
            "refused"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 2000,
          "description": "The answer to speak (answered), a short line (working), or why not (refused)."
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "description": "Where the person can read it later: the Vibe chat that keeps the question and the answer."
        }
      }
    },
    {
      "description": "Device to server (Vibe by voice, consumer plan §8): the person said the machine's call word, and this is what they asked after it, transcribed on the machine itself (nothing leaves it before the call word). OpenVibe.Bot hands it to Vibe as the machine's owner, only when the owner turned voice on for the machine (config `voice`), and answers with voice_answer frames carrying the same id.",
      "type": "object",
      "required": [
        "v",
        "seq",
        "ts",
        "type",
        "id",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "ts": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "const": "voice_ask"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
          "description": "The device's id for this request (unique per device for a day); the answers carry it."
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "What the person asked after the call word, as the machine heard it."
        },
        "lang": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8}){0,2}$",
          "description": "The language it was heard in (BCP 47), when the recogniser knows."
        },
        "robot_id": {
          "type": "string",
          "pattern": "^rob_[0-9A-HJKMNP-TV-Z]{26}$",
