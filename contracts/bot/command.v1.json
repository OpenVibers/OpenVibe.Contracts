{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/bot/command.v1.json",
  "title": "BotCommand",
  "description": "bot.command@1: an operator's command frame on OpenVibe.Bot's operator WebSocket (wss://openvibe.bot/control, after join; server/realtime.js onOperatorCommand). id is the operator's idempotency key (at most 64 characters; Bot mints one when it is missing): a repeated id answers with the first result. Bot's gate stamps the robot, the operator and the role, builds the value from the robot profile's commands (clamped by the owner's limits) and sets the deadline; ms asks for a duration within max_command_ms. Answered by one command_result frame (bot.command-result@1). The kinds button (a profile button by name, with an optional state for a hold button) and point (a normalised x, y video click) were added in 0.109.0 (plan T15 R9). The computer kinds (exec, fs, screen, input; OpenVibe.Node's computer plugin, Node docs/computer.md) are taken only for a person's own machine, from its owner or an agent the owner let use it (bot.computer.control); the machine's owner sets on the machine what they may do, and the answer comes back in bot.command-result@1's data. probe (a read-only check of something on the machine's own network) is the one computer kind OpenVibe.Watch may send, for owners who let their watches use the computer. input (added in 0.171.0) moves the mouse, clicks, scrolls, types or presses keys on the machine's screen, at coordinates in the space of the screen picture the caller last saw (its width and height; the Node scales them to the real screen): refused at level observe, approved one by one at ask.",
  "type": "object",
  "required": [
    "type",
    "kind"
  ],
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "ts": {
      "type": "integer",
      "minimum": 0
    },
    "type": {
      "const": "command"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "kind": {
      "enum": [
        "drive",
        "actuator",
        "ptz",
        "say",
        "display",
        "halt",
        "button",
        "point",
        "exec",
        "fs",
        "screen",
        "probe",
        "input"
      ]
    },
    "value": {
      "type": "object"
    },
    "ms": {
      "type": "integer",
      "minimum": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "button"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,31}$",
                "description": "one of the profile's commands.button.names"
              },
              "state": {
                "enum": [
                  "down",
                  "up"
                ],
                "description": "present only for a hold button: down on press, up on release"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "point"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "type": "object",
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "exec"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "type": "object",
            "required": [
              "argv"
            ],
            "additionalProperties": false,
            "properties": {
              "argv": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "description": "a program and its arguments, never a shell line"
              },
              "cwd": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "description": "an absolute folder on the machine (default: its first allowed folder)"
              },
              "timeout_s": {
                "type": "integer",
                "minimum": 1,
                "maximum": 600,
                "description": "capped by the owner's timeout_s on the machine"
              },
              "stdin": {
                "type": "string",
                "maxLength": 65536
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "fs"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "type": "object",
            "required": [
              "op",
              "path"
            ],
            "additionalProperties": false,
            "properties": {
              "op": {
                "enum": [
                  "list",
                  "stat",
                  "read",
                  "write",
                  "mkdir"
                ]
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "description": "absolute, on the machine"
              },
              "offset": {
                "type": "integer",
                "minimum": 0
              },
              "length": {
                "type": "integer",
                "minimum": 0,
                "maximum": 262144
              },
              "content_b64": {
                "type": "string",
                "maxLength": 349528,
                "description": "write: at most 256 KB of content, base64"
              },
              "mode": {
                "enum": [
                  "create",
                  "overwrite",
                  "append"
                ],
                "description": "write: create (default) never replaces a file"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "screen"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "max_width": {
                "type": "integer",
                "minimum": 320,
                "maximum": 3840
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "probe"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "type": "object",
            "required": [
              "target"
            ],
            "additionalProperties": false,
            "properties": {
              "target": {
                "type": "string",
                "minLength": 8,
                "maxLength": 2048,
                "pattern": "^(https?|tcp)://",
                "description": "http(s)://host[:port]/path (one GET, no redirect followed) or tcp://host:port (does it accept a connection); on the machine's own network only: a private, loopback or link-local address"
              },
              "timeout_s": {
                "type": "integer",
                "minimum": 1,
                "maximum": 30
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "input"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "type": "object",
            "required": [
              "action"
            ],
            "additionalProperties": false,
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "move",
                  "click",
                  "double_click",
                  "right_click",
                  "scroll",
                  "type",
                  "key"
                ],
                "description": "move, click, double_click and right_click take x and y; scroll takes dy (and x, y to scroll at a point); type takes text; key takes keys"
              },
              "x": {
                "type": "integer",
                "minimum": 0,
                "maximum": 16384
              },
              "y": {
                "type": "integer",
                "minimum": 0,
                "maximum": 16384
              },
              "width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16384,
                "description": "the width of the picture x is measured in (the screen kind's answer); without it x is in screen pixels"
              },
              "height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16384,
                "description": "the height of the picture y is measured in"
              },
              "dy": {
                "type": "integer",
                "minimum": -20,
                "maximum": 20,
                "description": "scroll clicks: negative scrolls up, positive down"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "description": "typed as keystrokes into whatever has focus"
              },
              "keys": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_+\\-]+$",
                "description": "one key or chord, for example Return, Escape, ctrl+s, alt+Tab"
              }
            }
          }
        }
      }
    }
  ]
}
