{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/bot/command.v1.json",
  "title": "BotCommand",
  "description": "bot.command@1: an operator's command frame on OpenVibe.Bot's operator WebSocket (wss://openvibe.bot/control, after join; server/realtime.js onOperatorCommand). id is the operator's idempotency key (at most 64 characters; Bot mints one when it is missing): a repeated id answers with the first result. Bot's gate stamps the robot, the operator and the role, builds the value from the robot profile's commands (clamped by the owner's limits) and sets the deadline; ms asks for a duration within max_command_ms. Answered by one command_result frame (bot.command-result@1). The kinds button (a profile button by name, with an optional state for a hold button) and point (a normalised x, y video click) were added in 0.109.0 (plan T15 R9). The computer kinds (exec, fs, screen; OpenVibe.Node's computer plugin, Node docs/computer.md) are taken only for a person's own machine, from its owner or an agent the owner let use it (bot.computer.control); the machine's owner sets on the machine what they may do, and the answer comes back in bot.command-result@1's data.",
  "type": "object",
  "required": [
    "type",
    "kind"
  ],
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "ts": {
      "type": "integer",
      "minimum": 0
    },
    "type": {
      "const": "command"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "kind": {
      "enum": [
        "drive",
        "actuator",
        "ptz",
        "say",
        "display",
        "halt",
        "button",
        "point",
        "exec",
        "fs",
        "screen"
      ]
    },
    "value": {
      "type": "object"
    },
    "ms": {
      "type": "integer",
      "minimum": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "button"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,31}$",
                "description": "one of the profile's commands.button.names"
              },
              "state": {
                "enum": [
                  "down",
                  "up"
                ],
                "description": "present only for a hold button: down on press, up on release"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "point"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "type": "object",
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "exec"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "type": "object",
            "required": [
              "argv"
            ],
            "additionalProperties": false,
            "properties": {
              "argv": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "description": "a program and its arguments, never a shell line"
              },
              "cwd": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "description": "an absolute folder on the machine (default: its first allowed folder)"
              },
              "timeout_s": {
                "type": "integer",
                "minimum": 1,
                "maximum": 600,
                "description": "capped by the owner's timeout_s on the machine"
              },
              "stdin": {
                "type": "string",
                "maxLength": 65536
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "fs"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "type": "object",
            "required": [
              "op",
              "path"
            ],
            "additionalProperties": false,
            "properties": {
              "op": {
                "enum": [
                  "list",
                  "stat",
                  "read",
                  "write",
                  "mkdir"
                ]
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "description": "absolute, on the machine"
              },
              "offset": {
                "type": "integer",
                "minimum": 0
              },
              "length": {
                "type": "integer",
                "minimum": 0,
                "maximum": 262144
              },
              "content_b64": {
                "type": "string",
                "maxLength": 349528,
                "description": "write: at most 256 KB of content, base64"
              },
              "mode": {
                "enum": [
                  "create",
                  "overwrite",
                  "append"
                ],
                "description": "write: create (default) never replaces a file"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "screen"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "max_width": {
                "type": "integer",
                "minimum": 320,
                "maximum": 3840
              }
            }
          }
        }
      }
    }
  ]
}
