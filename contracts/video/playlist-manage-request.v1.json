{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/video/playlist-manage-request.v1.json",
  "title": "VideoPlaylistManageRequest",
  "description": "video.playlist-manage-request@1: bodies of video.playlist.manage on openvibe.video. POST /api/v1/video/playlists { title, description?, visibility? } creates one (default private; 422 playlist.invalid_title over 120 characters, playlist.invalid_description over 2,000, playlist.invalid_visibility, playlist.limit at 100 per owner). PATCH /api/v1/video/playlists/:id { title?, description?, visibility? }. POST /api/v1/video/playlists/:id/items { kind, id } adds one (409 playlist.item_duplicate; 422 playlist.invalid_kind, playlist.invalid_item, playlist.items_limit at 500). PATCH /api/v1/video/playlists/:id/items { items: [{ kind, id }, ...] } reorders: the full list, each item once (422 playlist.invalid_items). DELETE /api/v1/video/playlists/:id and /items/:kind/:itemId take no body. Another owner's playlist answers 404 playlist.not_found.",
  "anyOf": [
    {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "visibility": {
          "enum": [
            "public",
            "unlisted",
            "private"
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "vod",
            "clip"
          ],
          "description": "An OpenVibe.Live recording (vod) or clip."
        },
        "id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "description": "The item's OpenVibe.Live id."
            },
            {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,15}$"
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "required": [
              "kind",
              "id"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "vod",
                  "clip"
                ],
                "description": "An OpenVibe.Live recording (vod) or clip."
              },
              "id": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "description": "The item's OpenVibe.Live id."
                  },
                  {
                    "type": "string",
                    "pattern": "^[1-9][0-9]{0,15}$"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
