{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/video/playlist-manage-result.v1.json",
  "title": "VideoPlaylistManageResult",
  "description": "video.playlist-manage-result@1: { playlist } after a create (201, Location) or an edit, { item } after an add (201), { items } after a reorder; a delete answers 204 with no body.",
  "anyOf": [
    {
      "type": "object",
      "required": [
        "playlist"
      ],
      "properties": {
        "playlist": {
          "$ref": "playlist.v1.json"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "item"
      ],
      "properties": {
        "item": {
          "type": "object",
          "required": [
            "kind",
            "id",
            "position",
            "added_at"
          ],
          "properties": {
            "kind": {
              "enum": [
                "vod",
                "clip"
              ],
              "description": "An OpenVibe.Live recording (vod) or clip."
            },
            "id": {
              "type": "integer",
              "minimum": 1,
              "description": "The item's OpenVibe.Live id."
            },
            "position": {
              "type": "integer",
              "minimum": 0
            },
            "added_at": {
              "type": "string",
              "description": "ISO 8601 time."
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "id",
              "position",
              "added_at"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "vod",
                  "clip"
                ],
                "description": "An OpenVibe.Live recording (vod) or clip."
              },
              "id": {
                "type": "integer",
                "minimum": 1,
                "description": "The item's OpenVibe.Live id."
              },
              "position": {
                "type": "integer",
                "minimum": 0
              },
              "added_at": {
                "type": "string",
                "description": "ISO 8601 time."
              }
            }
          }
        }
      }
    }
  ]
}
