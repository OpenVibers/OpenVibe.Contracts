{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/reviews/item.v1.json",
  "title": "ReviewsItem",
  "description": "reviews.item@1: one OpenVibe.Sources item as OpenVibe.Reviews read it (server/reviews/service.js itemView): only the signal fields and provenance (never review text), its state upstream, and how it was resolved to an entity (resolved by a rule or an editor, ambiguous with candidates, unmatched, or ignored), with its active signal.",
  "type": "object",
  "required": [
    "id",
    "source_key",
    "kind",
    "identity",
    "canonical_url",
    "title",
    "item_revision",
    "published_at",
    "retrieved_at",
    "license_note",
    "terms_note",
    "fields",
    "state",
    "removed_at",
    "removed_reason",
    "resolution",
    "entity_id",
    "resolution_rule",
    "candidates",
    "signal_note",
    "signal"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^itm_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "source_key": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "identity": {
      "type": "string"
    },
    "canonical_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "item_revision": {
      "type": "integer",
      "minimum": 1
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "retrieved_at": {
      "type": "string"
    },
    "license_note": {
      "type": [
        "string",
        "null"
      ]
    },
    "terms_note": {
      "type": [
        "string",
        "null"
      ]
    },
    "fields": {
      "type": "object",
      "description": "The fields Reviews keeps from the item (identifiers and signal values)."
    },
    "state": {
      "enum": [
        "active",
        "removed"
      ]
    },
    "removed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "removed_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "resolution": {
      "enum": [
        "resolved",
        "ambiguous",
        "unmatched",
        "ignored"
      ]
    },
    "entity_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "resolution_rule": {
      "type": [
        "string",
        "null"
      ],
      "description": "source, url, gtin, sku, mpn, external (joined with + when several agree), conflicting_identifiers, name_only or editor."
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "entity_id",
          "rule",
          "entity"
        ],
        "properties": {
          "entity_id": {
            "type": "string"
          },
          "rule": {
            "type": "string"
          },
          "entity": {
            "anyOf": [
              {
                "$ref": "entity.v1.json"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "signal_note": {
      "type": [
        "string",
        "null"
      ],
      "description": "Why the item does or does not state a signal."
    },
    "signal": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "signal_id",
        "entity_id",
        "canonical_entity_id",
        "type",
        "source_key",
        "source_item_id",
        "item_revision",
        "observed_at",
        "source_published_at",
        "canonical_url",
        "license_note"
      ],
      "description": "The item's active signal, or null.",
      "properties": {
        "signal_id": {
          "type": "string",
          "pattern": "^sig_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "entity_id": {
          "type": "string",
          "pattern": "^ent_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "canonical_entity_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^ent_[0-9A-HJKMNP-TV-Z]{26}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "enum": [
            "recommendation",
            "recommendation_tally",
            "rating",
            "rating_aggregate"
          ]
        },
        "source_key": {
          "type": "string"
        },
        "source_item_id": {
          "type": "string",
          "pattern": "^itm_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "item_revision": {
          "type": "integer",
          "minimum": 1
        },
        "observed_at": {
          "type": "string",
          "description": "When Reviews retrieved the item revision the signal came from."
        },
        "source_published_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "canonical_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "license_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "recommended": {
          "type": "boolean",
          "description": "recommendation signals."
        },
        "positive_count": {
          "type": "integer",
          "minimum": 0,
          "description": "recommendation_tally signals."
        },
        "total_count": {
          "type": "integer",
          "minimum": 0
        },
        "rating_value": {
          "type": "number",
          "description": "rating and rating_aggregate signals, on the scale the source states."
        },
        "rating_best": {
          "type": [
            "number",
            "null"
          ]
        },
        "rating_worst": {
          "type": [
            "number",
            "null"
          ]
        },
        "rating_count": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    }
  }
}
