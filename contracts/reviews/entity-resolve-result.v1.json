        },
        "signals": {
          "type": "array",
          "items": {
            "$ref": "signal.v1.json"
          }
        },
        "audit": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "at",
              "action",
              "target",
              "actor",
              "detail"
            ],
            "properties": {
              "id": {
                "type": "integer"
              },
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "action": {
                "type": "string"
              },
              "target": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "actor": {
                "type": "string",
                "description": "Readers see \"an editor\" for a person."
              },
              "detail": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "entity_id",
        "aggregate",
        "aggregate_revision"
      ],
      "properties": {
        "entity_id": {
          "type": "string",
          "pattern": "^ent_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "aggregate": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "revision",
                "computed_at",
                "trigger",
                "result"
              ],
              "description": "One immutable aggregate revision: a pure function of the live signals and the editors' trust decisions.",
              "properties": {
                "revision": {
                  "type": "integer",
                  "minimum": 1
                },
                "computed_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "trigger": {
                  "type": "string"
                },
                "result": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "required": [
                    "method",
                    "components",
                    "inputs",
                    "excluded",
                    "sources",
                    "observed",
                    "computation"
                  ],
                  "description": "null once no qualifying signal is left.",
                  "properties": {
                    "method": {
                      "type": "string",
                      "description": "reviews-aggregate@1"
                    },
                    "components": {
                      "type": "object",
                      "properties": {
                        "recommendation": {
                          "type": "object",
                          "required": [
                            "positive",
                            "total",
                            "percent",
                            "inputs"
                          ],
                          "properties": {
                            "positive": {
                              "type": "integer"
                            },
                            "total": {
                              "type": "integer"
                            },
                            "percent": {
                              "type": "number"
                            },
                            "inputs": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "pattern": "^sig_[0-9A-HJKMNP-TV-Z]{26}$"
                              }
                            }
                          }
                        },
                        "rating": {
                          "type": "object",
                          "required": [
                            "count",
                            "percent",
                            "inputs"
                          ],
                          "properties": {
                            "count": {
                              "type": "integer"
                            },
                            "percent": {
                              "type": "number"
                            },
                            "inputs": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "pattern": "^sig_[0-9A-HJKMNP-TV-Z]{26}$"
                              }
                            },
                            "on_scale": {
                              "type": "object",
                              "required": [
                                "value",
                                "best"
                              ],
                              "properties": {
                                "value": {
                                  "type": "number"
                                },
                                "best": {
                                  "type": "number"
                                },
                                "worst": {
                                  "type": "number"
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    "inputs": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "description": "Each signal that entered: signal_id, type, source_key, source_item_id, entity_id, observed_at, its values and weight."
                      }
                    },
                    "excluded": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "signal_id",
                          "reason",
                          "note"
                        ],
                        "properties": {
                          "signal_id": {
                            "type": "string",
                            "pattern": "^sig_[0-9A-HJKMNP-TV-Z]{26}$"
                          },
                          "reason": {
                            "type": "string",
                            "description": "source_excluded_by_editor, signal_excluded_by_editor, scale_not_stated, no_count, older_tally_same_source, covered_by_source_tally"
                          },
                          "note": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        }
                      }
                    },
                    "sources": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "observed": {
                      "type": "object",
                      "required": [
                        "earliest",
                        "latest"
                      ],
                      "properties": {
                        "earliest": {
                          "type": "string"
                        },
                        "latest": {
                          "type": "string"
                        }
                      }
                    },
                    "computation": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "The computation in words, one line per component."
                    }
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "aggregate_revision": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "revision"
      ],
      "properties": {
        "revision": {
          "$ref": "summary-revision.v1.json"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "item.v1.json"
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "item"
      ],
      "properties": {
        "item": {
          "$ref": "item.v1.json"
        },
        "signal": {
          "anyOf": [
            {
              "$ref": "signal.v1.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "settled_items": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  ]
}
