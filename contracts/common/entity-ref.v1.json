{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/common/entity-ref.v1.json",
  "title": "EntityRef",
  "description": "Typed reference to another service's entity. Store this instead of a foreign key; resolve a display projection from the owner.",
  "type": "object",
  "required": ["service", "type", "id"],
  "additionalProperties": false,
  "properties": {
    "service": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,39}$" },
    "type": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,39}$" },
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "revision": { "type": "integer", "minimum": 0 },
    "label": { "type": "string", "maxLength": 200, "description": "Cached display label. Never authoritative." }
  }
}
