{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/connect/policy.v1.json",
  "title": "ConnectPolicy",
  "description": "connect.policy@1: the grants, routes and exit-node settings of one private Connect tenant. It is deliberately tenant-scoped: a rule never names a device, person or tag from another tenant, and default_action is deny unless the owner opens a path. It describes intent, not the control plane's internal ACL file or keys.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "owner",
    "tenant",
    "version",
    "rules",
    "default_action",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^pol_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "owner": {
      "$ref": "../identity/subject-ref.v1.json"
    },
    "project_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^prj_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "tenant": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id"
          ],
          "properties": {
            "type": {
              "const": "user"
            },
            "id": {
              "type": "string",
              "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$"
            }
          },
          "description": "A person's own private network."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id"
          ],
          "properties": {
            "type": {
              "const": "project"
            },
            "id": {
              "type": "string",
              "pattern": "^prj_[0-9A-HJKMNP-TV-Z]{26}$"
            }
          },
          "description": "A project's private network."
        }
      ],
      "description": "The one tenant this policy can affect; a rule or route naming another tenant's id is invalid."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Bumped on every change; a device keeps the version it last applied."
    },
    "default_action": {
      "enum": [
        "allow",
        "deny"
      ],
      "description": "deny unless the owner explicitly opens a path."
    },
    "rules": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "sources",
          "destinations"
        ],
        "properties": {
          "action": {
            "enum": [
              "allow",
              "deny"
            ]
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "$ref": "#/$defs/selector"
            }
          },
          "destinations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "$ref": "#/$defs/selector"
            }
          },
          "ports": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/$defs/port"
            },
            "description": "TCP/UDP ports or ranges; omit for all ports."
          },
          "description": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "exit_node": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "device_ids": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^dev_[0-9A-HJKMNP-TV-Z]{26}$"
          }
        }
      },
      "required": [
        "enabled",
        "device_ids"
      ],
      "description": "Exit nodes are usable only by this tenant's devices; no public share may target one."
    },
    "subnet_routes": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "device_id",
          "cidr"
        ],
        "properties": {
          "device_id": {
            "type": "string",
            "pattern": "^dev_[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "cidr": {
            "type": "string",
            "minLength": 2,
            "maxLength": 64
          }
        }
      }
    },
    "updated_by": {
      "$ref": "../identity/subject-ref.v1.json"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "selector": {
      "type": "string",
      "pattern": "^(?:\\*|(?:user|device|tag|project):[A-Za-z0-9_.:-]+)$",
      "description": "*, or user:<usr_\u2026>, device:<dev_\u2026>, tag:<name> or project:<prj_\u2026>; all within this tenant."
    },
    "port": {
      "type": "string",
      "pattern": "^(?:\\*|[0-9]{1,5}(?:-[0-9]{1,5})?)$",
      "description": "* for any port, 443, or a range such as 8000-8100."
    }
  }
}
