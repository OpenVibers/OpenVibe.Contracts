{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/openre/stream.v1.json",
  "title": "OpenreStream",
  "description": "openre.stream@1: one stream definition as OpenRe.Stream's API shows it (server/api/v1.js publicDefinition): the owner's stream with its protocols, recording and playback settings, ingest endpoints, key metadata (hints only, never a key) and the open session if any.",
  "type": "object",
  "required": [
    "id",
    "title",
    "owner",
    "protocols",
    "recording_mode",
    "state",
    "revision",
    "ingest",
    "keys",
    "session",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "maxLength": 140
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "owner": {
      "$ref": "../identity/subject-ref.v1.json"
    },
    "protocols": {
      "type": "array",
      "items": {
        "enum": [
          "rtmp",
          "whip",
          "webrtc",
          "jsmpeg"
        ]
      }
    },
    "recording_mode": {
      "enum": [
        "vod",
        "clips",
        "none"
      ]
    },
    "recording_visibility": {
      "enum": [
        "public",
        "unlisted",
        "private"
      ]
    },
    "playback_visibility": {
      "enum": [
        "public",
        "unlisted",
        "private"
      ]
    },
    "mirror_to_live": {
      "type": [
        "integer",
        "boolean"
      ]
    },
    "state": {
      "enum": [
        "active",
        "disabled",
        "archived"
      ]
    },
    "revision": {
      "type": "integer"
    },
    "external_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "service",
          "type",
          "id"
        ],
        "properties": {
          "service": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "id": {
            "type": [
              "string",
              "integer"
            ]
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "ingest": {
      "type": "object",
      "description": "Where an encoder publishes (never the key).",
      "properties": {
        "rtmp": {
          "type": "object",
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "type": "string"
            },
            "key_hint": {
              "type": [
                "string",
                "null"
              ]
            },
            "key_id": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "keys": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "hint",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "status": {
            "enum": [
              "active",
              "grace",
              "revoked"
            ]
          },
          "grace_until": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "created_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "last_used_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      }
    },
    "session": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "protocol": {
          "type": "string"
        },
        "live_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
