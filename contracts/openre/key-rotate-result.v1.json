{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/openre/key-rotate-result.v1.json",
  "title": "OpenreKeyRotateResult",
  "description": "openre.key-rotate-result@1: the answer of POST /api/v1/streams/:id/keys/rotate on OpenRe.Stream: the new key (shown once, Cache-Control no-store), the keys it retired (grace or revoked), when the grace ends, how many sessions were asked to end, and the ingest endpoints. openre.key.rotated is announced.",
  "type": "object",
  "required": [
    "key",
    "retired",
    "grace_until",
    "sessions_ending",
    "ingest"
  ],
  "properties": {
    "key": {
      "type": "object",
      "required": [
        "id",
        "key",
        "hint",
        "shown_once"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "key": {
          "type": "string",
          "description": "The plain ingest key: only in this answer."
        },
        "hint": {
          "type": "string"
        },
        "shown_once": {
          "const": true
        }
      }
    },
    "retired": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "status": {
            "enum": [
              "grace",
              "revoked"
            ]
          }
        }
      }
    },
    "grace_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "sessions_ending": {
      "type": "integer",
      "minimum": 0
    },
    "ingest": {
      "type": "object",
      "description": "Where an encoder publishes (never the key).",
      "properties": {
        "rtmp": {
          "type": "object",
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "type": "string"
            },
            "key_hint": {
              "type": [
                "string",
                "null"
              ]
            },
            "key_id": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    }
  }
}
