{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvibe.network/contracts/vision/moments-request.v1.json",
  "title": "VisionMomentsRequest",
  "description": "vision.moments-request@1: the body of POST /api/v1/moments. Up to 30 timestamped frames are compared with CLIP prompt embeddings; a histogram jump marks a scene change. VOD and stream chapters come from this.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "frames"
  ],
  "properties": {
    "frames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "timestamp_ms"
        ],
        "properties": {
          "timestamp_ms": {
            "type": "integer",
            "minimum": 0
          },
          "image": {
            "type": "string",
            "pattern": "^data:image/"
          },
          "image_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          }
        },
        "anyOf": [
          {
            "required": [
              "image"
            ]
          },
          {
            "required": [
              "image_url"
            ]
          }
        ]
      }
    },
    "prompts": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 120
      },
      "maxItems": 10
    }
  }
}
