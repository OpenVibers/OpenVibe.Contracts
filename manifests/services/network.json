{
  "version": "0.3.0",
  "contractRanges": {
    "openvibe-contracts": ">=0.2.0 <1.0.0"
  },
  "id": "network",
  "name": "OpenVibe.Network",
  "status": "stable",
  "repository": "OpenVibers/OpenVibe.Network",
  "domains": [
    "openvibe.network",
    "auth.openvibe.network",
    "api.openvibe.network",
    "admin.openvibe.network",
    "my.openvibe.network",
    "themes.openvibe.network"
  ],
  "publicOrigin": "https://openvibe.network",
  "health": "/api/health",
  "ready": "/api/ready",
  "internalOrigin": "http://127.0.0.1:4000",
  "exposure": {
    "state": "live",
    "publicSite": "service"
  },
  "site": {
    "name": "Network",
    "icon": "network",
    "tagline": "Account and themes",
    "what": "The account behind every site: one sign-in, themes, notifications, history and linked services.",
    "legalProfile": "account",
    "position": 5
  },
  "capabilities": [
    "identity.subject.resolve",
    "mods.grant.manage",
    "network.coins.credit",
    "network.coins.debit",
    "network.coins.transfer",
    "network.integration.github.read",
    "network.modules.read",
    "network.modules.write",
    "network.notifications.push",
    "network.project.manage",
    "network.project.read"
  ],
  "eventsProduced": [
    "network.app.created",
    "network.app.revoked",
    "network.credential.revoked",
    "network.credential.rotated",
    "network.grant.changed",
    "network.module.updated",
    "network.user.token_valid_after",
    "network.user.updated"
  ],
  "eventsConsumed": [
    "billing.staff.action",
    "chat.moderation.action",
    "community.moderation.action",
    "deals.watch.matched",
    "live.moderation.action",
    "live.stream.started",
    "tips.interaction.moderated",
    "trade.alert.triggered"
  ],
  "namespacesOwned": [
    "identity.*",
    "network.*",
    "theme.*",
    "notification.*"
  ]
}
