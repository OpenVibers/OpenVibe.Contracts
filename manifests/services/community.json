{
  "version": "0.2.0",
  "contractRanges": {
    "openvibe-contracts": ">=0.5.0 <1.0.0"
  },
  "id": "community",
  "name": "OpenVibe.Community",
  "status": "alpha",
  "repository": "OpenVibers/OpenVibe.Community",
  "domains": [
    "openvibe.community"
  ],
  "publicOrigin": "https://openvibe.community",
  "health": "/api/health",
  "capabilities": [
    "community.paste.create",
    "community.paste.write",
    "community.paste.moderate",
    "community.post.create",
    "community.comment.write",
    "community.comment.moderate",
    "community.pulse.write",
    "community.space.read",
    "community.space.manage",
    "community.thread.read",
    "community.vote.set",
    "community.pulse.read"
  ],
  "eventsProduced": [
    "community.comment.created",
    "community.index_document.deleted",
    "community.index_document.upserted",
    "community.moderation.action",
    "community.paste.created",
    "community.paste.deleted",
    "community.paste.updated",
    "community.post.created",
    "community.thread.created"
  ],
  "eventsConsumed": [
    "network.block.changed",
    "network.user.token_valid_after"
  ],
  "namespacesOwned": [
    "community.*"
  ],
  "ready": "/api/ready",
  "internalOrigin": "http://127.0.0.1:4200",
  "exposure": {
    "state": "live",
    "publicSite": "service"
  },
  "site": {
    "name": "Community",
    "icon": "community",
    "tagline": "Pastes and posts",
    "what": "Share text and code with a link, comment, and follow what people on OpenVibe are making.",
    "legalProfile": "ugc",
    "position": 2
  }
}
