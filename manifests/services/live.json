{
  "version": "0.1.0",
  "contractRanges": {
    "openvibe-contracts": ">=0.2.0 <1.0.0"
  },
  "id": "live",
  "name": "OpenVibe.Live",
  "status": "stable",
  "repository": "OpenVibers/OpenVibe.Live",
  "domains": [
    "openvibe.live",
    "ingest.openvibe.live"
  ],
  "publicOrigin": "https://openvibe.live",
  "health": "/api/health",
  "ready": "/api/ready",
  "internalOrigin": "http://127.0.0.1:3000",
  "exposure": {
    "state": "live",
    "publicSite": "service"
  },
  "site": {
    "name": "Live",
    "icon": "live",
    "tagline": "Streams, clips and chat",
    "what": "Live streaming from a browser, OBS or a phone, with restreaming, clips, VODs, chat games and channel points.",
    "legalProfile": "streaming",
    "position": 0
  },
  "capabilities": [
    "live.chat_context.read",
    "live.chat_effects.write",
    "live.chat_mirror.write",
    "live.follower.read",
    "live.lineage.resolve",
    "live.tips_delivery.write",
    "live.channel.read",
    "live.stream.read",
    "live.discovery.read",
    "live.owner.resolve"
  ],
  "eventsProduced": [
    "live.stream.started",
    "live.stream.ended",
    "live.release.deployed"
  ],
  "eventsConsumed": [
    "media.clip.*",
    "media.storage.*",
    "media.vod.*",
    "network.user.token_valid_after",
    "network.user.updated",
    "openre.session.*"
  ],
  "namespacesOwned": [
    "live.*"
  ],
  "notes": "Still hosts chat, ingest, money and AI authorities until Waves 6-13; paste authority moved to Community (W5)."
}
