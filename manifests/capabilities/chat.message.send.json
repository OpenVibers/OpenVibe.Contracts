{
  "id": "chat.message.send",
  "version": "1.0",
  "owner": "chat",
  "status": "active",
  "visibility": "first-party",
  "sensitive": true,
  "description": "Send a chat message to a room the actor is a member of (browsers over the chat socket; first-party services over Chat's service API).",
  "permissions": [
    "chat:write"
  ],
  "resourceConstraints": [
    "room_member"
  ],
  "quotaClass": "chat-send",
  "events": [
    "chat.message.created"
  ],
  "implementedBy": [
    "WS /ws/chat {type:\"chat\"}",
    "POST /internal/live/calls",
    "POST /internal/chat/messages"
  ],
  "inputSchema": "chat.send-request@1",
  "outputSchema": "chat.send-result@1"
}
