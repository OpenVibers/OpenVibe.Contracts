{
  "id": "community.thread.read",
  "version": "1.0",
  "owner": "community",
  "status": "active",
  "visibility": "public",
  "description": "Read a space's threads (hot, new or top, paged) and one thread with its posts, plus the RSS feeds. Community checks space visibility and the VIP gate (403 vip.members_only). Creating threads and replies stays community.post.create.",
  "outputSchema": "common.entity-ref@1",
  "permissions": [
    "community:read"
  ],
  "resourceConstraints": [
    "space_member"
  ],
  "quotaClass": "community-read",
  "events": [],
  "implementedBy": [
    "GET /api/v1/spaces/:space/threads",
    "GET /api/v1/spaces/:space/threads/:slug",
    "GET /s/:space",
    "GET /s/:space/t/:slug",
    "GET /s/feed.xml",
    "GET /s/:space/feed.xml"
  ],
  "inputSchema": "common.no-body@1"
}
