{
  "id": "actor.agent.manage",
  "version": "1.0",
  "owner": "actor",
  "status": "active",
  "visibility": "public",
  "sensitive": true,
  "description": "Keep your personal agents on OpenVibe.Actor: create, read, change and delete an agent (standing instructions, mode, a budget per run, a daily run cap and a schedule), and read, add, edit and delete what it remembers, or forget everything. A person's agents are theirs alone; another person's agent is 404.",
  "inputSchema": "actor.agent-manage-request@1",
  "outputSchema": "actor.agent-manage-result@1",
  "permissions": [
    "actor:agents:manage"
  ],
  "resourceConstraints": [
    "owner"
  ],
  "quotaClass": "actor-task",
  "events": [],
  "implementedBy": [
    "GET /api/v1/me/agents",
    "POST /api/v1/me/agents",
    "GET /api/v1/me/agents/:id",
    "PATCH /api/v1/me/agents/:id",
    "DELETE /api/v1/me/agents/:id",
    "GET /api/v1/me/agents/:id/memory",
    "POST /api/v1/me/agents/:id/memory",
    "PATCH /api/v1/me/agents/:id/memory/:mem",
    "DELETE /api/v1/me/agents/:id/memory/:mem",
    "DELETE /api/v1/me/agents/:id/memory"
  ]
}
