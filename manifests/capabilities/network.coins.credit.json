{
  "id": "network.coins.credit",
  "version": "1.0",
  "owner": "network",
  "status": "active",
  "visibility": "internal",
  "description": "Credit OpenCoins (loyalty, never money) to a Network user. Idempotent by idempotency_key. A token may only act for its own app_id.",
  "permissions": [
    "coins:write"
  ],
  "resourceConstraints": [
    "owner"
  ],
  "quotaClass": "ledger-write",
  "events": [],
  "implementedBy": [
    "POST /internal/coins/credit"
  ],
  "inputSchema": "network.coins-change-request@1",
  "outputSchema": "network.coins-balance-result@1"
}
