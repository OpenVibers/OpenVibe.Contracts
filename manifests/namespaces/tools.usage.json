{
  "namespace": "tools.usage",
  "owner": "tools",
  "version": 2,
  "description": "Recently used tools and favourite tools, for the Tools launcher and my.openvibe.network. Tools writes recent; the person or Tools writes favorites.",
  "writers": [
    "owner",
    "user"
  ],
  "publicFields": [],
  "quotaBytes": 8192,
  "onOwnerRemoved": "delete-after-retention",
  "retentionDays": 90,
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "recent": {
        "type": "array",
        "maxItems": 30,
        "items": {
          "type": "object",
          "required": [
            "tool"
          ],
          "additionalProperties": false,
          "properties": {
            "tool": {
              "type": "string",
              "maxLength": 80
            },
            "at": {
              "type": "string"
            }
          }
        }
      },
      "favorites": {
        "type": "array",
        "maxItems": 24,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
        }
      }
    }
  },
  "migration": "v2 adds favorites; every v1 record is a valid v2 record.",
  "migrations": [
    {
      "from": 1,
      "to": 2
    }
  ]
}
