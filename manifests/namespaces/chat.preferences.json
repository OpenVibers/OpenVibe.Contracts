{
  "namespace": "chat.preferences",
  "owner": "chat",
  "version": 1,
  "description": "How chat looks for this person on every site with OpenVibe chat: timestamps, compact messages, text size, badges and emotes.",
  "writers": [
    "owner",
    "user"
  ],
  "publicFields": [],
  "quotaBytes": 4096,
  "onOwnerRemoved": "retain-readonly",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "timestamps": {
        "type": "boolean"
      },
      "compact": {
        "type": "boolean"
      },
      "font_scale": {
        "type": "number",
        "minimum": 0.75,
        "maximum": 2
      },
      "show_badges": {
        "type": "boolean"
      },
      "hide_emotes": {
        "type": "boolean"
      }
    }
  }
}
