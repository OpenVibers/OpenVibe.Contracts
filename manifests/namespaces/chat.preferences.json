{
  "namespace": "chat.preferences",
  "owner": "chat",
  "version": 1,
  "description": "Portable chat display preferences. OpenVibe.Chat owns it since the Wave 6 cutover (2026-09-23): Chat reads and writes the signed-in person's record (GET/PUT /api/chat/preferences) with its service token; Live may still read it.",
  "writers": [
    "owner",
    "user"
  ],
  "publicFields": [],
  "quotaBytes": 4096,
  "onOwnerRemoved": "retain-readonly",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "timestamps": {
        "type": "boolean"
      },
      "compact": {
        "type": "boolean"
      },
      "font_scale": {
        "type": "number",
        "minimum": 0.75,
        "maximum": 2
      },
      "show_badges": {
        "type": "boolean"
      },
      "hide_emotes": {
        "type": "boolean"
      }
    }
  }
}
