{
  "namespace": "games.progress.summary",
  "owner": "games",
  "version": 1,
  "description": "A public summary of this person's game progress: level, playtime and the world they last played. Their characters and inventory stay in OpenVibe.Games.",
  "writers": [
    "owner"
  ],
  "publicFields": [
    "level",
    "achievements",
    "playtime_hours"
  ],
  "quotaBytes": 4096,
  "onOwnerRemoved": "retain-readonly",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "level": {
        "type": "integer",
        "minimum": 0
      },
      "achievements": {
        "type": "integer",
        "minimum": 0
      },
      "playtime_hours": {
        "type": "number",
        "minimum": 0
      },
      "last_world": {
        "type": "string",
        "maxLength": 120
      }
    }
  }
}
