{
  "namespace": "ai.preferences",
  "owner": "network",
  "version": 1,
  "description": "How this person wants OpenVibe AI to write for them: style, length and perspective, whether it may personalise, and whether it keeps what they ask.",
  "writers": [
    "owner",
    "user"
  ],
  "publicFields": [],
  "quotaBytes": 2048,
  "onOwnerRemoved": "retain-readonly",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "style": {
        "enum": [
          "neutral",
          "casual",
          "formal"
        ]
      },
      "length": {
        "enum": [
          "short",
          "medium",
          "long"
        ]
      },
      "perspective": {
        "type": "string",
        "maxLength": 80
      },
      "personalization": {
        "type": "boolean"
      },
      "history": {
        "type": "boolean"
      }
    }
  },
  "readers": {
    "ai": [
      "style",
      "length",
      "perspective",
      "personalization",
      "history"
    ]
  }
}
