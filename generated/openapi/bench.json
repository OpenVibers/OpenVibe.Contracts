 "components": {
  "schemas": {
   "bench.entry.v1": {
    "title": "BenchEntry",
    "description": "bench.entry@1: one submitted entry in a benchmark round on OpenVibe.Bench. PROVIDER and MODEL name the offer; ROUTE is the exact route taken; PAYLOAD is the entry's output; COST_USD, MS and TOKENS are the measured use.",
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "round_id",
     "provider",
     "model",
     "route",
     "payload",
     "cost_usd",
     "ms",
     "tokens"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "round_id": {
      "type": "string"
     },
     "provider": {
      "type": "string"
     },
     "model": {
      "type": "string"
     },
     "route": {
      "type": "object"
     },
     "payload": {
      "type": "object"
     },
     "cost_usd": {
      "type": "number"
     },
     "ms": {
      "type": "number"
     },
     "tokens": {
      "type": "number"
     },
     "error": {
      "type": [
       "string",
       "null"
      ]
     },
     "ui_check": {
      "type": [
       "object",
       "null"
      ]
     },
     "run_id": {
      "type": [
       "string",
       "null"
      ]
     }
    }
   },
   "bench.judgement.v1": {
    "title": "BenchJudgement",
    "description": "bench.judgement@1: a blind judgement cast on a benchmark round on OpenVibe.Bench. JUDGE names the judge (pair, rubric, automatic_grader, test_suite, game_outcome); METHOD is how the pair was decided; PAIR is the two entry ids; OUTCOME and SCORE are the result.",
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "round_id",
     "kind_id",
     "judge",
     "method",
     "pair",
     "outcome",
     "score",
     "at"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "round_id": {
      "type": "string"
     },
     "kind_id": {
      "type": "string"
     },
     "judge": {
      "type": "string"
     },
     "judge_name": {
      "type": [
       "string",
       "null"
      ]
     },
     "judge_version": {
      "type": [
       "string",
       "null"
      ]
     },
     "method": {
      "type": "string"
     },
     "pair": {
      "type": [
       "object",
       "null"
      ]
     },
     "outcome": {
      "type": [
       "string",
       "null"
      ]
     },
     "score": {
      "type": [
       "number",
       "null"
      ]
     },
     "at": {
      "type": "string",
      "format": "date-time"
     }
    }
   },
   "bench.kind.v1": {
    "title": "BenchKind",
    "description": "bench.kind@1: a benchmark kind on OpenVibe.Bench. ROOM is the room that owns the kind, ENTRY the shape a submitted entry takes, JUDGE the default judge (pair, rubric, automatic_grader, test_suite or game_outcome), NAME the display name, SCHEMA the entry JSON Schema, and METRICS the board metrics (elo, pareto, cost, or a room's own).",
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "room",
     "entry",
     "judge",
     "name",
     "schema",
     "metrics",
     "created_at"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "room": {
      "type": "string"
     },
     "entry": {
      "type": "string"
     },
     "judge": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "schema": {
      "type": "object"
     },
     "metrics": {
      "type": "array",
      "items": {
       "type": "string"
