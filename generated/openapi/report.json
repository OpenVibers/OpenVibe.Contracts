{
 "openapi": "3.1.0",
 "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
 "info": {
  "title": "OpenVibe.Report API",
  "version": "0.264.0",
  "description": "Routes of OpenVibe.Report as the OpenVibe contracts describe them (openvibe-contracts 0.264.0): each operation lists the capabilities it performs; a token for the service's audience must carry one of them unless the route is open. Generated by openvibe-contracts lib/openapi.js; do not edit.",
  "license": {
   "name": "MIT",
   "identifier": "MIT"
  }
 },
 "servers": [
  {
   "url": "https://openvibe.report"
  }
 ],
 "paths": {
  "/api/v1/ai/usage": {
   "get": {
    "operationId": "get_api_v1_ai_usage",
    "summary": "Read the AI meter across the network: the usage records and their roll-ups, in groups (day, site, model, system, paid_by).",
    "description": "**report.ai_usage.read** (internal): Read the AI meter across the network: the usage records and their roll-ups, in groups (day, site, model, system, paid_by). The public totals (GET /api/v1/ai/usage/open) need no token at all.",
    "tags": [
     "report.ai_usage"
    ],
    "x-openvibe-capabilities": [
     "report.ai_usage.read"
    ],
    "x-openvibe-visibility": [
     "internal"
    ],
    "x-openvibe-quota-class": "report-read",
    "security": [
     {
      "openvibeToken": [
       "report.ai_usage.read"
      ]
     }
    ],
    "responses": {
     "2XX": {
      "description": "Success",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/report.ai-usage-result.v1"
        }
       }
      }
     },
     "default": {
      "description": "An error (RFC 9457 problem details)",
      "content": {
       "application/problem+json": {
        "schema": {
         "$ref": "#/components/schemas/errors.problem.v1"
        }
       }
      }
     }
    }
   }
  }
 },
 "components": {
  "schemas": {
   "errors.problem.v1": {
    "title": "Problem",
    "description": "RFC 9457 problem details (application/problem+json) with a stable OpenVibe error code and trace identifiers. The legacy 'error' string is allowed during migration so existing clients keep working.",
    "type": "object",
    "required": [
     "type",
     "title",
     "status",
     "code"
    ],
    "additionalProperties": true,
    "properties": {
     "type": {
      "type": "string",
      "format": "uri-reference"
     },
     "title": {
      "type": "string",
      "minLength": 1
     },
     "status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599
     },
     "detail": {
      "type": "string"
     },
     "instance": {
      "type": "string",
      "format": "uri-reference"
     },
     "code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
     },
     "request_id": {
      "type": "string"
     },
     "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
     },
     "errors": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "message"
       ],
       "properties": {
        "path": {
         "type": "string"
        },
        "message": {
         "type": "string"
        }
       }
      }
     },
     "error": {
      "type": "string",
      "description": "Deprecated compatibility field: same text as title/detail for clients that read {error}."
     }
    }
   },
   "report.ai-usage-result.v1": {
    "title": "ReportAiUsageResult",
    "description": "report.ai-usage-result@1: the AI meter in groups (plan L40/L41). GET /api/v1/ai/usage needs a service token with report.ai_usage.read; the rows are grouped by day, site, model, system or paid_by. A group that fewer than ten people share reads fewer than 10 instead of counting them.",
    "type": "object",
    "required": [
     "group",
     "usage",
     "totals"
    ],
    "additionalProperties": false,
    "properties": {
     "group": {
      "type": "string",
      "enum": [
       "day",
       "site",
       "model",
       "system",
       "paid_by"
      ]
     },
     "usage": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "group",
        "key",
        "calls",
        "people",
        "input",
        "output",
        "reasoning",
        "cache_read",
        "cache_write",
        "list_cost_usd",
        "charged_usd",
        "fee_usd",
        "cache_saved_usd"
       ],
       "additionalProperties": false,
       "properties": {
        "group": {
         "type": "string",
         "enum": [
          "day",
          "site",
          "model",
          "system",
          "paid_by"
         ]
        },
        "key": {
         "type": "string",
         "maxLength": 200,
         "description": "The name of the group: the day, the site, the model, the system or the payer."
        },
        "calls": {
         "type": "integer",
         "minimum": 0
        },
        "people": {
         "oneOf": [
          {
           "type": "integer",
           "minimum": 10,
           "description": "How many people the group holds, when there are ten or more."
          },
          {
           "const": "fewer than 10",
           "description": "Fewer than ten people: the count is not given."
          }
         ]
        },
        "input": {
         "type": "integer",
         "minimum": 0
        },
        "output": {
         "type": "integer",
         "minimum": 0
        },
        "reasoning": {
         "type": "integer",
         "minimum": 0
        },
        "cache_read": {
         "type": "integer",
         "minimum": 0
        },
        "cache_write": {
         "type": "integer",
         "minimum": 0
        },
        "images": {
         "type": "integer",
         "minimum": 0
        },
        "audio_seconds": {
         "type": "number",
         "minimum": 0
        },
        "video_seconds": {
         "type": "number",
         "minimum": 0
        },
        "list_cost_usd": {
         "type": "number",
         "minimum": 0
        },
        "charged_usd": {
         "type": "number",
         "minimum": 0
        },
        "fee_usd": {
         "type": "number",
         "minimum": 0
        },
        "cache_saved_usd": {
         "type": "number",
         "minimum": 0
        }
       }
      }
     },
     "totals": {
      "type": "object",
      "required": [
       "calls",
       "input",
       "output",
       "reasoning",
       "cache_read",
       "cache_write",
       "list_cost_usd",
       "charged_usd",
       "fee_usd",
       "cache_saved_usd"
      ],
      "additionalProperties": false,
      "properties": {
       "calls": {
        "type": "integer",
        "minimum": 0
       },
       "input": {
        "type": "integer",
        "minimum": 0
       },
       "output": {
        "type": "integer",
        "minimum": 0
       },
       "reasoning": {
        "type": "integer",
        "minimum": 0
       },
       "cache_read": {
        "type": "integer",
        "minimum": 0
       },
       "cache_write": {
        "type": "integer",
        "minimum": 0
       },
       "images": {
        "type": "integer",
        "minimum": 0
       },
       "audio_seconds": {
        "type": "number",
        "minimum": 0
       },
       "video_seconds": {
        "type": "number",
        "minimum": 0
       },
       "list_cost_usd": {
        "type": "number",
        "minimum": 0
       },
       "charged_usd": {
        "type": "number",
        "minimum": 0
       },
       "fee_usd": {
        "type": "number",
        "minimum": 0
       },
       "cache_saved_usd": {
        "type": "number",
        "minimum": 0
       }
      }
     }
    }
   }
  },
  "securitySchemes": {
   "openvibeToken": {
    "type": "http",
    "scheme": "bearer",
    "bearerFormat": "JWT",
    "description": "An OpenVibe Network token for this service: a person's token, an app token (client credentials, audience of the service) or a first-party service token. Its `cap` claim must include the capability the operation names."
   }
  }
 }
}
