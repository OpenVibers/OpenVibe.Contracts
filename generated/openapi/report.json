 },
 "components": {
  "schemas": {
   "errors.problem.v1": {
    "title": "Problem",
    "description": "RFC 9457 problem details (application/problem+json) with a stable OpenVibe error code and trace identifiers. The legacy 'error' string is allowed during migration so existing clients keep working.",
    "type": "object",
    "required": [
     "type",
     "title",
     "status",
     "code"
    ],
    "additionalProperties": true,
    "properties": {
     "type": {
      "type": "string",
      "format": "uri-reference"
     },
     "title": {
      "type": "string",
      "minLength": 1
     },
     "status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599
     },
     "detail": {
      "type": "string"
     },
     "instance": {
      "type": "string",
      "format": "uri-reference"
     },
     "code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
     },
     "request_id": {
      "type": "string"
     },
     "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
     },
     "errors": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "message"
       ],
       "properties": {
        "path": {
         "type": "string"
        },
        "message": {
         "type": "string"
        }
       }
      }
     },
     "error": {
      "type": "string",
      "description": "Deprecated compatibility field: same text as title/detail for clients that read {error}."
     }
    }
   },
   "platform.owner-settings-change.v1": {
    "title": "PlatformOwnerSettingsChange",
    "description": "platform.owner-settings-change@1 (AI Exchange D11): body of PATCH /internal/owner-settings on each service that owns owner settings. It changes one or more typed values at once. A key whose setting has source env is pinned and the service answers 409 settings.pinned_in_env; a secret-type setting is never changed here (use platform.owner-secret-put@1). Each request carries the owner as actor and the service audits every change with that actor and key, never the value.",
    "type": "object",
    "additionalProperties": false,
    "required": [
     "changes",
     "actor"
    ],
    "properties": {
     "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "key",
        "value"
       ],
       "properties": {
        "key": {
         "type": "string",
         "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
         "description": "The setting key, as platform.owner-settings@1 names it."
        },
        "value": {
         "description": "The new typed value. A nano_usd value is an integer string; a float is never a value.",
         "oneOf": [
          {
           "type": "boolean"
          },
          {
           "type": "integer"
          },
          {
           "type": "string"
          },
          {
           "type": "array",
           "maxItems": 256,
           "items": {
            "type": "string"
           }
          }
         ]
        }
       }
      }
     },
     "actor": {
      "$ref": "#/components/schemas/platform.owner-settings-change.v1/$defs/actor"
     },
     "reason": {
      "type": "string",
      "maxLength": 500,
      "description": "Why the owner changed it; recorded in the service's audit line."
     }
    },
    "$defs": {
     "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "type",
       "id"
      ],
      "properties": {
       "type": {
        "const": "user",
        "description": "The owner; a service or an app is never the actor."
       },
       "id": {
        "type": "string",
        "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$"
       }
      }
     }
    }
   },
   "platform.owner-settings.v1": {
    "title": "PlatformOwnerSettings",
    "description": "platform.owner-settings@1 (AI Exchange D11): one service's owner settings document, answered by GET/PATCH /internal/owner-settings and by PUT/DELETE /internal/owner-settings/secrets/:key on the service that owns the settings. A setting is typed and says where its effective value comes from; `env` pins it read-only. A secret setting never carries its value (and never a default): only the write-only metadata `secret`. nano_usd values are integer strings, never numbers. Only Network's admin proxy, acting for the owner, reads or writes this document.",
    "type": "object",
    "additionalProperties": false,
    "required": [
     "service",
     "groups",
     "settings"
    ],
    "properties": {
     "service": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,39}$",
      "description": "The service whose settings these are, e.g. ai."
     },
     "groups": {
      "type": "array",
      "description": "The groups the settings are shown under.",
      "items": {
       "$ref": "#/components/schemas/platform.owner-settings.v1/$defs/group"
      }
     },
     "settings": {
      "type": "array",
      "description": "Every setting the service exposes to the owner.",
      "items": {
       "$ref": "#/components/schemas/platform.owner-settings.v1/$defs/setting"
      }
     }
    },
    "$defs": {
     "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "id",
       "label"
      ],
      "properties": {
       "id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,63}$",
        "description": "Stable group id; a setting names it in `group`."
       },
       "label": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
       },
       "description": {
        "type": "string",
        "maxLength": 1000
       }
      }
     },
     "nano-usd": {
      "type": "string",
      "pattern": "^[0-9]{1,19}$",
      "description": "Integer nano-USD (1e-9 USD) as a decimal string (D1). Never a number or a float."
     },
     "https-origin": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[A-Za-z0-9](?:[A-Za-z0-9.-]{0,251}[A-Za-z0-9])?(?::[0-9]{1,5})?$",
      "description": "An https origin: scheme, host and optional port, with no path, query or fragment."
     },
     "secret": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "set"
      ],
      "properties": {
       "set": {
        "type": "boolean",
        "description": "Whether a value is sealed in the owning service."
       },
       "hint": {
        "type": [
         "string",
         "null"
        ],
        "maxLength": 16,
        "description": "A short hint (the last four characters), never the value."
       },
       "fingerprint": {
        "type": [
         "string",
         "null"
        ],
        "pattern": "^[0-9a-f]{16}$",
        "description": "A keyed HMAC-SHA-256 fingerprint, 16 hex characters: tells whether two keys are the same without revealing either."
       },
       "set_at": {
        "type": [
         "string",
         "null"
        ],
        "format": "date-time"
       },
       "set_by": {
        "type": [
         "string",
         "null"
        ],
        "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$",
        "description": "The owner who set it."
       },
       "bound_to": {
        "$ref": "#/components/schemas/platform.owner-settings.v1/$defs/https-origin",
        "description": "The destination origin the value is sealed to; absent or null when unbound."
       }
      }
     },
     "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "key",
       "group",
       "label",
       "description",
       "type",
       "source",
       "danger",
       "restart"
      ],
      "properties": {
       "key": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
        "description": "Stable setting key, e.g. ai.model_catalog."
       },
       "group": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,63}$",
        "description": "The id of the setting's group."
       },
       "label": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
       },
       "description": {
        "type": "string",
        "maxLength": 1000
       },
       "type": {
        "enum": [
         "boolean",
         "integer",
         "nano_usd",
         "string",
         "enum",
         "list",
         "secret"
        ]
       },
       "enum": {
        "type": "array",
        "minItems": 1,
        "maxItems": 256,
        "uniqueItems": true,
        "items": {
         "type": "string"
        },
        "description": "The allowed values; present only when type is enum."
       },
       "min": {
        "type": "integer",
        "minimum": 0,
        "description": "The smallest allowed value; present only when type is integer or nano_usd."
       },
       "max": {
        "type": "integer",
        "minimum": 0,
        "description": "The largest allowed value; present only when type is integer or nano_usd."
       },
       "value": {
        "description": "The effective typed value; absent for type secret."
       },
       "default": {
        "description": "The typed default; absent for type secret."
       },
       "source": {
        "enum": [
         "env",
         "owner",
         "default"
        ],
        "description": "env pins the setting read-only and wins; owner is a value the owner set; default is the built-in default."
       },
       "env": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{0,127}$",
        "description": "The environment variable that pins the setting; present when source is env."
       },
       "danger": {
        "type": "boolean",
        "description": "A write needs a fresh sign-in (and an operator alert)."
       },
       "restart": {
        "type": "boolean",
        "description": "A change takes effect only after the service restarts."
       },
       "secret": {
        "$ref": "#/components/schemas/platform.owner-settings.v1/$defs/secret",
        "description": "Write-only metadata; present only when type is secret."
       },
       "updated_at": {
        "type": "string",
        "format": "date-time"
       },
       "updated_by": {
        "type": "string",
        "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$"
       }
      },
      "allOf": [
       {
        "if": {
         "properties": {
          "type": {
           "const": "secret"
          }
         },
         "required": [
          "type"
         ]
        },
        "then": {
         "not": {
          "anyOf": [
           {
            "required": [
             "value"
            ]
           },
           {
            "required": [
             "default"
            ]
           }
          ]
