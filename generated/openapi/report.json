    },
    "parameters": [
     {
      "name": "key",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "changes",
      "in": "query",
      "required": true,
      "schema": {
       "type": "array",
       "minItems": 1,
       "maxItems": 64,
       "items": {
        "type": "object",
