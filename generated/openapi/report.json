     {
      "name": "changes",
      "in": "query",
      "required": true,
      "schema": {
       "type": "array",
       "minItems": 1,
       "maxItems": 64,
       "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "key",
         "value"
        ],
        "properties": {
         "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "description": "The setting key, as platform.owner-settings@1 names it."
         },
         "value": {
          "description": "The new typed value. A nano_usd value is an integer string; a float is never a value.",
          "oneOf": [
           {
            "type": "boolean"
           },
           {
            "type": "integer"
           },
           {
            "type": "string"
           },
           {
            "type": "array",
            "maxItems": 256,
            "items": {
             "type": "string"
            }
           }
          ]
         }
        }
       }
      }
     },
     {
      "name": "actor",
      "in": "query",
      "required": true,
      "schema": {
       "$ref": "#/components/schemas/platform.owner-settings-change.v1/$defs/actor"
      }
     },
     {
      "name": "reason",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "maxLength": 500,
       "description": "Why the owner changed it; recorded in the service's audit line."
      },
      "description": "Why the owner changed it; recorded in the service's audit line."
     }
    ],
    "responses": {
     "2XX": {
      "description": "Success",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/platform.owner-settings.v1"
        }
       }
      }
     },
     "default": {
      "description": "An error (RFC 9457 problem details)",
      "content": {
       "application/problem+json": {
        "schema": {
         "$ref": "#/components/schemas/errors.problem.v1"
        }
       }
      }
     }
    }
   },
   "patch": {
    "operationId": "patch_internal_owner_settings",
    "summary": "Manage OpenVibe.Report's owner settings (D11): GET /internal/owner-settings answers platform.owner-settings@1 and PATCH changes typed values with platform.owner-settings-change@1 (a key with source en",
    "description": "**report.settings.manage** (internal): Manage OpenVibe.Report's owner settings (D11): GET /internal/owner-settings answers platform.owner-settings@1 and PATCH changes typed values with platform.owner-settings-change@1 (a key with source env is 409 settings.pinned_in_env); PUT /internal/owner-settings/secrets/:key sets a secret once with platform.owner-secret-put@1 (write-only) and DELETE removes it. The first set is the AI Exchange analytics. Only Network's admin proxy, acting for the owner, holds this capability; it is never grantable to apps. Each request carries the owner as actor, and the service audits every write with that actor and key, never the value.",
    "tags": [
     "report.settings"
    ],
    "x-openvibe-capabilities": [
     "report.settings.manage"
    ],
    "x-openvibe-visibility": [
     "internal"
    ],
    "x-openvibe-quota-class": "owner-settings",
    "security": [
     {
      "openvibeToken": [
       "report.settings.manage"
      ]
     }
    ],
    "requestBody": {
