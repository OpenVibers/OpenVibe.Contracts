{
 "openapi": "3.1.0",
 "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
 "info": {
  "title": "OpenVibe.Food API",
  "version": "0.219.0",
  "description": "Routes of OpenVibe.Food as the OpenVibe contracts describe them (openvibe-contracts 0.219.0): each operation lists the capabilities it performs; a token for the service's audience must carry one of them unless the route is open. Generated by openvibe-contracts lib/openapi.js; do not edit.",
  "license": {
   "name": "MIT",
   "identifier": "MIT"
  }
 },
 "servers": [
  {
   "url": "https://openvibe.food"
  }
 ],
 "paths": {
  "/api/v1/pantry": {
   "get": {
    "operationId": "get_api_v1_pantry",
    "summary": "Read a caller's pantry with the suggestions matched against it: GET /api/v1/pantry → { items, foods, suggestions: { can_make, almost }, note }.",
    "description": "**food.pantry.read** (public): Read a caller's pantry with the suggestions matched against it: GET /api/v1/pantry → { items, foods, suggestions: { can_make, almost }, note }. The suggestions are deterministic matches against basic recipes, not dietary advice.",
    "tags": [
     "food.pantry"
    ],
    "x-openvibe-capabilities": [
     "food.pantry.read"
    ],
    "x-openvibe-visibility": [
     "public"
    ],
    "x-openvibe-quota-class": "food-read",
    "security": [
     {
      "openvibeToken": [
       "food.pantry.read"
      ]
     }
    ],
    "responses": {
     "2XX": {
      "description": "Success",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/food.pantry-result.v1"
        }
       }
      }
     },
     "default": {
      "description": "An error (RFC 9457 problem details)",
      "content": {
       "application/problem+json": {
        "schema": {
         "$ref": "#/components/schemas/errors.problem.v1"
        }
       }
      }
     }
    }
   },
   "put": {
    "operationId": "put_api_v1_pantry",
    "summary": "Replace a caller's pantry with exactly this list: PUT /api/v1/pantry with { items: [food slug, …] } (at most 200, each one in the food list; GET /api/v1/foods lists them).",
    "description": "**food.pantry.write** (public): Replace a caller's pantry with exactly this list: PUT /api/v1/pantry with { items: [food slug, …] } (at most 200, each one in the food list; GET /api/v1/foods lists them). Answers like a read.",
    "tags": [
     "food.pantry"
    ],
    "x-openvibe-capabilities": [
     "food.pantry.write"
    ],
    "x-openvibe-visibility": [
     "public"
    ],
    "x-openvibe-quota-class": "food-write",
    "security": [
     {
      "openvibeToken": [
       "food.pantry.write"
      ]
     }
    ],
    "requestBody": {
     "required": false,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/food.pantry-request.v1"
       }
      }
     }
    },
    "responses": {
     "2XX": {
      "description": "Success",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/food.pantry-result.v1"
        }
       }
      }
     },
     "default": {
      "description": "An error (RFC 9457 problem details)",
      "content": {
       "application/problem+json": {
        "schema": {
         "$ref": "#/components/schemas/errors.problem.v1"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/plans": {
   "get": {
    "operationId": "get_api_v1_plans",
    "summary": "Read the plans a caller saved: GET /api/v1/plans (newest first, ?limit to 50) → { plans }, and GET /api/v1/plans/:id → one plan.",
    "description": "**food.plan.read** (public): Read the plans a caller saved: GET /api/v1/plans (newest first, ?limit to 50) → { plans }, and GET /api/v1/plans/:id → one plan. Only the person who saved a plan (or their tokens) can read it.",
    "tags": [
     "food.plan"
    ],
    "x-openvibe-capabilities": [
     "food.plan.read"
    ],
    "x-openvibe-visibility": [
     "public"
    ],
    "x-openvibe-quota-class": "food-read",
    "security": [
     {
      "openvibeToken": [
       "food.plan.read"
      ]
     }
    ],
    "responses": {
     "2XX": {
      "description": "Success",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/food.plan-result.v1"
        }
       }
      }
     },
     "default": {
      "description": "An error (RFC 9457 problem details)",
      "content": {
       "application/problem+json": {
        "schema": {
         "$ref": "#/components/schemas/errors.problem.v1"
        }
       }
      }
     }
    }
   },
   "post": {
    "operationId": "post_api_v1_plans",
    "summary": "Plan a shop for a household and a budget and save it: POST /api/v1/plans with { people, days, budget?, title?",
    "description": "**food.plan.write** (public): Plan a shop for a household and a budget and save it: POST /api/v1/plans with { people, days, budget?, title? }. Food picks budget items from its food list to cover each food group for every person and day, splits them by the cheapest store and lays out a menu; the saved plan (201, Location /api/v1/plans/:id) is the caller's own.",
    "tags": [
     "food.plan"
    ],
    "x-openvibe-capabilities": [
     "food.plan.write"
    ],
    "x-openvibe-visibility": [
     "public"
    ],
    "x-openvibe-quota-class": "food-write",
    "security": [
     {
      "openvibeToken": [
       "food.plan.write"
      ]
     }
    ],
    "requestBody": {
     "required": false,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/food.plan-create-request.v1"
       }
      }
     }
    },
    "responses": {
     "2XX": {
      "description": "Success",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/food.plan-result.v1"
        }
       }
      }
     },
     "default": {
      "description": "An error (RFC 9457 problem details)",
      "content": {
       "application/problem+json": {
        "schema": {
         "$ref": "#/components/schemas/errors.problem.v1"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/plans/{id}": {
   "get": {
    "operationId": "get_api_v1_plans_id",
    "summary": "Read the plans a caller saved: GET /api/v1/plans (newest first, ?limit to 50) → { plans }, and GET /api/v1/plans/:id → one plan.",
    "description": "**food.plan.read** (public): Read the plans a caller saved: GET /api/v1/plans (newest first, ?limit to 50) → { plans }, and GET /api/v1/plans/:id → one plan. Only the person who saved a plan (or their tokens) can read it.",
    "tags": [
     "food.plan"
    ],
    "x-openvibe-capabilities": [
     "food.plan.read"
    ],
    "x-openvibe-visibility": [
     "public"
    ],
    "x-openvibe-quota-class": "food-read",
    "security": [
     {
      "openvibeToken": [
       "food.plan.read"
      ]
     }
    ],
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "2XX": {
      "description": "Success",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/food.plan-result.v1"
        }
       }
      }
     },
     "default": {
      "description": "An error (RFC 9457 problem details)",
      "content": {
       "application/problem+json": {
        "schema": {
         "$ref": "#/components/schemas/errors.problem.v1"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/recipes": {
   "get": {
    "operationId": "get_api_v1_recipes",
    "summary": "Recipe ideas from the caller's saved pantry: POST /api/v1/recipes/suggest runs OpenVibe.AI's food.suggest_recipes workflow for the caller (up to three recipes; ingredients from the pantry or cited to ",
    "description": "**food.recipes.suggest** (public): Recipe ideas from the caller's saved pantry: POST /api/v1/recipes/suggest runs OpenVibe.AI's food.suggest_recipes workflow for the caller (up to three recipes; ingredients from the pantry or cited to Food's food list; what is still to buy priced from Food's own typical prices), 10 a person a day; GET /api/v1/recipes lists the last 20. A person acting for themself needs no capability; an app or agent token needs this one.",
    "tags": [
     "food.recipes"
    ],
    "x-openvibe-capabilities": [
     "food.recipes.suggest"
    ],
    "x-openvibe-visibility": [
     "public"
    ],
    "x-openvibe-quota-class": "standard",
    "security": [
     {
      "openvibeToken": [
       "food.recipes.suggest"
      ]
     }
    ],
    "x-openvibe-input": {
     "$ref": "#/components/schemas/food.recipe-suggest-request.v1"
    },
    "parameters": [
     {
      "name": "ask",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "maxLength": 500
      }
     },
     {
      "name": "people",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "minimum": 1,
       "maximum": 12
      }
     }
    ],
    "responses": {
     "2XX": {
      "description": "Success",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/food.recipe-result.v1"
        }
       }
      }
     },
     "default": {
      "description": "An error (RFC 9457 problem details)",
      "content": {
       "application/problem+json": {
        "schema": {
         "$ref": "#/components/schemas/errors.problem.v1"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/recipes/suggest": {
   "post": {
    "operationId": "post_api_v1_recipes_suggest",
    "summary": "Recipe ideas from the caller's saved pantry: POST /api/v1/recipes/suggest runs OpenVibe.AI's food.suggest_recipes workflow for the caller (up to three recipes; ingredients from the pantry or cited to ",
    "description": "**food.recipes.suggest** (public): Recipe ideas from the caller's saved pantry: POST /api/v1/recipes/suggest runs OpenVibe.AI's food.suggest_recipes workflow for the caller (up to three recipes; ingredients from the pantry or cited to Food's food list; what is still to buy priced from Food's own typical prices), 10 a person a day; GET /api/v1/recipes lists the last 20. A person acting for themself needs no capability; an app or agent token needs this one.",
    "tags": [
     "food.recipes"
    ],
    "x-openvibe-capabilities": [
     "food.recipes.suggest"
    ],
    "x-openvibe-visibility": [
     "public"
    ],
    "x-openvibe-quota-class": "standard",
    "security": [
     {
      "openvibeToken": [
       "food.recipes.suggest"
      ]
     }
    ],
    "requestBody": {
     "required": false,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/food.recipe-suggest-request.v1"
       }
      }
     }
    },
    "responses": {
     "2XX": {
      "description": "Success",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/food.recipe-result.v1"
        }
       }
      }
     },
     "default": {
      "description": "An error (RFC 9457 problem details)",
      "content": {
       "application/problem+json": {
        "schema": {
         "$ref": "#/components/schemas/errors.problem.v1"
        }
       }
      }
     }
    }
   }
  },
  "/internal/households/{planId}/chat-context": {
   "get": {
    "operationId": "get_internal_households_planId_chat_context",
    "summary": "Read a household's pantry and plan as plain text for the AI member of its OpenVibe.Chat room (Chat's AI members, linked to a Food household): GET /internal/households/:planId/chat-context → { text, so",
    "description": "**food.household.read** (internal): Read a household's pantry and plan as plain text for the AI member of its OpenVibe.Chat room (Chat's AI members, linked to a Food household): GET /internal/households/:planId/chat-context → { text, source, updated_at }. The household is a saved plan shared with its members; the text names the members by display name, the plan's days and meals, what is still to buy and what each member keeps in their cupboard. Loopback only, service token; granted to Chat.",
    "tags": [
     "food.household"
    ],
    "x-openvibe-capabilities": [
     "food.household.read"
    ],
    "x-openvibe-visibility": [
     "internal"
    ],
    "x-openvibe-quota-class": "internal-read",
    "security": [
     {
      "openvibeToken": [
       "food.household.read"
      ]
     }
    ],
    "parameters": [
     {
      "name": "planId",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "2XX": {
      "description": "Success",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/food.household-chat-context.v1"
        }
       }
      }
     },
     "default": {
      "description": "An error (RFC 9457 problem details)",
      "content": {
       "application/problem+json": {
        "schema": {
         "$ref": "#/components/schemas/errors.problem.v1"
        }
       }
      }
     }
    }
   }
  }
 },
 "components": {
  "schemas": {
   "errors.problem.v1": {
    "title": "Problem",
    "description": "RFC 9457 problem details (application/problem+json) with a stable OpenVibe error code and trace identifiers. The legacy 'error' string is allowed during migration so existing clients keep working.",
    "type": "object",
    "required": [
     "type",
     "title",
     "status",
     "code"
    ],
    "additionalProperties": true,
    "properties": {
     "type": {
      "type": "string",
      "format": "uri-reference"
     },
     "title": {
      "type": "string",
      "minLength": 1
     },
     "status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599
     },
     "detail": {
      "type": "string"
     },
     "instance": {
      "type": "string",
      "format": "uri-reference"
     },
     "code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
     },
     "request_id": {
      "type": "string"
     },
     "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
     },
     "errors": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "message"
       ],
       "properties": {
        "path": {
         "type": "string"
        },
        "message": {
         "type": "string"
        }
       }
      }
     },
     "error": {
      "type": "string",
      "description": "Deprecated compatibility field: same text as title/detail for clients that read {error}."
     }
    }
   },
   "food.household-chat-context.v1": {
    "title": "FoodHouseholdChatContext",
    "description": "food.household-chat-context@1: what food.household.read answers (GET /internal/households/:planId/chat-context): a household's pantry and plan as plain text for the AI member of its OpenVibe.Chat room, and where it comes from.",
    "type": "object",
    "additionalProperties": false,
    "required": [
     "text",
     "source"
    ],
    "properties": {
     "text": {
      "type": "string",
      "maxLength": 4000,
      "description": "The household's members, the plan (days, people, budget, meals), what is still to buy and what is in their cupboards."
     },
     "source": {
      "type": "string",
      "maxLength": 80,
      "description": "A label for the prompt, e.g. 'OpenVibe.Food household'."
     },
     "updated_at": {
      "type": "string",
      "format": "date-time"
     }
    }
   },
   "food.pantry-request.v1": {
    "title": "FoodPantryRequest",
    "description": "food.pantry-request@1: PUT /api/v1/pantry on OpenVibe.Food replaces the pantry with exactly these food slugs.",
    "type": "object",
    "additionalProperties": false,
    "required": [
     "items"
    ],
    "properties": {
     "items": {
      "type": "array",
      "maxItems": 200,
      "items": {
       "type": "string",
       "minLength": 1,
       "maxLength": 80
      }
     }
    }
   },
   "food.pantry-result.v1": {
    "title": "FoodPantryResult",
    "description": "food.pantry-result@1: GET and PUT /api/v1/pantry on OpenVibe.Food: the slugs, each food as the food list shows it, and the suggestions matched against them (can_make: everything there; almost: one or two items missing, named).",
    "type": "object",
    "required": [
     "items",
     "foods",
     "suggestions"
    ],
    "properties": {
     "items": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "foods": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "slug",
        "name"
       ],
       "properties": {
        "slug": {
         "type": "string"
        },
        "name": {
         "type": "string"
        }
       }
      }
     },
     "suggestions": {
      "type": "object",
      "required": [
       "can_make",
       "almost"
      ],
      "properties": {
       "can_make": {
        "type": "array",
        "items": {
         "type": "object",
         "required": [
          "slug",
          "name"
         ],
         "properties": {
          "slug": {
           "type": "string"
          },
          "name": {
           "type": "string"
          },
          "serves": {
           "type": "integer"
          },
          "minutes": {
           "type": "integer"
          },
          "missing": {
           "type": "array",
           "items": {
            "type": "string"
           }
          }
         }
        }
       },
       "almost": {
        "type": "array",
        "items": {
         "type": "object",
         "required": [
          "slug",
          "name"
         ],
         "properties": {
          "slug": {
           "type": "string"
          },
          "name": {
           "type": "string"
          },
          "serves": {
           "type": "integer"
          },
          "minutes": {
           "type": "integer"
          },
          "missing": {
           "type": "array",
           "items": {
            "type": "string"
           }
          }
         }
        }
       }
      }
     },
     "note": {
      "type": "string"
     }
    }
   },
   "food.plan-create-request.v1": {
    "title": "FoodPlanCreateRequest",
    "description": "food.plan-create-request@1: POST /api/v1/plans on OpenVibe.Food. people 1-12, days 1-14, budget (US dollars for the whole plan) optional, title optional.",
    "type": "object",
    "additionalProperties": false,
    "required": [
     "people",
     "days"
    ],
    "properties": {
     "people": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
     },
     "days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 14
     },
     "budget": {
      "type": [
       "number",
       "null"
      ],
      "minimum": 1,
      "maximum": 5000
     },
     "title": {
      "type": [
       "string",
       "null"
      ],
      "maxLength": 120
     }
    }
   },
   "food.plan-result.v1": {
    "title": "FoodPlanResult",
    "description": "food.plan-result@1: answers of the plan routes on OpenVibe.Food: GET /api/v1/plans → { plans }; GET /api/v1/plans/:id and POST /api/v1/plans (201) → the plan itself (food.plan@1).",
    "anyOf": [
     {
      "type": "object",
      "required": [
       "plans"
      ],
      "additionalProperties": false,
      "properties": {
       "plans": {
        "type": "array",
        "items": {
         "$ref": "#/components/schemas/food.plan.v1"
        }
       }
      }
     },
     {
      "$ref": "#/components/schemas/food.plan.v1"
     }
    ]
   },
   "food.plan.v1": {
    "title": "FoodPlan",
    "description": "food.plan@1: one saved plan on OpenVibe.Food.",
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "title",
     "people",
     "days",
     "budget",
     "created_at",
     "plan"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^pln_[0-9A-HJKMNP-TV-Z]{26}$"
     },
     "title": {
      "type": [
       "string",
       "null"
      ],
      "maxLength": 120
     },
     "people": {
      "type": "integer",
      "minimum": 1
     },
     "days": {
      "type": "integer",
      "minimum": 1
     },
     "budget": {
      "type": [
       "number",
       "null"
      ],
      "minimum": 0
     },
     "created_at": {
      "type": "string",
      "format": "date-time"
     },
     "plan": {
      "type": "object",
      "description": "The plan as Food worked it out: spec, items (the shopping list), by_store, menu (one entry a day: breakfast, lunch, dinner, snack), group_coverage and totals (cost, cost_per_person_day, kcal, protein). Food may add fields.",
      "required": [
       "spec",
       "items",
       "menu",
       "totals"
      ],
      "properties": {
       "spec": {
        "type": "object",
        "required": [
         "people",
         "days"
        ],
        "properties": {
         "people": {
          "type": "integer"
         },
         "days": {
          "type": "integer"
         },
         "budget": {
          "type": [
           "number",
           "null"
          ]
         }
        }
       },
       "items": {
        "type": "array",
        "items": {
         "type": "object"
        }
       },
       "menu": {
        "type": "array",
        "items": {
         "type": "object",
         "required": [
          "day"
         ],
         "properties": {
          "day": {
           "type": "integer",
           "minimum": 1
          }
         }
        }
       },
       "totals": {
        "type": "object",
        "required": [
         "cost"
        ],
        "properties": {
         "cost": {
          "type": "number",
          "minimum": 0
         }
        }
       }
      }
     }
    }
   },
   "food.recipe-result.v1": {
    "title": "FoodRecipeResult",
    "description": "food.recipe-result@1: what food.recipes.suggest answers: the new suggestion (POST /api/v1/recipes/suggest, 201) or the caller's recent ones (GET /api/v1/recipes).",
    "anyOf": [
     {
