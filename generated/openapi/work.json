 "components": {
  "schemas": {
   "errors.problem.v1": {
    "title": "Problem",
    "description": "RFC 9457 problem details (application/problem+json) with a stable OpenVibe error code and trace identifiers. The legacy 'error' string is allowed during migration so existing clients keep working.",
    "type": "object",
    "required": [
     "type",
     "title",
     "status",
     "code"
    ],
    "additionalProperties": true,
    "properties": {
     "type": {
      "type": "string",
      "format": "uri-reference"
     },
     "title": {
      "type": "string",
      "minLength": 1
     },
     "status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599
     },
     "detail": {
      "type": "string"
     },
     "instance": {
      "type": "string",
      "format": "uri-reference"
     },
     "code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
     },
     "request_id": {
      "type": "string"
     },
     "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
     },
     "errors": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "message"
       ],
       "properties": {
        "path": {
         "type": "string"
        },
        "message": {
         "type": "string"
        }
       }
      }
     },
     "error": {
      "type": "string",
      "description": "Deprecated compatibility field: same text as title/detail for clients that read {error}."
     }
    }
   },
   "work.application-result.v1": {
    "title": "WorkApplicationResult",
    "description": "work.application-result@1: what work.application.manage answers: one application, or a page of them (GET /api/v1/me/applications, newest first, ?status= and ?cursor=; `next` is the next page's cursor or null). DELETE answers 204 with no body.",
    "anyOf": [
     {
      "$ref": "#/components/schemas/work.application.v1"
     },
     {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "applications",
       "next",
       "count"
      ],
      "properties": {
       "applications": {
        "type": "array",
        "maxItems": 100,
        "items": {
         "$ref": "#/components/schemas/work.application.v1"
        }
       },
       "next": {
        "type": [
         "string",
         "null"
        ]
       },
       "count": {
        "type": "integer",
        "minimum": 0
       }
      }
     }
    ]
   },
   "work.application-write-request.v1": {
    "title": "WorkApplicationWriteRequest",
    "description": "work.application-write-request@1: bodies of work.application.manage. POST /api/v1/me/applications takes a listing_id (title, company and URL are copied from the listing; a second POST for the same listing answers the existing application with 200) or title + company + url by hand. PATCH /api/v1/me/applications/:id takes status, notes, applied_at, next_step and next_step_at; a status change appends an event, and status applied with no applied_at stamps it now. Unknown fields are 400.",
    "type": "object",
    "additionalProperties": false,
    "minProperties": 1,
    "properties": {
     "listing_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
     },
     "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
     },
     "company": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
     },
     "url": {
      "type": "string",
      "format": "uri",
      "maxLength": 2000
     },
     "status": {
      "enum": [
       "saved",
       "applied",
       "interviewing",
       "offer",
       "rejected",
       "withdrawn"
      ]
     },
     "notes": {
      "type": "string",
      "maxLength": 5000
     },
     "applied_at": {
      "type": [
       "string",
       "null"
      ],
      "format": "date-time"
     },
     "next_step": {
      "type": "string",
      "maxLength": 200
     },
     "next_step_at": {
      "type": [
       "string",
       "null"
      ],
      "format": "date-time"
     }
    }
   },
   "work.application.v1": {
    "title": "WorkApplication",
    "description": "work.application@1: a person's tracked job application on OpenVibe.Work (server/applications.js toWire), as GET/POST/PATCH /api/v1/me/applications[/:id] answer it. GET of one application adds its append-only status changes as `events`.",
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "subject_id",
     "listing_id",
     "title",
     "company",
     "url",
     "status",
     "notes",
     "applied_at",
     "next_step",
     "next_step_at",
     "actor_task_id",
     "assists",
     "created_at",
     "updated_at"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^wap_[0-9A-HJKMNP-TV-Z]{26}$"
     },
     "subject_id": {
      "type": "string",
      "pattern": "^user:usr_[0-9A-HJKMNP-TV-Z]{26}$"
     },
     "listing_id": {
      "type": [
       "string",
       "null"
      ],
      "maxLength": 200,
      "description": "The Work listing it was tracked from, or null when added by hand."
     },
     "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
     },
     "company": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
     },
     "url": {
      "type": "string",
      "format": "uri",
      "maxLength": 2000
     },
     "status": {
      "enum": [
       "saved",
       "applied",
       "interviewing",
       "offer",
       "rejected",
       "withdrawn"
      ]
     },
     "notes": {
      "type": "string",
      "maxLength": 5000
     },
     "applied_at": {
      "type": [
       "string",
       "null"
      ],
      "format": "date-time"
     },
     "next_step": {
      "type": "string",
      "maxLength": 200
     },
     "next_step_at": {
      "type": [
       "string",
       "null"
      ],
      "format": "date-time"
     },
     "actor_task_id": {
      "type": [
       "string",
       "null"
      ],
      "maxLength": 200,
      "description": "The latest OpenVibe.Actor task asked for this application (POST …/assist)."
     },
     "assists": {
      "type": "integer",
      "minimum": 0
     },
     "created_at": {
      "type": "string",
      "format": "date-time"
     },
     "updated_at": {
      "type": "string",
      "format": "date-time"
     },
     "events": {
      "type": "array",
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "at",
        "from_status",
        "to_status"
       ],
       "properties": {
        "at": {
         "type": "string",
         "format": "date-time"
        },
        "from_status": {
         "enum": [
          "saved",
          "applied",
          "interviewing",
          "offer",
          "rejected",
          "withdrawn"
         ]
        },
        "to_status": {
         "enum": [
          "saved",
          "applied",
          "interviewing",
          "offer",
          "rejected",
          "withdrawn"
         ]
        }
       }
      }
     }
    }
   }
  },
  "securitySchemes": {
   "openvibeToken": {
    "type": "http",
    "scheme": "bearer",
    "bearerFormat": "JWT",
    "description": "An OpenVibe Network token for this service: a person's token, an app token (client credentials, audience of the service) or a first-party service token. Its `cap` claim must include the capability the operation names."
   }
  }
 }
}
