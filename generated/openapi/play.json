{
 "openapi": "3.1.0",
 "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
 "info": {
  "title": "OpenVibe.Play API",
  "version": "0.261.0",
  "description": "Routes of OpenVibe.Play as the OpenVibe contracts describe them (openvibe-contracts 0.261.0): each operation lists the capabilities it performs; a token for the service's audience must carry one of them unless the route is open. Generated by openvibe-contracts lib/openapi.js; do not edit.",
  "license": {
   "name": "MIT",
   "identifier": "MIT"
  }
 },
 "servers": [
  {
   "url": "https://play.openvibe.network"
  }
 ],
 "paths": {
  "/api/v1/titles/{title}": {
   "put": {
    "operationId": "put_api_v1_titles_title",
    "summary": "Register or update a title the caller manages on OpenVibe.Play (PUT /api/v1/titles/:title): its name, address and summary, its achievements (id, name, description, hidden) and its leaderboards (id, na",
    "description": "**play.title.manage** (public): Register or update a title the caller manages on OpenVibe.Play (PUT /api/v1/titles/:title): its name, address and summary, its achievements (id, name, description, hidden) and its leaderboards (id, name, kind best or sum). The principal that registers a title is its only writer; another one is told it does not exist (404) or, registering it, 409 play.title_taken. A definition left out is retired, never deleted: what players earned stays. A board's kind never changes (409 play.board_kind_fixed).",
    "tags": [
     "play.title"
    ],
    "x-openvibe-capabilities": [
     "play.title.manage"
    ],
    "x-openvibe-visibility": [
     "public"
    ],
    "x-openvibe-quota-class": "play-define",
    "security": [
     {
      "openvibeToken": [
       "play.title.manage"
      ]
     }
    ],
    "requestBody": {
     "required": false,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/play.title-definition.v1"
       }
      }
     }
    },
    "parameters": [
     {
      "name": "title",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "2XX": {
      "description": "Success",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/play.title-result.v1"
        }
       }
      }
     },
     "default": {
      "description": "An error (RFC 9457 problem details)",
      "content": {
       "application/problem+json": {
        "schema": {
         "$ref": "#/components/schemas/errors.problem.v1"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/titles/{title}/players/{guest}/adopt": {
   "post": {
    "operationId": "post_api_v1_titles_title_players_guest_adopt",
    "summary": "Post what players did in a title the caller manages: scores for a round to one of its boards (POST /api/v1/titles/:title/scores, up to 100 entries, idempotent by ref), achievements unlocked by a playe",
    "description": "**play.result.write** (public): Post what players did in a title the caller manages: scores for a round to one of its boards (POST /api/v1/titles/:title/scores, up to 100 entries, idempotent by ref), achievements unlocked by a player (POST /api/v1/titles/:title/unlocks, answering the new ones), and a guest's progress moved to the person who signed in (POST /api/v1/titles/:title/players/:guest/adopt). A player is a person's subject (usr_) or a guest the title names (guest:<opaque>).",
    "tags": [
     "play.result"
    ],
    "x-openvibe-capabilities": [
     "play.result.write"
    ],
    "x-openvibe-visibility": [
     "public"
    ],
    "x-openvibe-quota-class": "play-write",
    "security": [
     {
      "openvibeToken": [
       "play.result.write"
      ]
     }
    ],
    "requestBody": {
     "required": false,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/play.result-request.v1"
       }
      }
     }
    },
    "parameters": [
     {
      "name": "title",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "guest",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "2XX": {
      "description": "Success",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/play.result-response.v1"
        }
       }
      }
     },
     "default": {
      "description": "An error (RFC 9457 problem details)",
      "content": {
       "application/problem+json": {
        "schema": {
         "$ref": "#/components/schemas/errors.problem.v1"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/titles/{title}/players/{player}/achievements": {
   "get": {
    "operationId": "get_api_v1_titles_title_players_player_achievements",
    "summary": "Read one player's unlocked achievements in a title the caller manages (GET /api/v1/titles/:title/players/:player/achievements): how a game shows a guest or a person what they have.",
    "description": "**play.player.read** (public): Read one player's unlocked achievements in a title the caller manages (GET /api/v1/titles/:title/players/:player/achievements): how a game shows a guest or a person what they have. The boards and titles themselves are public reads that need no capability.",
    "tags": [
     "play.player"
    ],
    "x-openvibe-capabilities": [
     "play.player.read"
    ],
    "x-openvibe-visibility": [
     "public"
    ],
    "x-openvibe-quota-class": "standard",
    "security": [
     {
      "openvibeToken": [
       "play.player.read"
      ]
     }
    ],
    "parameters": [
     {
      "name": "title",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "player",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "2XX": {
      "description": "Success",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/play.player-achievements.v1"
        }
       }
      }
     },
     "default": {
      "description": "An error (RFC 9457 problem details)",
      "content": {
       "application/problem+json": {
        "schema": {
         "$ref": "#/components/schemas/errors.problem.v1"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/titles/{title}/scores": {
   "post": {
    "operationId": "post_api_v1_titles_title_scores",
    "summary": "Post what players did in a title the caller manages: scores for a round to one of its boards (POST /api/v1/titles/:title/scores, up to 100 entries, idempotent by ref), achievements unlocked by a playe",
    "description": "**play.result.write** (public): Post what players did in a title the caller manages: scores for a round to one of its boards (POST /api/v1/titles/:title/scores, up to 100 entries, idempotent by ref), achievements unlocked by a player (POST /api/v1/titles/:title/unlocks, answering the new ones), and a guest's progress moved to the person who signed in (POST /api/v1/titles/:title/players/:guest/adopt). A player is a person's subject (usr_) or a guest the title names (guest:<opaque>).",
    "tags": [
     "play.result"
    ],
    "x-openvibe-capabilities": [
     "play.result.write"
    ],
    "x-openvibe-visibility": [
     "public"
    ],
    "x-openvibe-quota-class": "play-write",
    "security": [
     {
      "openvibeToken": [
       "play.result.write"
      ]
     }
    ],
    "requestBody": {
     "required": false,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/play.result-request.v1"
       }
      }
     }
    },
    "parameters": [
     {
      "name": "title",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "2XX": {
      "description": "Success",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/play.result-response.v1"
        }
       }
      }
     },
     "default": {
      "description": "An error (RFC 9457 problem details)",
      "content": {
       "application/problem+json": {
        "schema": {
         "$ref": "#/components/schemas/errors.problem.v1"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/titles/{title}/unlocks": {
   "post": {
    "operationId": "post_api_v1_titles_title_unlocks",
    "summary": "Post what players did in a title the caller manages: scores for a round to one of its boards (POST /api/v1/titles/:title/scores, up to 100 entries, idempotent by ref), achievements unlocked by a playe",
    "description": "**play.result.write** (public): Post what players did in a title the caller manages: scores for a round to one of its boards (POST /api/v1/titles/:title/scores, up to 100 entries, idempotent by ref), achievements unlocked by a player (POST /api/v1/titles/:title/unlocks, answering the new ones), and a guest's progress moved to the person who signed in (POST /api/v1/titles/:title/players/:guest/adopt). A player is a person's subject (usr_) or a guest the title names (guest:<opaque>).",
    "tags": [
     "play.result"
    ],
    "x-openvibe-capabilities": [
     "play.result.write"
    ],
    "x-openvibe-visibility": [
     "public"
    ],
    "x-openvibe-quota-class": "play-write",
    "security": [
     {
      "openvibeToken": [
       "play.result.write"
      ]
     }
    ],
    "requestBody": {
     "required": false,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/play.result-request.v1"
       }
      }
     }
    },
    "parameters": [
     {
      "name": "title",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "2XX": {
      "description": "Success",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/play.result-response.v1"
        }
       }
      }
     },
     "default": {
      "description": "An error (RFC 9457 problem details)",
      "content": {
       "application/problem+json": {
        "schema": {
         "$ref": "#/components/schemas/errors.problem.v1"
        }
       }
      }
     }
    }
   }
  }
 },
 "components": {
  "schemas": {
   "errors.problem.v1": {
    "title": "Problem",
    "description": "RFC 9457 problem details (application/problem+json) with a stable OpenVibe error code and trace identifiers. The legacy 'error' string is allowed during migration so existing clients keep working.",
    "type": "object",
    "required": [
     "type",
     "title",
     "status",
     "code"
    ],
    "additionalProperties": true,
    "properties": {
     "type": {
      "type": "string",
      "format": "uri-reference"
     },
     "title": {
      "type": "string",
      "minLength": 1
     },
     "status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599
     },
     "detail": {
      "type": "string"
     },
     "instance": {
      "type": "string",
      "format": "uri-reference"
     },
     "code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
     },
     "request_id": {
      "type": "string"
     },
     "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
     },
     "errors": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "message"
       ],
       "properties": {
        "path": {
         "type": "string"
        },
        "message": {
         "type": "string"
        }
       }
      }
     },
     "error": {
      "type": "string",
      "description": "Deprecated compatibility field: same text as title/detail for clients that read {error}."
     }
    }
   },
   "play.player-achievements.v1": {
    "title": "PlayPlayerAchievements",
    "description": "One player's unlocked achievements in a title the caller manages (play.player.read), newest first.",
    "type": "object",
    "required": [
     "title",
     "player",
     "achievements"
    ],
    "additionalProperties": false,
    "properties": {
     "title": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,39}$"
     },
     "player": {
      "type": "string",
      "pattern": "^(usr_[0-9A-HJKMNP-TV-Z]{26}|guest:[A-Za-z0-9_-]{8,128})$",
      "description": "a person (usr_) or a guest the title names (guest:<opaque>)"
     },
     "achievements": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "id",
        "name",
        "unlocked_at"
       ],
       "additionalProperties": false,
       "properties": {
        "id": {
         "type": "string",
         "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "name": {
         "type": "string"
        },
        "description": {
         "type": "string"
        },
        "unlocked_at": {
         "type": "string",
         "format": "date-time"
        }
       }
      }
     }
    }
   },
   "play.result-request.v1": {
    "title": "PlayResultRequest",
    "description": "What a title's principal posts about its players (play.result.write): a round's scores to a board (POST …/scores; idempotent by ref), achievements a player unlocked (POST …/unlocks), or the person a guest became (POST …/players/:guest/adopt).",
    "oneOf": [
     {
      "type": "object",
      "required": [
       "board",
       "ref",
       "entries"
      ],
      "additionalProperties": false,
      "properties": {
       "board": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
       },
       "ref": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "description": "the round or run; a repeat changes nothing"
       },
       "at": {
        "type": "integer",
        "minimum": 1577836800000,
        "description": "epoch milliseconds, never in the future (an import of past results); default now"
       },
       "entries": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "items": {
         "type": "object",
         "required": [
          "player",
          "name",
          "score"
         ],
         "additionalProperties": false,
         "properties": {
          "player": {
           "type": "string",
           "pattern": "^(usr_[0-9A-HJKMNP-TV-Z]{26}|guest:[A-Za-z0-9_-]{8,128})$",
           "description": "a person (usr_) or a guest the title names (guest:<opaque>)"
          },
          "name": {
           "type": "string",
           "minLength": 1,
           "maxLength": 40
          },
          "score": {
           "type": "integer",
           "minimum": 0
          }
         }
        }
       }
      }
     },
     {
      "type": "object",
      "required": [
       "player",
       "achievements"
      ],
      "additionalProperties": false,
      "properties": {
       "player": {
        "type": "string",
        "pattern": "^(usr_[0-9A-HJKMNP-TV-Z]{26}|guest:[A-Za-z0-9_-]{8,128})$",
        "description": "a person (usr_) or a guest the title names (guest:<opaque>)"
       },
       "achievements": {
        "type": "array",
        "minItems": 1,
        "maxItems": 200,
        "items": {
         "type": "string",
         "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        }
       },
       "at": {
        "type": "integer",
        "minimum": 1577836800000,
        "description": "epoch milliseconds, never in the future (an import of past results); default now"
       }
      }
     },
     {
      "type": "object",
      "required": [
       "person"
      ],
      "additionalProperties": false,
      "properties": {
       "person": {
        "type": "string",
        "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$"
       }
      }
     }
    ]
   },
   "play.result-response.v1": {
    "title": "PlayResultResponse",
    "description": "The answer to a result post: scores recorded and repeated, the achievements that were new, or the unlocks and scores a guest's adoption moved.",
    "oneOf": [
     {
      "type": "object",
      "required": [
       "recorded",
       "repeated"
      ],
      "additionalProperties": false,
      "properties": {
       "recorded": {
        "type": "integer",
        "minimum": 0
       },
       "repeated": {
        "type": "integer",
        "minimum": 0
       }
      }
     },
     {
      "type": "object",
      "required": [
       "unlocked"
      ],
      "additionalProperties": false,
      "properties": {
       "unlocked": {
        "type": "array",
        "items": {
         "type": "string",
         "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        }
       }
      }
     },
     {
      "type": "object",
      "required": [
       "unlocks",
       "scores"
      ],
      "additionalProperties": false,
      "properties": {
       "unlocks": {
        "type": "integer",
        "minimum": 0
       },
       "scores": {
        "type": "integer",
        "minimum": 0
       }
      }
     }
    ]
   },
   "play.title-definition.v1": {
    "title": "PlayTitleDefinition",
    "description": "A title as its own principal registers it (play.title.manage, PUT /api/v1/titles/:title). Achievements and boards are listed in display order; one left out is retired, never deleted. A board's kind never changes.",
    "type": "object",
    "required": [
     "name"
    ],
    "additionalProperties": false,
    "properties": {
     "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
     },
     "url": {
      "type": [
       "string",
       "null"
      ],
      "pattern": "^https://",
      "maxLength": 300,
      "description": "where the game is played"
     },
     "summary": {
      "type": "string",
      "maxLength": 300
     },
     "achievements": {
      "type": "array",
      "maxItems": 200,
      "items": {
       "type": "object",
       "required": [
        "id",
        "name"
       ],
       "additionalProperties": false,
       "properties": {
        "id": {
         "type": "string",
         "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "name": {
         "type": "string",
         "minLength": 1,
         "maxLength": 80
        },
        "description": {
         "type": "string",
         "maxLength": 300
        },
        "hidden": {
         "type": "boolean",
         "description": "a secret achievement: its name and text show only to whoever unlocked it"
        }
       }
      }
     },
     "boards": {
      "type": "array",
      "maxItems": 200,
      "items": {
       "type": "object",
       "required": [
        "id",
        "name",
        "kind"
       ],
       "additionalProperties": false,
       "properties": {
        "id": {
         "type": "string",
         "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "name": {
         "type": "string",
         "minLength": 1,
         "maxLength": 80
        },
        "kind": {
         "enum": [
          "best",
          "sum"
         ],
         "description": "best: each player's best score; sum: the total of their scores"
        }
       }
      }
     }
    }
   },
   "play.title-result.v1": {
    "title": "PlayTitleResult",
    "description": "The answer to registering or updating a title: the title as anyone reads it, and whether this call created it (201) or updated it (200).",
    "type": "object",
    "required": [
     "title",
     "created"
    ],
    "additionalProperties": false,
    "properties": {
     "title": {
      "type": "object",
      "required": [
       "id",
       "name",
       "achievements",
       "boards"
      ],
      "properties": {
       "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{1,39}$"
       },
       "name": {
        "type": "string"
       },
       "url": {
        "type": [
         "string",
         "null"
        ]
       },
       "summary": {
        "type": "string"
       },
       "players": {
        "type": "integer",
        "minimum": 0
       },
       "achievements": {
        "type": "array",
        "items": {
         "type": "object",
         "required": [
          "id",
          "name"
         ],
         "properties": {
          "id": {
           "type": "string",
           "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "name": {
           "type": "string"
          },
          "description": {
           "type": "string"
          },
          "hidden": {
           "type": "boolean"
          },
          "unlocked_by": {
           "type": "integer",
           "minimum": 0
          }
         }
        }
       },
       "boards": {
        "type": "array",
        "items": {
         "type": "object",
         "required": [
          "id",
          "name",
          "kind"
         ],
         "properties": {
          "id": {
           "type": "string",
           "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "name": {
           "type": "string"
          },
          "kind": {
           "enum": [
            "best",
            "sum"
           ]
          }
         }
        }
       },
       "created_at": {
        "type": "string",
        "format": "date-time"
       },
       "updated_at": {
        "type": "string",
        "format": "date-time"
       }
      }
     },
     "created": {
      "type": "boolean"
     }
    }
   }
  },
  "securitySchemes": {
   "openvibeToken": {
    "type": "http",
    "scheme": "bearer",
    "bearerFormat": "JWT",
    "description": "An OpenVibe Network token for this service: a person's token, an app token (client credentials, audience of the service) or a first-party service token. Its `cap` claim must include the capability the operation names."
   }
  }
 }
}
