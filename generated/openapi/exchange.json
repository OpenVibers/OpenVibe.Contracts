{
 "openapi": "3.1.0",
 "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
 "info": {
  "title": "OpenVibe.Exchange API",
  "version": "0.371.0",
  "description": "Routes of OpenVibe.Exchange as the OpenVibe contracts describe them (openvibe-contracts 0.371.0): each operation lists the capabilities it performs; a token for the service's audience must carry one of them unless the route is open. Generated by openvibe-contracts lib/openapi.js; do not edit.",
  "license": {
   "name": "MIT",
   "identifier": "MIT"
  }
 },
 "servers": [
  {
   "url": "https://openvibe.exchange"
  }
 ],
 "paths": {
  "/internal/exchange/chat/export": {
   "get": {
    "operationId": "get_internal_exchange_chat_export",
    "summary": "Chat may import one signed-in person's unsealed Exchange chat history.",
    "description": "**exchange.chat.export** (first-party): Chat may import one signed-in person's unsealed Exchange chat history. Only the Chat service receives this capability; Exchange scopes the export to the subject Chat names after authenticating that person.",
    "tags": [
     "exchange.chat"
    ],
    "x-openvibe-capabilities": [
     "exchange.chat.export"
    ],
    "x-openvibe-visibility": [
     "first-party"
    ],
    "x-openvibe-quota-class": "internal-read",
    "security": [
     {
      "openvibeToken": [
       "exchange.chat.export"
      ]
     }
    ],
    "x-openvibe-input": {
     "$ref": "#/components/schemas/exchange.chat-export-request.v1"
    },
    "parameters": [
     {
      "name": "subject",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string",
       "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$"
      }
     }
    ],
    "responses": {
     "2XX": {
      "description": "Success",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/exchange.chat-export-result.v1"
        }
       }
      }
     },
     "default": {
      "description": "An error (RFC 9457 problem details)",
      "content": {
       "application/problem+json": {
        "schema": {
         "$ref": "#/components/schemas/errors.problem.v1"
        }
       }
      }
     }
    }
   }
  }
 },
 "components": {
  "schemas": {
   "errors.problem.v1": {
    "title": "Problem",
    "description": "RFC 9457 problem details (application/problem+json) with a stable OpenVibe error code and trace identifiers. The legacy 'error' string is allowed during migration so existing clients keep working.",
    "type": "object",
    "required": [
     "type",
     "title",
     "status",
     "code"
    ],
    "additionalProperties": true,
    "properties": {
     "type": {
      "type": "string",
      "format": "uri-reference"
     },
     "title": {
      "type": "string",
      "minLength": 1
     },
     "status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599
     },
     "detail": {
      "type": "string"
     },
     "instance": {
      "type": "string",
      "format": "uri-reference"
     },
     "code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
     },
     "request_id": {
      "type": "string"
     },
     "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
     },
     "errors": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "message"
       ],
       "properties": {
        "path": {
         "type": "string"
        },
        "message": {
         "type": "string"
        }
       }
      }
     },
     "error": {
      "type": "string",
      "description": "Deprecated compatibility field: same text as title/detail for clients that read {error}."
     }
    }
   },
   "exchange.chat-export-request.v1": {
    "title": "ExchangeChatExportRequest",
    "description": "The x-ov-subject header on Chat's authenticated export request.",
    "type": "object",
    "required": [
     "subject"
    ],
    "additionalProperties": false,
    "properties": {
     "subject": {
      "type": "string",
      "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$"
     }
    }
   },
   "exchange.chat-export-result.v1": {
    "title": "ExchangeChatExportResult",
    "description": "Unsealed chats and messages of exactly the named person, for their import into Chat.",
    "type": "object",
    "required": [
     "count",
     "chats"
    ],
    "additionalProperties": false,
    "properties": {
     "count": {
      "type": "integer",
      "minimum": 0
     },
     "chats": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "id",
        "title",
        "models",
        "messages"
       ],
       "additionalProperties": false,
       "properties": {
        "id": {
         "type": "string"
        },
        "title": {
         "type": "string"
        },
        "models": {
         "type": "array",
         "maxItems": 3,
         "items": {
          "type": "string"
         }
        },
        "created_at": {
         "type": "string"
        },
        "updated_at": {
         "type": "string"
        },
        "messages": {
         "type": "array",
         "items": {
          "type": "object",
          "required": [
           "role"
          ],
          "additionalProperties": false,
          "properties": {
           "role": {
            "type": "string"
           },
           "model": {
            "type": [
             "string",
             "null"
            ]
           },
           "content": {
            "type": [
             "string",
             "null"
            ]
           },
           "created_at": {
            "type": "string"
           },
           "meta": {
            "type": "object"
           }
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "securitySchemes": {
   "openvibeToken": {
    "type": "http",
    "scheme": "bearer",
    "bearerFormat": "JWT",
    "description": "An OpenVibe Network token for this service: a person's token, an app token (client credentials, audience of the service) or a first-party service token. Its `cap` claim must include the capability the operation names."
   }
  }
 }
}
