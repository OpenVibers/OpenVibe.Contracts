 "components": {
  "schemas": {
   "errors.problem.v1": {
    "title": "Problem",
    "description": "RFC 9457 problem details (application/problem+json) with a stable OpenVibe error code and trace identifiers. The legacy 'error' string is allowed during migration so existing clients keep working.",
    "type": "object",
    "required": [
     "type",
     "title",
     "status",
     "code"
    ],
    "additionalProperties": true,
    "properties": {
     "type": {
      "type": "string",
      "format": "uri-reference"
     },
     "title": {
      "type": "string",
      "minLength": 1
     },
     "status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599
     },
     "detail": {
      "type": "string"
     },
     "instance": {
      "type": "string",
      "format": "uri-reference"
     },
     "code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
     },
     "request_id": {
      "type": "string"
     },
     "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
     },
     "errors": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "message"
       ],
       "properties": {
        "path": {
         "type": "string"
        },
        "message": {
         "type": "string"
        }
       }
      }
     },
     "error": {
      "type": "string",
      "description": "Deprecated compatibility field: same text as title/detail for clients that read {error}."
     }
    }
   },
   "quest.app-quest-request.v1": {
    "title": "QuestAppQuestRequest",
    "description": "quest.app-quest-request@1: PUT /api/v1/app-quests/:slug on OpenVibe.Quest with an app token (capability quest.app_quest.manage). A developer app defines a quest on its own project's events: each step counts events of type app.<project_key>.<name> whose envelope actor is a person (the app publishing on_behalf_of them). The badge is the only reward: app quests never pay OpenCoins. Only production apps' events are counted (Events never hands sandbox events to first-party consumers).",
    "type": "object",
    "additionalProperties": false,
    "required": [
     "title",
     "steps",
     "badge"
    ],
    "properties": {
     "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
     },
     "why": {
      "type": "string",
      "maxLength": 300
     },
     "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "event_type",
        "count",
        "label"
       ],
       "properties": {
        "event_type": {
         "type": "string",
         "pattern": "^app\\.p[0-9a-z]{26}\\.[a-z0-9_]+(\\.[a-z0-9_]+){0,3}$",
         "description": "One of the app's own event types (app.<project_key>.<name>), as it publishes them at OpenVibe.Events."
        },
        "count": {
         "type": "integer",
         "minimum": 1,
         "maximum": 1000
        },
        "label": {
         "type": "string",
         "minLength": 1,
         "maxLength": 120
        }
       }
      }
     },
     "badge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "name"
      ],
      "properties": {
       "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
       }
      }
     },
     "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "maxLength": 500,
      "description": "Where a person does the steps: the app's own page."
     },
     "status": {
      "enum": [
       "active",
       "retired"
      ],
      "description": "retired: kept with its completions and badges, no longer counted or listed. Default active."
     }
    }
   },
   "quest.app-quest.v1": {
    "title": "QuestAppQuest",
    "description": "quest.app-quest@1: one app quest as OpenVibe.Quest keeps it (the answer to PUT and GET /api/v1/app-quests[/:slug]). id is app.<project_key>.<slug>; badge.id is the same id; completions counts the people who finished it.",
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "slug",
     "project_id",
     "app",
     "env",
     "title",
     "steps",
     "badge",
     "status",
     "created_at",
     "updated_at",
     "completions"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^app\\.p[0-9a-z]{26}\\.[a-z0-9][a-z0-9-]{0,47}$"
     },
     "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
     },
     "project_id": {
      "type": "string",
      "pattern": "^prj_[0-9A-HJKMNP-TV-Z]{26}$"
     },
     "app": {
      "type": "string",
      "pattern": "^app:app_[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "The app that last defined it."
     },
     "env": {
      "enum": [
       "sandbox",
       "production"
      ]
     },
     "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
     },
     "why": {
      "type": [
       "string",
       "null"
      ],
      "maxLength": 300
     },
     "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "event_type",
        "count",
        "label"
       ],
       "properties": {
        "event_type": {
         "type": "string",
         "pattern": "^app\\.p[0-9a-z]{26}\\.[a-z0-9_]+(\\.[a-z0-9_]+){0,3}$",
         "description": "One of the app's own event types (app.<project_key>.<name>), as it publishes them at OpenVibe.Events."
        },
        "count": {
         "type": "integer",
         "minimum": 1,
         "maximum": 1000
        },
        "label": {
         "type": "string",
         "minLength": 1,
         "maxLength": 120
        }
       }
      }
     },
     "badge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "id",
       "name"
      ],
      "properties": {
       "id": {
        "type": "string"
       },
       "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
       }
      }
     },
     "url": {
      "type": [
       "string",
       "null"
      ],
      "maxLength": 500
     },
     "status": {
      "enum": [
       "active",
       "retired"
      ]
     },
     "created_at": {
      "type": "string",
      "format": "date-time"
     },
     "updated_at": {
      "type": "string",
      "format": "date-time"
     },
     "completions": {
      "type": "integer",
      "minimum": 0
     }
    }
   },
   "quest.daily-progress.v1": {
    "title": "QuestDailyProgress",
    "description": "quest.daily-progress@1: the caller's own progress, counted from Events in their IANA time zone.",
    "type": "object",
    "additionalProperties": false,
    "required": [
     "date",
     "title",
     "story",
     "steps",
     "source",
     "finished_today",
