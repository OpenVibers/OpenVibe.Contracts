 "paths": {
  "/api/v1/app-quests": {
   "get": {
    "operationId": "get_api_v1_app_quests",
    "summary": "Define your app's own quests on OpenVibe.Quest (the SDK's moddable quests): PUT /api/v1/app-quests/:slug with quest.app-quest-request@1 creates or replaces one (at most 20 per project), GET /api/v1/ap",
    "description": "**quest.app_quest.manage** (public): Define your app's own quests on OpenVibe.Quest (the SDK's moddable quests): PUT /api/v1/app-quests/:slug with quest.app-quest-request@1 creates or replaces one (at most 20 per project), GET /api/v1/app-quests lists your project's, DELETE /api/v1/app-quests/:slug retires one (its completions and badges stay). Steps count the project's own events app.<project_key>.<name> at OpenVibe.Events whose actor is a person; only production events count. The reward is a badge named for your app; app quests never pay OpenCoins.",
    "tags": [
     "quest.app_quest"
    ],
    "x-openvibe-capabilities": [
     "quest.app_quest.manage"
    ],
    "x-openvibe-visibility": [
     "public"
    ],
    "x-openvibe-quota-class": "quest-app-write",
    "security": [
     {
      "openvibeToken": [
       "quest.app_quest.manage"
      ]
     }
    ],
    "x-openvibe-input": {
     "$ref": "#/components/schemas/quest.app-quest-request.v1"
    },
    "parameters": [
     {
      "name": "title",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string",
       "minLength": 1,
       "maxLength": 80
      }
     },
     {
      "name": "why",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "maxLength": 300
      }
     },
     {
      "name": "steps",
      "in": "query",
      "required": true,
      "schema": {
       "type": "array",
       "minItems": 1,
       "maxItems": 5,
       "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "event_type",
         "count",
         "label"
        ],
        "properties": {
         "event_type": {
          "type": "string",
          "pattern": "^app\\.p[0-9a-z]{26}\\.[a-z0-9_]+(\\.[a-z0-9_]+){0,3}$",
          "description": "One of the app's own event types (app.<project_key>.<name>), as it publishes them at OpenVibe.Events."
         },
         "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
         },
         "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
         }
        }
       }
      }
     },
     {
      "name": "badge",
      "in": "query",
      "required": true,
      "schema": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "name"
       ],
       "properties": {
        "name": {
         "type": "string",
         "minLength": 1,
         "maxLength": 40
        }
       }
      }
     },
     {
      "name": "url",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "format": "uri",
       "pattern": "^https://",
       "maxLength": 500,
       "description": "Where a person does the steps: the app's own page."
      },
      "description": "Where a person does the steps: the app's own page."
     },
     {
      "name": "status",
      "in": "query",
      "required": false,
      "schema": {
       "enum": [
        "active",
        "retired"
       ],
       "description": "retired: kept with its completions and badges, no longer counted or listed. Default active."
      },
      "description": "retired: kept with its completions and badges, no longer counted or listed. Default active."
     }
    ],
    "responses": {
     "2XX": {
      "description": "Success",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/quest.app-quest.v1"
        }
       }
      }
     },
     "default": {
      "description": "An error (RFC 9457 problem details)",
      "content": {
       "application/problem+json": {
        "schema": {
         "$ref": "#/components/schemas/errors.problem.v1"
        }
       }
      }
     }
    }
   }
