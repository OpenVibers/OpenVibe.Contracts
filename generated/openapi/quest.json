      "minLength": 1,
      "maxLength": 80
     },
     "story": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
     },
     "steps": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "id",
        "event_type",
        "site",
        "sentence",
        "href",
        "weight",
        "count",
        "verification",
        "status",
        "source",
        "progress",
        "done"
       ],
       "properties": {
        "id": {
         "type": "string"
        },
        "event_type": {
         "type": "string"
        },
        "site": {
         "type": "string"
        },
        "sentence": {
         "type": "string"
        },
        "href": {
         "type": "string",
         "format": "uri"
        },
        "weight": {
         "type": "integer"
        },
        "count": {
         "type": "integer",
         "const": 1
        },
        "verification": {
         "type": "string"
        },
        "status": {
         "const": "approved"
        },
        "source": {
         "type": "string"
        },
        "progress": {
         "type": "integer",
         "minimum": 0
        },
        "done": {
         "type": "boolean"
        }
       }
      }
     },
     "source": {
      "enum": [
       "ai",
       "rotation"
      ]
     },
     "finished_today": {
      "type": "integer",
      "minimum": 0
     },
     "progress": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
     },
     "completed": {
      "type": "boolean"
     },
     "completed_at": {
      "type": [
       "string",
       "null"
      ],
      "format": "date-time"
     },
     "streak": {
      "type": "integer",
      "minimum": 0
     },
     "time_zone": {
      "type": "string"
     }
    }
   },
   "quest.daily.v1": {
    "title": "QuestDaily",
    "description": "quest.daily@1: one quest shared by everyone on this UTC date. Progress is private and is not in this answer.",
    "type": "object",
    "additionalProperties": false,
    "required": [
     "date",
     "title",
     "story",
     "steps",
     "source",
     "finished_today"
    ],
    "properties": {
     "date": {
      "type": "string",
      "format": "date"
     },
     "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
     },
     "story": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
     },
     "steps": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
       "$ref": "#/components/schemas/quest.step-type.v1"
      }
     },
     "source": {
      "enum": [
       "ai",
       "rotation"
      ]
     },
     "finished_today": {
      "type": "integer",
      "minimum": 0
     }
    }
   },
   "quest.step-type-request.v1": {
    "title": "QuestStepTypeRequest",
    "description": "A developer app's proposed daily step. Quest accepts only topics in its known Events catalog, verifies the site's host and queues the proposal for staff review.",
    "type": "object",
    "additionalProperties": false,
    "required": [
