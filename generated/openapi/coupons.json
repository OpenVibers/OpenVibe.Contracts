 "components": {
  "schemas": {
   "coupons.coupon.v1": {
    "title": "CouponsCoupon",
    "description": "coupons.coupon@1: one code as OpenVibe.Coupons shows it (server/domain/coupons.js view): its status and confidence come only from people's reports (counts in a window, report times rounded to the hour), a known or unknown expiry, restrictions, hints and evidence. No submitter or reporter is ever named.",
    "type": "object",
    "required": [
     "id",
     "merchant_id",
     "code",
     "title",
     "status",
     "active",
     "reports",
     "expiry",
     "restrictions",
     "origin",
     "url"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "merchant_id": {
      "type": "string"
     },
     "code": {
      "type": "string",
      "pattern": "^[\\x21-\\x7E]{1,64}$"
     },
     "title": {
      "type": "string"
     },
     "description": {
      "type": [
       "string",
       "null"
      ]
     },
     "status": {
      "enum": [
       "unknown",
       "reported_working",
       "reported_failed",
       "expired",
       "disabled"
      ]
     },
     "active": {
      "type": "boolean"
     },
     "confidence": {},
     "reports": {
      "type": "object",
      "properties": {
       "window_days": {
        "type": "integer"
       },
       "last_report_at": {
        "type": [
         "string",
         "null"
        ],
        "format": "date-time"
       },
       "last_worked_at": {
        "type": [
         "string",
         "null"
        ],
        "format": "date-time"
       },
       "last_failed_at": {
        "type": [
         "string",
         "null"
        ],
        "format": "date-time"
       }
      }
     },
     "expiry": {
      "type": "object",
      "required": [
       "known",
       "expires_at"
      ],
      "properties": {
       "known": {
        "type": "boolean"
       },
       "expires_at": {
        "type": [
         "string",
         "null"
        ],
        "format": "date-time"
       },
       "precision": {
        "type": [
         "string",
         "null"
        ]
       },
       "basis": {
        "type": [
         "string",
         "null"
        ]
       }
      }
     },
     "restrictions": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "kind"
       ],
       "properties": {
        "kind": {
         "enum": [
          "min_spend",
          "category",
          "new_customers_only",
          "region",
          "other"
         ]
        },
        "value": {},
        "amount": {
         "type": "string"
        },
        "amount_minor": {
         "type": "integer"
        },
        "currency": {
         "type": "string"
        }
       }
      }
     },
     "hints": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "text": {
         "type": "string"
        },
        "scope": {
         "enum": [
          "code",
          "merchant"
         ]
        }
       }
      }
     },
     "evidence": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "kind": {
         "type": "string"
        },
        "url": {
         "type": [
          "string",
          "null"
         ]
        },
        "merchant_page": {
         "type": "boolean"
        },
        "sources_item": {
         "type": "string"
        },
        "retrieved_at": {
         "type": [
          "string",
          "null"
         ],
         "format": "date-time"
        }
       }
      }
     },
     "origin": {
      "type": "string"
     },
     "created_at": {
      "type": [
       "string",
       "null"
      ],
      "format": "date-time"
     },
     "updated_at": {
      "type": [
       "string",
       "null"
      ],
      "format": "date-time"
     },
     "expired_at": {
      "type": [
       "string",
       "null"
      ],
      "format": "date-time"
     },
     "url": {
      "type": "string"
     }
    }
   },
   "coupons.lookup-result.v1": {
    "title": "CouponsLookupResult",
    "description": "coupons.lookup-result@1: answers of coupons.coupon.lookup on OpenVibe.Coupons (public, anonymous allowed, cacheable: the same bytes for every caller). GET /api/v1/merchants/:id/coupons → { merchant, coupons } (the active codes); GET /api/v1/merchants/:id → { merchant }; GET /api/v1/coupons/:id → { coupon, merchant }. Inactive merchants and unpublished or disabled codes are 404.",
    "type": "object",
    "required": [
     "merchant"
    ],
    "properties": {
     "merchant": {
      "$ref": "#/components/schemas/coupons.merchant.v1"
     },
     "coupons": {
      "type": "array",
      "maxItems": 200,
      "items": {
       "$ref": "#/components/schemas/coupons.coupon.v1"
      }
     },
     "coupon": {
      "$ref": "#/components/schemas/coupons.coupon.v1"
     }
    }
   },
   "coupons.merchant-manage-request.v1": {
    "title": "CouponsMerchantManageRequest",
    "description": "coupons.merchant-manage-request@1: bodies of coupons.merchant.manage on OpenVibe.Coupons (staff or a service). POST /api/v1/merchants: { domains, name?, slug?, homepage_url?, description?, status? } (at least one domain rule; a rule on a public suffix is refused; homepage_url must be https; status pending, else active). POST /api/v1/merchants/:id/domains: one domain rule { host, include_subdomains?, path_prefix? } (a rule another merchant holds is 409). POST /api/v1/merchants/:id/status: { status: active | disabled }.",
    "anyOf": [
     {
      "type": "object",
      "required": [
       "domains"
      ],
      "properties": {
       "domains": {
        "type": "array",
        "minItems": 1,
        "items": {
         "type": "object",
         "required": [
          "host"
         ],
         "properties": {
          "host": {
           "type": "string",
           "minLength": 1
          },
          "include_subdomains": {
           "type": [
            "boolean",
            "integer",
            "string"
           ],
           "description": "Default true."
          },
          "path_prefix": {
           "type": "string"
          }
         }
        }
       },
       "name": {
        "type": [
         "string",
         "null"
        ]
       },
       "slug": {
        "type": [
         "string",
         "null"
        ]
       },
       "homepage_url": {
        "type": [
         "string",
         "null"
        ],
        "pattern": "^https://"
       },
       "description": {
        "type": [
         "string",
         "null"
        ]
       },
       "status": {
        "type": "string",
        "description": "pending; anything else is active."
       }
      }
     },
     {
      "type": "object",
      "required": [
       "host"
      ],
      "properties": {
       "host": {
        "type": "string",
        "minLength": 1
       },
       "include_subdomains": {
        "type": [
         "boolean",
         "integer",
         "string"
        ],
        "description": "Default true."
       },
       "path_prefix": {
        "type": "string"
       }
      }
     },
     {
      "type": "object",
      "required": [
       "status"
      ],
      "properties": {
       "status": {
        "enum": [
         "active",
         "disabled"
        ]
       }
      }
     }
    ]
   },
   "coupons.merchant-manage-result.v1": {
    "title": "CouponsMerchantManageResult",
    "description": "coupons.merchant-manage-result@1: the answer of every coupons.merchant.manage route on OpenVibe.Coupons: { merchant } with its status (201 for a new merchant or domain).",
    "type": "object",
    "required": [
     "merchant"
    ],
    "properties": {
     "merchant": {
      "allOf": [
       {
        "$ref": "#/components/schemas/coupons.merchant.v1"
       },
       {
        "type": "object",
        "required": [
         "status"
        ]
       }
      ]
     }
    }
   },
   "coupons.merchant.v1": {
    "title": "CouponsMerchant",
    "description": "coupons.merchant@1: one merchant as OpenVibe.Coupons' lookup API shows it (server/http/api.js merchantView): the same bytes for every caller, nothing about any person. Staff and service answers of the merchant routes add its status.",
    "type": "object",
    "required": [
     "id",
     "slug",
     "name",
     "url",
     "domains",
     "active_codes",
     "hints"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "slug": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "homepage_url": {
      "type": [
       "string",
       "null"
      ]
     },
     "url": {
      "type": "string"
     },
     "domains": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "host",
        "include_subdomains",
        "path_prefix"
       ],
       "properties": {
        "host": {
         "type": "string"
        },
        "include_subdomains": {
         "type": "boolean"
        },
        "path_prefix": {
         "type": [
          "string",
          "null"
         ]
        }
       }
      }
     },
     "active_codes": {
