      "type": [
       "string",
       "null"
      ]
     }
    }
   },
   "coupons.status-result.v1": {
    "title": "CouponsStatusResult",
    "description": "coupons.status-result@1: the answer of POST /api/v1/coupons/:id/status on OpenVibe.Coupons: { coupon } after the change.",
    "type": "object",
    "required": [
     "coupon"
    ],
    "properties": {
     "coupon": {
      "$ref": "#/components/schemas/coupons.coupon.v1"
     }
    }
   },
   "coupons.submit-request.v1": {
    "title": "CouponsSubmitRequest",
    "description": "coupons.submit-request@1: the body of POST /api/v1/coupons/submit on OpenVibe.Coupons (coupons.coupon.submit; a signed-in person, or a service acting for one or as AI; installs cannot submit): a code and the merchant it is for (merchant_id, or the host or url of the shop: an unknown shop becomes a pending merchant). code is 1-64 printable characters without spaces; title (at least 3 characters: what the code gives) is required. status, confidence, verified, working, valid and validity are refused (422 coupon.status_not_accepted): a code's status comes only from people's reports. expires is a date (YYYY-MM-DD) or ISO time; expiry_basis evidence needs evidence_url. A duplicate answers the existing code (200).",
    "type": "object",
    "required": [
     "code",
     "title"
    ],
    "anyOf": [
     {
      "required": [
       "merchant_id"
      ]
     },
     {
      "required": [
       "host"
      ]
     },
     {
      "required": [
       "url"
      ]
     }
    ],
    "not": {
     "anyOf": [
      {
       "required": [
        "status"
       ]
      },
      {
       "required": [
        "confidence"
       ]
      },
      {
       "required": [
        "verified"
       ]
      },
      {
       "required": [
        "working"
       ]
      },
      {
       "required": [
        "valid"
       ]
      },
      {
       "required": [
        "validity"
       ]
      }
     ]
    },
    "properties": {
     "code": {
      "type": "string",
      "pattern": "^\\s*[\\x21-\\x7E]{1,64}\\s*$"
     },
     "title": {
      "type": "string",
      "minLength": 3
     },
     "description": {
      "type": [
       "string",
       "null"
      ]
     },
     "merchant_id": {
      "type": "string"
     },
     "host": {
      "type": "string"
     },
     "url": {
      "type": "string",
      "pattern": "^https?://"
     },
     "expires": {
      "type": [
       "string",
       "null"
      ]
     },
     "expiry_basis": {
      "enum": [
       "submitter",
       "evidence"
      ]
     },
     "evidence_url": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https?://"
     },
     "restrictions": {
      "type": "object",
      "properties": {
       "min_spend": {
        "type": "object",
        "properties": {
         "amount": {
          "type": [
           "number",
           "string"
          ]
         },
         "currency": {
          "type": "string",
          "description": "ISO 4217."
         }
        }
       },
       "categories": {
        "type": [
         "array",
         "string"
        ],
        "description": "At most 10."
       },
       "new_customers_only": {
        "type": [
         "boolean",
         "string"
        ]
       },
       "regions": {
        "type": [
         "array",
         "string"
        ],
        "description": "ISO 3166-1 alpha-2 codes, at most 50."
       },
       "other": {
        "type": "string",
        "maxLength": 300
       }
      }
     },
     "hint": {
      "type": [
       "string",
       "null"
      ],
      "maxLength": 300
     },
     "ai_run_id": {
      "type": [
       "string",
       "null"
      ]
     }
    }
   },
   "coupons.submit-result.v1": {
    "title": "CouponsSubmitResult",
    "description": "coupons.submit-result@1: the answer of POST /api/v1/coupons/submit on OpenVibe.Coupons: { coupon, merchant, duplicate, review_state } — 201 for a new code, 200 when the same code was already known (duplicate).",
    "type": "object",
    "required": [
     "coupon",
     "merchant",
     "duplicate",
     "review_state"
    ],
    "properties": {
     "coupon": {
      "$ref": "#/components/schemas/coupons.coupon.v1"
     },
     "merchant": {
      "type": "object",
      "required": [
       "id",
       "slug",
       "name",
       "status"
      ],
      "properties": {
       "id": {
        "type": "string"
       },
       "slug": {
        "type": "string"
       },
       "name": {
        "type": "string"
       },
       "status": {
        "enum": [
         "pending",
         "active",
         "disabled"
        ]
       }
      }
     },
     "duplicate": {
      "type": "boolean"
     },
     "review_state": {
      "type": "string"
     }
    }
   },
   "errors.problem.v1": {
    "title": "Problem",
    "description": "RFC 9457 problem details (application/problem+json) with a stable OpenVibe error code and trace identifiers. The legacy 'error' string is allowed during migration so existing clients keep working.",
    "type": "object",
    "required": [
     "type",
     "title",
     "status",
     "code"
    ],
    "additionalProperties": true,
    "properties": {
     "type": {
      "type": "string",
      "format": "uri-reference"
     },
     "title": {
      "type": "string",
      "minLength": 1
     },
     "status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599
     },
     "detail": {
      "type": "string"
     },
     "instance": {
      "type": "string",
      "format": "uri-reference"
     },
     "code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
     },
     "request_id": {
      "type": "string"
     },
     "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
     },
     "errors": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "message"
       ],
       "properties": {
        "path": {
         "type": "string"
        },
        "message": {
         "type": "string"
        }
       }
      }
     },
     "error": {
      "type": "string",
      "description": "Deprecated compatibility field: same text as title/detail for clients that read {error}."
     }
    }
   }
  },
  "securitySchemes": {
   "openvibeToken": {
    "type": "http",
    "scheme": "bearer",
    "bearerFormat": "JWT",
    "description": "An OpenVibe Network token for this service: a person's token, an app token (client credentials, audience of the service) or a first-party service token. Its `cap` claim must include the capability the operation names."
   }
  }
 }
}
