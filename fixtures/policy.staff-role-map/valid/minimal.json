  "claims": { "role": "role", "owner": "is_owner", "capabilities": "staff_caps" },
  "local": [{ "id": "live.channel.moderator", "description": "A channel moderator inside that channel." }],
  "rules": ["Nobody acts against an equal or higher effective role."]
}
