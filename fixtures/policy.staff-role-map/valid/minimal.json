{
  "version": "1.0.0",
  "roles": [
    { "id": "user", "staff": false, "description": "Everyone signed in." },
    { "id": "global_mod", "staff": true, "description": "Site-wide moderator." }
  ],
  "capabilities": [
    { "id": "staff.moderation.chat", "minRole": "global_mod", "description": "Moderate chat in any channel.", "gates": { "chat": ["chat/chat-server.js:511"] } }
