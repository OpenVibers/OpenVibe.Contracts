{
  "key": "aws-lightsail-bundles",
  "name": "Amazon Lightsail instance bundles (us-east-1)",
  "type": "api",
  "category": "hosting",
  "homepage_url": "https://aws.amazon.com/lightsail/pricing/",
  "endpoints": [
    {
      "url": "https://pricing.us-east-1.amazonaws.com/offers/v1.0/aws/AmazonLightsail/current/us-east-1/index.json",
      "format": "json",
      "items_shape": "map",
      "items_path": "products",
      "item_kind": "plan",
      "where": {
        "attributes": {
          "operatingSystem": "Linux"
        }
      },
      "fields": {
        "identity": "$key",
        "title": "attributes.usagetype"
      },
      "extra": {
        "vcpu": "attributes.vcpu",
        "memory": "attributes.memory",
        "storage": "attributes.storage",
        "transfer": "attributes.dataTransferQuota",
        "price_hourly": "$root.terms.OnDemand.{$key}.*.priceDimensions.*.pricePerUnit.USD"
      }
    }
  ],
  "auth": {
    "mode": "none"
  },
  "robots_note": "robots.txt allows the feed path (checked 2026-09-23)",
  "terms_note": "Each AWS price list file says it is for informational purposes; prices are subject to the terms on aws.amazon.com.",
  "license_note": null,
  "min_interval_ms": 60000,
  "poll_interval_sec": 3600,
  "stale_after_sec": 172800,
  "max_items": 200,
  "enabled": false,
  "review_required": true,
  "sensitivity": "none",
  "default_indexability": "noindex"
}
