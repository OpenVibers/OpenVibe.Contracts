      "required": false,
      "pressed": true,
      "min": {
        "w": 2,
        "h": 2
      },
      "styles": {
        "tints": [
          "surface",
          "accent"
        ],
        "shapes": [
          "round",
          "pill",
          "square"
        ],
        "opacity": {
          "min": 0.4,
          "max": 1
