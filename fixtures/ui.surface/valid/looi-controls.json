{
  "id": "bot.controls",
  "version": 1,
  "name": "Robot controls",
  "description": "LOOI's panel from its manifest (LOOI 1.0.0): each part says what it sends or shows, for the AI that arranges it.",
  "devices": [
    "phone",
    "tablet",
    "computer"
  ],
  "grid": {
    "columns": {
      "phone": 4,
      "tablet": 8,
      "computer": 12
    },
    "cell_px": {
      "phone": 44,
      "tablet": 44,
      "computer": 44
