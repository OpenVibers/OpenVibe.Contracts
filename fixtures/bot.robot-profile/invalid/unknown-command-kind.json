{
  "id": "adeept.adr036",
  "version": 1,
  "name": "Adeept ADR036 4WD Smart Car",
  "vendor": "Adeept",
  "kind": "onboard",
  "capabilities": [
    "drive.differential",
    "servo.pan_tilt",
    "lights.rgb",
    "speaker.horn",
    "sensor.ultrasonic",
    "battery"
  ],
  "mapping": {
    "driver": "pca9685",
    "plugin": "adeept_adr036",
    "wheels": "ordinary",
    "i2c_bus": 1,
    "address": "0x5f",
    "motor_channels": [
      8,
      9,
      10,
      11,
      12,
      13,
      14,
      15
    ],
    "servo_channels": {
      "pan": 0,
      "tilt": 1
    },
    "battery": {
      "driver": "ads7830",
      "address": "0x48"
    },
    "lights": "ws2812",
    "horn": "buzzer"
  },
  "commands": {
    "fly": {}
  },
  "widgets": [
    {
      "type": "drive",
      "capability": "drive.differential",
      "label": "Drive",
      "order": 1,
      "command": {
        "kind": "drive"
      }
    },
    {
      "type": "pan-tilt",
      "capability": "servo.pan_tilt",
      "label": "Pan / tilt",
      "order": 2,
      "command": {
        "kind": "actuator",
        "names": [
          "pan",
          "tilt"
        ]
      }
    },
    {
      "type": "battery",
      "capability": "battery",
      "label": "Battery",
      "order": 3
    },
    {
      "type": "latency",
      "label": "Latency",
      "order": 4
    }
  ],
  "camera": {
    "transport": "whip",
    "resolution": "640x480"
  },
  "limits": {
    "max_speed": 1,
    "max_turn": 1,
    "max_command_ms": 300,
    "heartbeat_ms": 1000
  }
}
